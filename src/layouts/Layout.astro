<!-- 关于我页面的服务器状态由持久布局统一管理，确保 Swup 无刷新切页后仍会初始化。 -->
<script is:inline data-swup-ignore-script>
  (() => {
    const runtimeKey = "__rainztAboutServerRuntime";
    const runtime = window[runtimeKey] || {
      activeRoot: null,
      cleanup: null,
      eventsBound: false,
      hooksBound: false,
      scheduledFrame: 0,
    };

    const clearActiveRuntime = () => {
      if (typeof runtime.cleanup === "function") runtime.cleanup();
      runtime.cleanup = null;
      runtime.activeRoot = null;
    };

    const clampPercent = (value) => Math.min(100, Math.max(0, Number(value) || 0));
    const formatBytes = (bytes) => {
      const value = Number(bytes);
      if (!Number.isFinite(value) || value <= 0) return "--";
      const units = ["B", "KiB", "MiB", "GiB", "TiB"];
      let size = value;
      let unit = 0;
      while (size >= 1024 && unit < units.length - 1) {
        size /= 1024;
        unit += 1;
      }
      return `${size.toFixed(unit === 0 ? 0 : 1)} ${units[unit]}`;
    };

    const setupServerMetrics = () => {
      const root = document.querySelector("[data-server-metrics]");
      if (!root) {
        clearActiveRuntime();
        return;
      }
      if (runtime.activeRoot === root) return;

      clearActiveRuntime();
      runtime.activeRoot = root;

      const endpoint = root.dataset.serverEndpoint || "";
      if (!endpoint) {
        const statusText = root.querySelector("[data-server-status-text]");
        const note = root.querySelector("[data-server-note]");
        if (statusText) statusText.textContent = "未配置";
        if (note) note.textContent = "请在 serviceConfig.ts 中配置自己的状态接口。";
        return;
      }
      const status = root.querySelector("[data-server-status]");
      const statusText = root.querySelector("[data-server-status-text]");
      const note = root.querySelector("[data-server-note]");
      let timer;
      let refreshInFlight = false;
      let hasReceivedMetrics = false;
      let requestController;
      const cleanups = [];
      runtime.cleanup = () => {
        for (const cleanup of cleanups.splice(0)) cleanup();
        runtime.activeRoot = null;
      };

      const setStatus = (state, text) => {
        if (status) status.dataset.state = state;
        if (statusText) statusText.textContent = text;
      };

      const setMetric = (key, value, detail, percent) => {
        const item = root.querySelector(`[data-server-stat="${key}"]`);
        if (!item) return;
        const valueElement = item.querySelector("[data-server-value]");
        const detailElement = item.querySelector("[data-server-detail]");
        const meter = item.querySelector("[data-server-meter]");
        if (valueElement) valueElement.textContent = value;
        if (detailElement) detailElement.textContent = detail;
        if (meter && percent !== null) meter.style.setProperty("--meter-scale", String(clampPercent(percent) / 100));
      };

      const applyMetrics = (data) => {
        const cpu = data.cpu || {};
        const memory = data.memory || {};
        const disk = data.disk || {};
        const system = data.system || {};
        const cpuUsage = Number(cpu.usage);
        const memoryUsage = Number(memory.usage);
        const diskUsage = Number(disk.usage);
        const load = Number(cpu.load1);
        const cores = Number(cpu.cores);

        setMetric(
          "cpu",
          Number.isFinite(cpuUsage) ? `${cpuUsage.toFixed(1)}%` : "--",
          `${Number.isFinite(cores) ? `${cores} vCPU` : "CPU"} · ${cpu.model || ""} · 负载 ${Number.isFinite(load) ? load.toFixed(2) : "--"}`,
          cpuUsage,
        );
        setMetric(
          "memory",
          Number.isFinite(memoryUsage) ? `${memoryUsage.toFixed(1)}%` : "--",
          `${formatBytes(memory.usedBytes)} / ${formatBytes(memory.totalBytes)} · 可用 ${formatBytes(memory.availableBytes)}`,
          memoryUsage,
        );
        setMetric(
          "disk",
          Number.isFinite(diskUsage) ? `${diskUsage.toFixed(1)}%` : "--",
          `${formatBytes(disk.usedBytes)} / ${formatBytes(disk.totalBytes)} · 可用 ${formatBytes(disk.availableBytes)}`,
          diskUsage,
        );
        setMetric(
          "system",
          system.name || "Linux",
          `${system.kernel || ""}${system.arch ? ` · ${system.arch}` : ""}`,
          null,
        );

        if (note) {
          const stamp = data.timestamp ? new Date(data.timestamp).toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit", second: "2-digit" }) : "刚刚";
          note.textContent = `实时刷新 · 最近更新 ${stamp} · 每 1 秒检查一次`;
        }
      };

      const refresh = async () => {
        if (refreshInFlight) return;
        refreshInFlight = true;
        if (!hasReceivedMetrics) setStatus("loading", "连接中");
        requestController?.abort();
        requestController = new AbortController();
        try {
          const separator = endpoint.includes("?") ? "&" : "?";
          const response = await fetch(`${endpoint}${separator}t=${Date.now()}`, {
            cache: "no-store",
            headers: { Accept: "application/json" },
            signal: requestController.signal,
          });
          if (!response.ok) throw new Error(`server status ${response.status}`);
          const data = await response.json();
          if (!data?.ok) throw new Error("invalid server status response");
          applyMetrics(data);
          hasReceivedMetrics = true;
          setStatus("online", "在线");
        } catch (error) {
          if (error?.name === "AbortError") return;
          setStatus("offline", "暂不可用");
          if (note) note.textContent = "实时接口未连接 · 当前保留规格信息";
        } finally {
          refreshInFlight = false;
        }
      };

      refresh();
      timer = window.setInterval(refresh, 1_000);
      cleanups.push(() => {
        window.clearInterval(timer);
        requestController?.abort();
      });
    };

    const scheduleServerMetricsInit = () => {
      if (runtime.scheduledFrame) cancelAnimationFrame(runtime.scheduledFrame);
      runtime.scheduledFrame = requestAnimationFrame(() => {
        runtime.scheduledFrame = 0;
        setupServerMetrics();
      });
    };

    const bindSwupHooks = () => {
      if (runtime.hooksBound || !window.swup?.hooks) return;
      window.swup.hooks.on("visit:start", clearActiveRuntime);
      window.swup.hooks.on("content:replace", scheduleServerMetricsInit);
      window.swup.hooks.on("page:view", scheduleServerMetricsInit);
      runtime.hooksBound = true;
    };

    if (!runtime.eventsBound) {
      for (const eventName of [
        "astro:page-load",
        "astro:after-swap",
        "swup:contentReplaced",
        "swup:content:replace",
        "swup:page:view",
      ]) {
        document.addEventListener(eventName, scheduleServerMetricsInit);
      }
      document.addEventListener("astro:before-swap", clearActiveRuntime);
      document.addEventListener("swup:visit:start", clearActiveRuntime);
      document.addEventListener("swup:enable", bindSwupHooks);
      runtime.eventsBound = true;
    }

    bindSwupHooks();
    window[runtimeKey] = runtime;
    scheduleServerMetricsInit();
  })();
</script>

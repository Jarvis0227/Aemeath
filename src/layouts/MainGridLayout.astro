---
import Live2DWidget from "@components/features/Live2DWidget.astro";

import SpineModel from "@components/features/SpineModel.astro";
import Footer from "@components/layout/Footer.astro";
import Navbar from "@components/layout/Navbar.astro";
import SideBar from "@components/layout/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import AiRecommendationNote from "@/components/common/AiRecommendationNote.astro";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import FloatingControls from "@/components/controls/FloatingControls.astro";
import ScrollDownIndicator from "@/components/controls/ScrollDownIndicator.astro";
import BackgroundPlayer from "@/components/features/BackgroundPlayer.astro";
import CodeInteractionManager from "@/components/features/CodeInteractionManager.astro";
import HomePortfolioIntro from "@/components/features/HomePortfolioIntro.astro";
import HomeWallpaperDecor from "@/components/features/HomeWallpaperDecor.astro";
import TypewriterText from "@/components/features/TypewriterText.astro";
import CategoryBar from "@/components/layout/CategoryBar.astro";
import PureShell from "@/components/themes/pure/PureShell.astro";
import {
	backgroundWallpaper,
	live2dWidgetConfig,
	sidebarLayoutConfig,
	siteConfig,
} from "@/config";
import {
	alternateHomepageWallpaper,
	homepageWallpaper,
	mobileHomepageWallpaper,
} from "@/config/backgroundWallpaper";
import { nationalDayTheme } from "@/config/nationalDayTheme";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "@/constants/constants";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getImageQuality } from "@/utils/image-utils";
import { getBackgroundImages, isHomePage } from "@/utils/layout-utils";
import {
	generateGridClasses,
	generateMainContentClasses,
	generateRightSidebarClasses,
	generateSidebarClasses,
	getResponsiveSidebarConfig,
	type ResponsiveSidebarConfig,
} from "@/utils/responsive-utils";
import Layout from "./Layout.astro";

import "@/styles/markdown.css";
import "@/styles/expressive-code.css";
import "@/styles/home-card-decor.css";
import "@/styles/home-wallpaper-decor.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postAiPolished?: boolean;
	postImageColor?: string;
	postCategory?: string;
	headings?: MarkdownHeading[];
	bannerPostMeta?: {
		title: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
	bannerPostAiSummary?: string;
	bannerPageAiRecommendation?: {
		text: string;
		segments?: Array<{
			text: string;
			tone?: "default" | "accent";
			href?: string;
		}>;
	};
}

const backgroundImages = getBackgroundImages();
const isNationalDayWallpaper = (src: string) =>
	src === homepageWallpaper ||
	src === alternateHomepageWallpaper ||
	src === mobileHomepageWallpaper;
const fallbackNormalDesktop =
	backgroundImages.desktop.find((src) => !isNationalDayWallpaper(src)) ?? "";
const fallbackNormalMobile =
	backgroundImages.mobile.find((src) => !isNationalDayWallpaper(src)) ?? "";
const fallbackNationalDesktop =
	backgroundImages.desktop.find(isNationalDayWallpaper) ?? "";
const fallbackNationalMobile =
	backgroundImages.mobile.find(isNationalDayWallpaper) ?? "";
const homepageWallpaperActiveByDefault =
	nationalDayTheme.defaultEnabled && Boolean(fallbackNationalDesktop);
const getWallpaperPosition = (src: string) => {
	if (backgroundWallpaper.mode !== "fullscreen") {
		return backgroundWallpaper.banner?.position ?? "center";
	}
	return isNationalDayWallpaper(src)
		? "center top"
		: (backgroundWallpaper.fullscreen?.position ?? "center");
};
const wallpaperFallbackVars = [
	["normal-desktop", fallbackNormalDesktop],
	["normal-mobile", fallbackNormalMobile],
	["national-desktop", fallbackNationalDesktop],
	["national-mobile", fallbackNationalMobile],
]
	.map(
		([device, src]) =>
			`--wallpaper-fallback-${device}: var(--wallpaper-initial-${device}, ${src ? `url('${src}')` : "none"}); --wallpaper-fallback-${device}-position: ${src ? getWallpaperPosition(src) : "center"};`,
	)
	.join(" ");
const wallpaperOverlayVars = `--overlay-opacity: ${backgroundWallpaper.overlay?.opacity ?? 0.8}; --overlay-z-index: ${backgroundWallpaper.overlay?.zIndex ?? -1}; --overlay-blur: ${backgroundWallpaper.overlay?.blur ?? 0}px;`;

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postAiPolished = false,
	postImageColor,
	postCategory,
	headings = [],
	bannerPostMeta,
	bannerPostAiSummary,
	bannerPageAiRecommendation,
} = Astro.props;

// 检查背景壁纸模式和是否允许切换
const isBannerMode = backgroundWallpaper.mode === "banner";
const isFullscreenMode = backgroundWallpaper.mode === "fullscreen";
const isOverlayMode = backgroundWallpaper.mode === "overlay";
const isBackgroundEnabled = backgroundWallpaper.mode !== "none";
const isWallpaperSwitchable = backgroundWallpaper.switchable ?? true;

// 检查是否启用水波纹动画效果
const wavesConfig = backgroundWallpaper.common?.waves?.enable;
const wavesSwitchable = backgroundWallpaper.common?.waves?.switchable ?? false;
// 处理分设备控制的水波纹动画
const wavesEnabledOnDesktop =
	typeof wavesConfig === "object" ? wavesConfig.desktop : wavesConfig;
const wavesEnabledOnMobile =
	typeof wavesConfig === "object" ? wavesConfig.mobile : wavesConfig;
// 是否需要渲染水波纹元素（任一设备启用 或 允许用户切换）
const shouldRenderWaves =
	wavesEnabledOnDesktop || wavesEnabledOnMobile || wavesSwitchable;

// 渐变过渡配置
const gradientConfig = backgroundWallpaper.common?.gradient?.enable;
const gradientSwitchable =
	backgroundWallpaper.common?.gradient?.switchable ?? false;
const gradientEnabledOnDesktop =
	typeof gradientConfig === "object"
		? gradientConfig.desktop
		: (gradientConfig ?? true);
const gradientEnabledOnMobile =
	typeof gradientConfig === "object"
		? gradientConfig.mobile
		: (gradientConfig ?? true);
const gradientHeight = backgroundWallpaper.common?.gradient?.height ?? "30vh";
// 是否需要渲染渐变元素（任一设备启用 或 允许用户切换）
const shouldRenderGradient =
	gradientEnabledOnDesktop || gradientEnabledOnMobile || gradientSwitchable;

// 检查是否为首页
const isHomePageCheck = isHomePage(Astro.url.pathname);

// 检查是否在文章详情页
const isPostPage = !!postSlug;
const shouldRenderCategoryBar =
	!!siteConfig.categoryBar && (isHomePageCheck || isPostPage);
const enabledMobileBottomComponents =
	sidebarLayoutConfig.mobileBottomComponents?.filter(
		(component) => component.enable,
	) ?? [];
const hideMobileBottomOnPostPage =
	enabledMobileBottomComponents.length > 0 &&
	enabledMobileBottomComponents.every(
		(component) => component.showOnPostPage === false,
	);

// 随机选择副标题（当打字机关闭且为数组时）
const getRandomSubtitle = () => {
	const subtitle = backgroundWallpaper.common?.homeText?.subtitle;
	if (Array.isArray(subtitle)) {
		const randomIndex = Math.floor(Math.random() * subtitle.length);
		return subtitle[randomIndex];
	}
	return subtitle;
};
const randomSubtitle = getRandomSubtitle();

// 主页横幅文本只在首页的横幅模式且全局开关为 true 时显示。
// 全屏模式使用独立的 HomeWallpaperDecor，不能再叠加旧的横幅文案。
const homeTextEnable = backgroundWallpaper.common?.homeText?.enable;
const showHomeText = isBannerMode && !!homeTextEnable && isHomePageCheck;

const showBannerPostMeta =
	(isBannerMode || isFullscreenMode) &&
	isBackgroundEnabled &&
	!isHomePageCheck &&
	isPostPage &&
	!!bannerPostMeta;
const resolvedPostAiSummary =
	bannerPostAiSummary?.trim() || description?.trim() || "";
const showPostAiSummary = isPostPage && !!resolvedPostAiSummary;

const showBannerDim = (isBannerMode || isFullscreenMode) && isBackgroundEnabled;
const dimOpacity = backgroundWallpaper.common?.dimOpacity ?? 0.15;

const showBannerPageTitle =
	(isBannerMode || isFullscreenMode) &&
	isBackgroundEnabled &&
	!isHomePageCheck &&
	!isPostPage &&
	!!title;
// 手机端非首页不显示banner的CSS类
const mobileNonHomeBannerClass = !isHomePageCheck ? "mobile-hide-banner" : "";

// 计算主内容区域位置，考虑手机端非首页时banner被隐藏
const mainPanelTop =
	isBannerMode && isBackgroundEnabled
		? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
		: "5.5rem";

// 非首页统一隐藏壁纸，并让主内容从导航栏下方开始
const finalMainPanelTop =
	isHomePageCheck && isBannerMode && isBackgroundEnabled
		? mainPanelTop
		: "5.5rem";
const initialMainPanelTop =
	isHomePageCheck && isFullscreenMode ? "0" : finalMainPanelTop;

// 获取响应式侧边栏配置
const sidebarConfig = getResponsiveSidebarConfig();

// 侧边栏是否在文章详情页显示（默认 true）
const hideSidebarOnPostPage =
	sidebarLayoutConfig.hideSidebarOnPostPage === true;

// 在文章页面且启用了showBothSidebarsOnPostPage时，确保对侧组件参与网格计算
const shouldShowBothSidebarsOnPostPage: boolean =
	sidebarLayoutConfig.enable &&
	!hideSidebarOnPostPage &&
	isPostPage &&
	sidebarLayoutConfig.position !== "both" &&
	!!sidebarLayoutConfig.showBothSidebarsOnPostPage;

// position为left时，对侧为右侧；position为right时，对侧为左侧
const shouldAddRightSidebar: boolean =
	shouldShowBothSidebarsOnPostPage && sidebarLayoutConfig.position === "left";
const shouldAddLeftSidebar: boolean =
	shouldShowBothSidebarsOnPostPage && sidebarLayoutConfig.position === "right";

const effectiveIsBothSidebars: boolean =
	sidebarConfig.isBothSidebars || shouldShowBothSidebarsOnPostPage;
const effectiveHasRightComponents: boolean =
	sidebarConfig.hasRightComponents ||
	(shouldAddRightSidebar &&
		sidebarLayoutConfig.rightComponents.some((comp) => comp.enable));
const effectiveHasLeftComponents: boolean =
	sidebarConfig.hasLeftComponents ||
	(shouldAddLeftSidebar &&
		sidebarLayoutConfig.leftComponents.some((comp) => comp.enable));

// 使用effective值重新生成网格类
// 当position为right且文章页临时显示左侧栏时，tabletSidebar应为right（保持显示主侧栏）
const effectiveTabletSidebar = shouldAddLeftSidebar
	? ("right" as const)
	: sidebarConfig.tabletSidebar;

const updatedGridConfig: ResponsiveSidebarConfig = {
	...sidebarConfig,
	isBothSidebars: effectiveIsBothSidebars,
	hasLeftComponents: effectiveHasLeftComponents,
	hasRightComponents: effectiveHasRightComponents,
	tabletSidebar: effectiveTabletSidebar,
};

const { gridCols } = generateGridClasses(updatedGridConfig);
const sidebarClass = generateSidebarClasses(updatedGridConfig);
const rightSidebarClass =
	effectiveIsBothSidebars || sidebarLayoutConfig.position === "right"
		? generateRightSidebarClasses(updatedGridConfig)
		: "";
const mainContentClass = generateMainContentClasses(updatedGridConfig);
const staticBarClass = mainContentClass.replace("transition-main", "").trim();

const footerClass = ["footer", "col-span-1", "onload-animation"];

if (
	updatedGridConfig.isBothSidebars &&
	updatedGridConfig.hasLeftComponents &&
	updatedGridConfig.hasRightComponents
) {
	// 双侧栏：Footer 在平板与桌面都跟随内容列
	if (updatedGridConfig.tabletSidebar === "right") {
		footerClass.push(
			"md:col-start-1 md:col-span-1 xl:col-start-2 xl:col-span-1",
		);
	} else {
		footerClass.push(
			"md:col-start-2 md:col-span-1 xl:col-start-2 xl:col-span-1",
		);
	}
} else if (
	updatedGridConfig.hasLeftComponents &&
	!updatedGridConfig.hasRightComponents
) {
	// 仅左侧栏：内容列在第2列
	footerClass.push("md:col-start-2 md:col-span-1 xl:col-start-2 xl:col-span-1");
} else if (
	!updatedGridConfig.hasLeftComponents &&
	updatedGridConfig.hasRightComponents
) {
	// 仅右侧栏：内容列在第1列
	footerClass.push("md:col-start-1 md:col-span-1 xl:col-start-1 xl:col-span-1");
} else {
	footerClass.push("md:col-start-1 md:col-span-1 xl:col-start-1 xl:col-span-1");
}

const footerClassName = footerClass.join(" ");

// 检查是否应该启用半透明效果
const shouldEnableTransparency = isOverlayMode && isBackgroundEnabled;

const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
const stickyNavbar = siteConfig.navbar.stickyNavbar ?? false;

// 获取图片质量配置
const configQuality = getImageQuality();
const mobileQuality = Math.round(configQuality * 0.9);
const bannerCarouselEnabledDefault =
	backgroundWallpaper.common?.carousel?.enable ?? false;
const bannerCarouselSwitchable =
	backgroundWallpaper.common?.carousel?.switchable ?? false;
const bannerCarouselInterval = Math.max(
	backgroundWallpaper.common?.carousel?.interval ?? 5000,
	3000,
);
const bannerCarouselEffect =
	backgroundWallpaper.common?.carousel?.transitionEffect ?? "fade";
const hasMultipleImages =
	backgroundImages.desktop.length > 1 || backgroundImages.mobile.length > 1;
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug}>

<script is:inline>
	(() => {
		if (document.documentElement.dataset.siteTheme !== "pure" || !document.fonts) return;
		// Run after the head's font CSS and before either layout's text is parsed.
		// Pure reloads the document on navigation; briefly wait for WenKai instead
		// of painting a system font and swapping it on every page.
		const applyFontDisplay = () => {
			for (const sheet of document.styleSheets) {
				let rules;
				try {
					rules = sheet.cssRules;
				} catch {
					continue;
				}
				for (const rule of rules) {
					if (!(rule instanceof CSSFontFaceRule) ||
						!rule.style.getPropertyValue("font-family").includes("LXGW WenKai Screen")) continue;
					rule.style.setProperty("font-display", "block");
				}
			}
		};
		// Vite injects font styles during module loading in development.
		applyFontDisplay();
		const observer = new MutationObserver(applyFontDisplay);
		observer.observe(document.head, { childList: true, subtree: true, characterData: true });
		document.addEventListener("DOMContentLoaded", () => {
			applyFontDisplay();
			observer.disconnect();
		}, { once: true });
	})();
</script>

<div id="aemeath-shell">

<!-- 为全屏壁纸模式添加body类 -->
{shouldEnableTransparency && (
	<script>
		document.body.classList.add('wallpaper-transparent');
	</script>
)}

<!-- Navbar -->
<slot slot="head" name="head"></slot>
{isHomePageCheck && (
	<script is:inline>
		(() => {
			try {
				if (window.localStorage.getItem("rainzt.home-portfolio-intro-enabled.v1") === "0") {
					document.documentElement.classList.add("home-portfolio-intro-disabled");
				} else if (window.sessionStorage.getItem("rainzt.home-portfolio-intro-seen.v1") === "1") {
					document.documentElement.classList.add("home-portfolio-intro-seen");
				}
			} catch {
				// Storage can be unavailable in a privacy-restricted browser session.
			}
		})();
	</script>
)}
<div
    id="top-row"
    class="z-50 pointer-events-none relative transition-all duration-700 mx-auto"
    class:list={[
        stickyNavbar ? "h-18 fixed top-0 left-0 right-0 z-80" : "",
        isHomePageCheck ? "home-intro-navbar-boot" : "",
        navbarWidthFull ? "" : "w-full xl:w-[92vw] max-w-(--page-width) px-0 md:px-4",
    ]}
>
    <div
        id="navbar-wrapper"
        class:list={[
            "pointer-events-auto transition-all",
            stickyNavbar ? "" : "sticky top-0",
        ]}
    >
        <Navbar></Navbar>
    </div>
</div>

<!-- Wallpaper - 如果允许切换则始终渲染，否则只渲染当前模式 -->
<HomePortfolioIntro initialHome={isHomePageCheck} />

{(isWallpaperSwitchable || isBannerMode || isFullscreenMode || isOverlayMode) && (
<div id="wallpaper-wrapper" data-original-wallpaper-active={String(homepageWallpaperActiveByDefault)} class:list={[
	[
		"absolute z-10 w-full transition duration-700",
		showBannerPageTitle ? "wallpaper-page-title" : "overflow-hidden",
		mobileNonHomeBannerClass,
		!isHomePageCheck && "non-home-wallpaper-hidden",
	],
	isOverlayMode ? 'wallpaper-overlay' : '',
	isFullscreenMode ? 'wallpaper-fullscreen' : '',
	isHomePageCheck && (isFullscreenMode || isWallpaperSwitchable) ? 'homepage-fullscreen-decor' : '',
]} style={
	isOverlayMode
		? `${wallpaperOverlayVars} ${wallpaperFallbackVars}`
		: isFullscreenMode
			? `${wallpaperOverlayVars} ${wallpaperFallbackVars}`
			: `top: -${BANNER_HEIGHT_EXTEND}vh; ${wallpaperOverlayVars} ${wallpaperFallbackVars}`
}>
    <!-- 背景图片显示 -->
    {hasMultipleImages ? (
    /* 轮播模式：渲染所有图片为 slide-item */
    <div class:list={["relative h-full w-full", `effect-${bannerCarouselEffect}`]} id="banner-images-container"
         style={`z-index: 5; --carousel-interval: ${bannerCarouselInterval}ms;`}
         data-carousel-enabled={bannerCarouselEnabledDefault}
         data-carousel-switchable={bannerCarouselSwitchable}
         data-carousel-interval={bannerCarouselInterval}
         data-carousel-effect={bannerCarouselEffect}>
        {backgroundImages.mobile.map((src, index) => (
            <div class:list={["slide-item block lg:hidden", index === 0 && "active"]} data-index={index} data-wallpaper-device="mobile" data-original-wallpaper={isNationalDayWallpaper(src) ? "true" : undefined}>
                <ImageWrapper
                    alt="Mobile background image of the blog"
                    class="object-cover h-full w-full"
                    src={src}
                    position={getWallpaperPosition(src)}
                    plainImage={isNationalDayWallpaper(src)}
                    widths={[640, 750, 1080]}
                    sizes="100vw"
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : undefined}
                    defer={true}
                    quality={mobileQuality}
                />
            </div>
        ))}
        {backgroundImages.desktop.map((src, index) => (
            <div class:list={["slide-item hidden lg:block", index === 0 && "active"]} data-index={index} data-wallpaper-device="desktop" data-original-wallpaper={isNationalDayWallpaper(src) ? "true" : undefined}>
                <ImageWrapper
                    id="banner"
                    alt="Desktop background image of the blog"
                    class="object-cover h-full"
                    src={src}
                    position={getWallpaperPosition(src)}
                    plainImage={isNationalDayWallpaper(src)}
                    widths={[1280, 1920, 2560]}
                    sizes="100vw"
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : undefined}
                    defer={true}
                    quality={configQuality}
                />
            </div>
        ))}
    </div>
    ) : (
    /* 单图模式 */
    <div class="relative h-full w-full" id="banner-images-container">
        {backgroundImages.mobile.length > 0 && (
            <div class="banner-image-slot-mobile absolute inset-0 block lg:hidden" data-original-wallpaper={isNationalDayWallpaper(backgroundImages.mobile[0]) ? "true" : undefined}>
                <ImageWrapper
                    alt="Mobile background image of the blog"
                    class="object-cover h-full w-full"
                    src={backgroundImages.mobile[0]}
                    position={getWallpaperPosition(backgroundImages.mobile[0])}
                    plainImage={isNationalDayWallpaper(backgroundImages.mobile[0])}
                    widths={[640, 750, 1080]}
                    sizes="100vw"
                    loading="eager"
                    fetchpriority="high"
                    defer={!isHomePageCheck}
                    quality={mobileQuality}
                />
            </div>
        )}
        {backgroundImages.desktop.length > 0 && (
            <div class="banner-image-slot-desktop absolute inset-0 hidden lg:block" data-original-wallpaper={isNationalDayWallpaper(backgroundImages.desktop[0]) ? "true" : undefined}>
                <ImageWrapper
                    id="banner"
                    alt="Desktop background image of the blog"
                    class="object-cover h-full"
                    src={backgroundImages.desktop[0]}
                    position={getWallpaperPosition(backgroundImages.desktop[0])}
                    plainImage={isNationalDayWallpaper(backgroundImages.desktop[0])}
                    widths={[1280, 1920, 2560]}
                    sizes="100vw"
                    loading="eager"
                    fetchpriority="high"
                    defer={!isHomePageCheck}
                    quality={configQuality}
                />
            </div>
        )}
    </div>
    )}

    <!-- 壁纸轮播脚本（基于 CSS transition） -->
    {hasMultipleImages && (
    <script>
	if (document.documentElement.dataset.siteTheme === "aemeath") {
		void import("@/scripts/wallpaper-carousel");
	}
</script>
    )}
    
    {backgroundWallpaper.playerEnable && typeof backgroundWallpaper.src === "object" && !Array.isArray(backgroundWallpaper.src) && backgroundWallpaper.src.playerUrl && (
        <BackgroundPlayer playerUrl={backgroundWallpaper.src.playerUrl} playerMode={backgroundWallpaper.common?.playerMode ?? "order"} />
    )}

    <div id="banner-dim-container" class="absolute inset-0 z-10 pointer-events-none">
        {showBannerDim && <div class="banner-dim-overlay absolute inset-0" style={`background: rgba(0, 0, 0, ${dimOpacity})`}></div>}
    </div>

    <div id="banner-overlay-container" class="absolute inset-0 z-20 pointer-events-none transition-swup-fade">    <!-- Home page text overlay - 只在横幅模式显示，保留节点以支持运行时切换 -->
    {(isBannerMode || isWallpaperSwitchable) && homeTextEnable && (
        <div class={`banner-home-text-overlay absolute inset-0 z-20 flex items-center justify-center ${!showHomeText ? 'hidden' : ''}`}>
            <div class="w-4/5 lg:w-3/4 text-center mb-0">
                <div class="flex flex-col">
                    {backgroundWallpaper.common?.homeText?.title && (
                        <div class="banner-title font-bold text-white mb-2 lg:mb-4 leading-tight" style={{ '--banner-title-size': backgroundWallpaper.common.homeText.titleSize || "3rem" }}>
                            {backgroundWallpaper.common.homeText.title}
                        </div>
                    )}
                    {backgroundWallpaper.common?.homeText?.subtitle && (
                        <div id="banner-subtitle" class="banner-subtitle text-white/90 leading-snug" style={{ fontSize: backgroundWallpaper.common.homeText.subtitleSize || "1.5rem" }} data-subtitles={JSON.stringify(backgroundWallpaper.common.homeText.subtitle)}>
                            {backgroundWallpaper.common.homeText.typewriter?.enable ? (
                                <TypewriterText
                                    text={backgroundWallpaper.common.homeText.subtitle}
                                    speed={backgroundWallpaper.common.homeText.typewriter.speed}
                                    deleteSpeed={backgroundWallpaper.common.homeText.typewriter.deleteSpeed}
                                    pauseTime={backgroundWallpaper.common.homeText.typewriter.pauseTime}
                                />
                            ) : (
                                randomSubtitle
                            )}
                        </div>
                    )}
                </div>
            </div>
        </div>
    )}

    {isHomePageCheck && (isFullscreenMode || isWallpaperSwitchable) && <HomeWallpaperDecor />}

    <script is:inline>
        function setRandomSubtitle() {
            const subtitleElement = document.getElementById('banner-subtitle');
            if (!subtitleElement) return;

            const subtitlesData = subtitleElement.dataset.subtitles;
            if (!subtitlesData) return;

            try {
                const subtitles = JSON.parse(subtitlesData);
                // Only randomize if it's an array and typewriter is NOT enabled (check for typewriter class)
                if (Array.isArray(subtitles) && subtitles.length > 0 && !subtitleElement.querySelector('.typewriter')) {
                    // Use a global variable to persist the subtitle across Swup navigations
                    // This variable will be reset on full page reload (F5), meeting the requirement
                    if (!window.fireflyCachedSubtitle) {
                        const randomIndex = Math.floor(Math.random() * subtitles.length);
                        window.fireflyCachedSubtitle = subtitles[randomIndex];
                    }
                    subtitleElement.textContent = window.fireflyCachedSubtitle;
                }
            } catch (e) {
                console.error("Failed to parse subtitles", e);
            }
        }

        // Run on initial load
        setRandomSubtitle();
    </script>

    <!-- Non-home non-post page title overlay (desktop only) -->
    {showBannerPageTitle && (
        <div class="banner-page-title-overlay absolute inset-0 z-20 hidden lg:flex items-center justify-center pointer-events-none">
            <div class="w-4/5 lg:w-3/4 text-center mb-0">
                <div class="banner-page-title-content flex flex-col items-center gap-3">
                    <div class="banner-page-title font-bold text-white leading-tight inline-flex items-center justify-center gap-3">
                    {/* <Icon is:inline name="material-symbols:bookmark-rounded" class="banner-page-title-icon" /> */}
                        <span class="banner-page-title-text">{title}</span>
                    </div>
                    {bannerPageAiRecommendation && (
                        <AiRecommendationNote
                            text={bannerPageAiRecommendation.text}
                            segments={bannerPageAiRecommendation.segments}
                        />
                    )}
                </div>
            </div>
        </div>
    )}

    <!-- Non-home post banner meta overlay (desktop only) -->
    {showBannerPostMeta && bannerPostMeta && (
        <div class="banner-post-meta-overlay absolute inset-0 z-20 hidden lg:flex items-center justify-center pointer-events-none">
            <div class="w-4/5 lg:w-3/4 text-center mb-0">
                <div class="flex flex-col items-center gap-3">
                    <div
                        class:list={[
                            "banner-post-title font-bold text-white leading-tight",
                            bannerPostMeta.title.includes("\n") && "banner-post-title-break",
                        ]}
                    >
                        {bannerPostMeta.title}
                    </div>
                    <div class="banner-post-meta-list flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-white/90 text-sm md:text-base">
                        <span class="inline-flex items-center gap-1.5">
                            <Icon is:inline name="material-symbols:calendar-month-outline-rounded" class="text-[1.05em]" />
                            <span>{i18n(I18nKey.publishedAt)} {formatDateToYYYYMMDD(bannerPostMeta.published)}</span>
                        </span>
                        {bannerPostMeta.updated &&
                            bannerPostMeta.updated.getTime() !== bannerPostMeta.published.getTime() && (
                                <span class="inline-flex items-center gap-1.5">
                                    <Icon is:inline name="material-symbols:update-rounded" class="text-[1.05em]" />
                                    <span>{i18n(I18nKey.updatedAt)} {formatDateToYYYYMMDD(bannerPostMeta.updated)}</span>
                                </span>
                            )}
                        {typeof bannerPostMeta.words === "number" && (
                            <span class="inline-flex items-center gap-1.5">
                                <Icon is:inline name="material-symbols:ink-pen-outline-rounded" class="text-[1.05em]" />
                                <span>
                                    {bannerPostMeta.words} {i18n(bannerPostMeta.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
                                </span>
                            </span>
                        )}
                        {typeof bannerPostMeta.minutes === "number" && (
                            <span class="inline-flex items-center gap-1.5">
                                <Icon is:inline name="material-symbols:schedule-outline-rounded" class="text-[1.05em]" />
                                <span>
                                    {bannerPostMeta.minutes} {i18n(bannerPostMeta.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)} · {i18n(I18nKey.readTime)}
                                </span>
                            </span>
                        )}
                    </div>
                </div>
            </div>
        </div>
    )}

    <!-- Fullscreen 模式下显示向下滚动指示器 -->
    {(isFullscreenMode || isWallpaperSwitchable) && <ScrollDownIndicator />}
    </div>

    <!-- Water waves effect - 如果允许切换或任一设备启用则渲染 -->
    {shouldRenderWaves ? (
    <div class={`waves absolute -bottom-px h-[10vh] max-h-37.5 min-h-12.5 w-full md:h-[15vh]
        ${!wavesEnabledOnMobile ? 'hidden' : ''} ${!wavesEnabledOnDesktop ? 'md:hidden' : ''} ${wavesEnabledOnDesktop ? 'md:block' : ''}`}
        id="header-waves"
        style="transform: translateZ(0);">
        <svg
            class="waves"
            xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink"
            viewBox="0 24 150 28"
            preserveAspectRatio="none"
            shape-rendering="geometricPrecision"
        >
            <defs>
                <path
                    id="gentle-wave"
                    d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v48h-352z"
                >
                </path>
            </defs>
            <g class="parallax">
                <use
                    xlink:href="#gentle-wave"
                    x="48"
                    y="0"
                    class="opacity-25 fill-(--page-bg)"
                ></use>
                <use
                    xlink:href="#gentle-wave"
                    x="48"
                    y="3"
                    class="opacity-50 fill-(--page-bg)"
                ></use>
                <use
                    xlink:href="#gentle-wave"
                    x="48"
                    y="5"
                    class="opacity-65 fill-(--page-bg)"
                ></use>
                <use
                    xlink:href="#gentle-wave"
                    x="48"
                    y="7"
                    class=" opacity-75 fill-(--page-bg)"
                ></use>
            </g>
        </svg>
    </div>
    ) : null}

    <!-- Gradient transition - 当水波纹关闭时显示，提供壁纸底部到背景色的平滑过渡 -->
    {shouldRenderGradient ? (
    <div class={`wallpaper-gradient absolute bottom-0 left-0 w-full pointer-events-none
        ${!gradientEnabledOnMobile ? 'hidden' : ''} ${!gradientEnabledOnDesktop ? 'md:hidden' : ''} ${gradientEnabledOnDesktop ? 'md:block' : ''}`}
        id="wallpaper-gradient"
        style={`height: ${gradientHeight}; background: linear-gradient(to bottom, transparent, var(--page-bg));`}>
    </div>
    ) : null}
</div>
)}

{/* 当壁纸未渲染时，添加空的 Swup 占位容器，避免 Swup 找不到容器而回退为整页加载 */}
{!(isWallpaperSwitchable || isBannerMode || isFullscreenMode || isOverlayMode) && (
<>
    <div id="banner-overlay-container" class="hidden"></div>
    <div id="banner-dim-container" class="hidden"></div>
</>
)}

<!-- Main content -->
<div class={`absolute w-full z-30 pointer-events-none ${mobileNonHomeBannerClass ? 'mobile-main-no-banner' : ''} ${!isHomePageCheck || !(isBannerMode && isBackgroundEnabled) ? 'no-banner-layout' : ''} ${!isHomePageCheck ? 'non-home-main-layout' : ''}`} style={`top: ${initialMainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative w-full xl:w-[92vw] max-w-(--page-width) mx-auto pointer-events-auto">
        <div id="main-grid"
          class={`transition duration-700 w-full left-0 right-0 grid ${gridCols} grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4 ${!sidebarConfig.mobileShowSidebar ? 'mobile-no-sidebar' : ''}`}
          data-sidebar-enable={sidebarLayoutConfig.enable ? "true" : "false"}
          data-grid-hide-sidebar-on-post={hideSidebarOnPostPage ? "true" : "false"}
          data-sidebar-position={sidebarLayoutConfig.position}
          data-tablet-sidebar={sidebarLayoutConfig.tabletSidebar ?? "left"}
          data-show-both-sidebars-on-post={sidebarLayoutConfig.showBothSidebarsOnPostPage ? "true" : "false"}
        >

            {/* 渲染左侧边栏 - 根据position和tabletSidebar配置显示 */}
            {/*
                如果全局配置为双侧栏(position: both)或仅左侧栏(position: left)，则使用静态容器(不被swup替换)，避免闪烁。
                如果全局配置为仅右侧栏(position: right)，则使用动态容器(被swup替换)，以便在文章页显示左侧栏。
                注意：为了满足swup要求所有containers必须存在，我们在所有模式下都必须渲染 #left-sidebar-dynamic。
            */}
            {sidebarLayoutConfig.position !== "right" ? (
                <>
                    {sidebarLayoutConfig.enable ? (
                        <div id="left-sidebar-wrapper" class="contents" data-hide-sidebar-on-post={hideSidebarOnPostPage ? "true" : "false"} style="contain: layout style paint;">
                            {effectiveHasLeftComponents && (
                                <SideBar
                                    side={effectiveIsBothSidebars ? "left" : undefined}
                                    class={sidebarClass}
                                    headings={headings}
                                />
                            )}
                        </div>
                    ) : (
                        <div id="left-sidebar-wrapper" class="hidden"></div>
                    )}
                    <div id="left-sidebar-dynamic" class="hidden transition-swup-fade"></div>
                </>
            ) : (
                <div id="left-sidebar-dynamic" class="contents transition-swup-fade">
                    {effectiveIsBothSidebars && effectiveHasLeftComponents && (
						<SideBar side="left" class={sidebarClass} headings={headings}></SideBar>
                    )}
                </div>
            )}
                    
            {/* 主内容区包装器 - 包含静态栏位和swup容器，作为单个grid item */}
            <div class={staticBarClass}>
                {/* 主内容区 - 始终渲染，确保 Swup 容器存在 */}
                <main
                    id="swup-container"
                    class="transition-main"
                    data-current-post-category={postCategory || ""}
                >
                {/* 分类导航栏只在首页和文章详情页显示，并随页面内容一起切换 */}
                {shouldRenderCategoryBar && <div id="category-bar-wrapper"><CategoryBar currentPostCategory={postCategory} /></div>}
                {/* 携带网格布局类名，用于JS更新父容器 */}
                <div id="grid-class-carrier" data-grid-class={gridCols} class="hidden"></div>
                {/* 为每个页面提供一个隐藏的h1标题，用于SEO和可访问性 */}
                <h1 class="sr-only" data-theme-only="aemeath">{title || siteConfig.title}</h1>
                <div id="content-wrapper" class="onload-animation transition-leaving">
                    {showPostAiSummary && (
                        <div class="post-ai-summary-shell" data-theme-only="aemeath">
                            <div class="banner-post-ai-summary post-ai-summary-inline mobile-post-ai-summary" role="note" aria-label="AI摘要，由 ChatGPT Sol 5.6 Max 提供">
                                <div class="banner-post-ai-summary__label">
                                    <Icon is:inline name="material-symbols:auto-awesome-rounded" class="text-[1.05em]" />
                                    <span>AI摘要</span>
                                    <span class="banner-post-ai-summary__provider">由 ChatGPT Sol 5.6 Max 提供</span>
                                </div>
                                <p aria-live="polite" aria-label={resolvedPostAiSummary}>
                                    <TypewriterText
                                        text={resolvedPostAiSummary}
                                        speed={20}
                                        class="banner-post-ai-summary__typewriter"
                                    />
                                    <noscript>{resolvedPostAiSummary}</noscript>
                                </p>
                                <div class="banner-post-ai-summary__disclaimer">本文已使用Ai进行辅助创作，注意甄别</div>
                            </div>
                        </div>
                    )}
                    <slot></slot>
                </div>
            </main>
            </div>

            {/* 右侧边栏 - 双侧边栏模式或仅右侧栏模式 */}
            {/*
                如果全局配置为双侧栏(position: both)或仅右侧栏(position: right)，则使用静态容器(不被swup替换)，避免闪烁。
                如果全局配置为单侧栏(position: left)，则使用动态容器(被swup替换)，以便在文章页显示右侧栏。
                注意：为了满足swup要求所有containers必须存在，我们在所有模式下都必须渲染 #right-sidebar-dynamic。
                右侧边栏的显示由CSS类控制。
            */}
            {(sidebarLayoutConfig.position === "both" || sidebarLayoutConfig.position === "right") ? (
                <>
                    {sidebarLayoutConfig.enable ? (
                        <div id="right-sidebar-static" class="contents" data-hide-sidebar-on-post={hideSidebarOnPostPage ? "true" : "false"}>
                            {(effectiveIsBothSidebars || sidebarLayoutConfig.position === "right") && effectiveHasRightComponents && (
								<SideBar side="right" class={rightSidebarClass} headings={headings}></SideBar>
                            )}
                        </div>
                    ) : (
                        <div id="right-sidebar-static" class="hidden"></div>
                    )}
                    <div id="right-sidebar-dynamic" class="hidden transition-swup-fade"></div>
                </>
            ) : (
                <div id="right-sidebar-dynamic" class="contents transition-swup-fade">
                    {effectiveIsBothSidebars && effectiveHasRightComponents && (
						<SideBar side="right" class={rightSidebarClass} headings={headings}></SideBar>
                    )}
                </div>
            )}

            {/* 移动端底部组件 - 768px及以下显示 */}
            {enabledMobileBottomComponents.length > 0 && (
                <div
                    id="mobile-bottom-sidebar"
                    class:list={[
                        "col-span-1",
                        "md:hidden",
                        "mt-4",
                        isPostPage && hideMobileBottomOnPostPage ? "hidden" : "block",
                    ]}
                    data-hide-mobile-bottom-on-post={hideMobileBottomOnPostPage ? "true" : "false"}
                >
					<SideBar side="bottom" headings={headings}></SideBar>
                </div>
            )}

            <div class={footerClassName}>
                <Footer></Footer>
            </div>
        </div>

        <SpineModel></SpineModel>
        {live2dWidgetConfig.enable && <Live2DWidget config={live2dWidgetConfig} />}
    </div>
</div>

</div>
<PureShell title={title} postSlug={postSlug} postAiPolished={postAiPolished} postImageColor={postImageColor} headings={headings} />
<FloatingControls headings={headings} />
<CodeInteractionManager />


</Layout>

<style is:global>
  #wallpaper-wrapper.non-home-wallpaper-hidden {
    display: none !important;
  }

  /* Keep the original load animation from replaying when route classes clear. */
  #content-wrapper.onload-animation.route-motion-handled {
    animation: none;
    opacity: 1;
  }

  html:is(.route-home-to-inner, .route-inner-to-home).route-content-ready #content-wrapper {
    animation: route-content-enter 380ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  html.route-home-to-inner :is(#left-sidebar, #right-sidebar) {
    animation: none !important;
    opacity: 1;
    transform: none;
    transition: none;
  }

  html.route-inner-to-home.is-animating.is-leaving :is(#left-sidebar, #swup-container, #right-sidebar) {
    animation: route-shell-exit 320ms cubic-bezier(0.55, 0.055, 0.675, 0.19) both !important;
  }

  @keyframes route-shell-exit {
    from { opacity: 1; transform: translateY(0) scale(1); }
    to { opacity: 0; transform: translateY(-20px) scale(0.985); }
  }

  #route-white-screen {
    position: fixed;
    inset: 4.5rem 0 0;
    z-index: 70;
    background: #fff;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  html.route-white-cover #route-white-screen {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  html.route-white-cover #top-row {
    z-index: 80;
  }

  html.route-white-cover.route-white-reveal #route-white-screen {
    opacity: 0;
    transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes route-content-enter {
    from { opacity: 0.5; transform: translateY(14px) scale(0.99); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Restore the shared homepage wallpaper after an inner-page navigation. */
  html.route-inner-to-home #wallpaper-wrapper {
    opacity: 0 !important;
    transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  html.route-inner-to-home.route-content-ready #wallpaper-wrapper {
    opacity: 1 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    html.route-inner-to-home.is-animating.is-leaving :is(#left-sidebar, #swup-container, #right-sidebar) {
      animation: none !important;
    }

    html.route-white-cover.route-white-reveal #route-white-screen {
      transition: none;
    }

    html:is(.route-home-to-inner, .route-inner-to-home).route-content-ready #content-wrapper {
      animation: none;
      opacity: 1;
      transform: none;
    }

    html.route-inner-to-home #wallpaper-wrapper {
      opacity: 1 !important;
      transition: none !important;
    }
  }

  .non-home-main-layout #main-grid {
    transform: none !important;
  }

  /* Page-title content may extend below the banner, but animated waves must
     never widen the document. A direct refresh otherwise creates a horizontal
     scroll range while an in-site Swup navigation does not. */
  #wallpaper-wrapper.wallpaper-page-title {
    overflow-x: hidden;
    overflow-x: clip;
    overflow-y: visible;
  }

  /* Carousel slides intentionally scale or translate beyond their own bounds.
     Clip at the image stage so they can never create a restorable horizontal
     scroll offset, while sibling title and AI content remain unrestricted. */
  #banner-images-container {
    overflow: hidden;
    overflow: clip;
  }

  /* 右侧栏平滑过渡 */
  #right-sidebar {
    transition: opacity 0.35s ease-in-out,
                transform 0.35s ease-in-out;
  }

  @keyframes swupFadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.95;
    }
  }

</style>

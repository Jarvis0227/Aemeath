---
import { getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@components/common/Markdown.astro";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { getEnabledFriends, profileConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
const friendCount = getEnabledFriends().length;

const changelogEntries = [
	{
		title: "博客视觉与友链体验",
		description: "把友链、朋友圈、开屏动画和评论区的视觉连接重新梳理成一套更完整的体验。",
		href: "/blog-changelog/",
		tags: ["Aemeath V3.0.2", "UI"],
		tone: "blue",
		icon: "material-symbols:auto-awesome-rounded",
	},
	{
		title: "站点版本整理",
		description: "统一关于我、导航和站点信息中的博客版本展示，让每个入口都说同一种语言。",
		href: "/blog-changelog/",
		tags: ["Aemeath V3.0.2", "维护"],
		tone: "mint",
		icon: "material-symbols:history-rounded",
	},
	{
		title: "朋友圈 RSS 聚合",
		description: "把友链博客最近写下的文章收进一条持续发生的时间线。",
		href: "/moments/",
		tags: ["Aemeath V3.0.2", "RSS"],
		tone: "gold",
		icon: "material-symbols:rss-feed-rounded",
	},
	{
		title: "正在持续记录",
		description: "项目复盘、踩坑经验与商业化思考，会继续在这里慢慢留下。",
		href: "/blog-changelog/",
		tags: ["Aemeath V3.0.2", "持续更新"],
		tone: "violet",
		icon: "material-symbols:edit-note-rounded",
	},
];

const personalProjects = [
	{
		title: "Ai 全自动上架",
		description: "面向跨境电商的批量发布中枢，把表格、图库、视频与店铺流程串成可复盘的自动化链路。",
		tags: ["AI", "自动化", "跨境电商"],
		tone: "blue",
		icon: "material-symbols:auto-awesome-rounded",
	},
	{
		title: "Rain（记账）",
		description: "一款轻量的个人记账工具，把日常收支、分类和复盘整理成自己的节奏。",
		tags: ["效率工具", "生活记录"],
		tone: "mint",
		icon: "material-symbols:history-rounded",
	},
	{
		title: "Ai 画布智能体",
		description: "把产品图、提示词、参考风格与生成结果组织进可编排、可追溯的无限画布。",
		tags: ["AI", "工作流", "图片生成"],
		tone: "gold",
		icon: "material-symbols:auto-awesome-rounded",
	},
	{
		title: "个人博客",
		description: "记录技术实践、工具复盘与生活思考，把做过的事情慢慢整理成可以回看的文字。",
		tags: ["Astro", "写作", "持续更新"],
		tone: "violet",
		icon: "material-symbols:edit-note-rounded",
	},
	{
		title: "未完待续",
		description: "小项目比较多，几十个了；还会继续把新的想法做出来，再把它们慢慢收进这里。",
		tags: ["个人项目", "进行中"],
		tone: "gold",
		icon: "material-symbols:history-rounded",
	},
];

const recentActivity = [
	{
		kind: "文章",
		title: "从母系社会到父权制度：亲缘、私有制与现代性别关系的演变",
		href: "/posts/from-matriarchal-society-to-patriarchy/",
	},
	{
		kind: "文章",
		title: "朝朝听雨，岁岁有风",
		href: "/posts/chao-chao-listening-rain-years-wind/",
	},
	{

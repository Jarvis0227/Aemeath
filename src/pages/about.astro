---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { getEnabledFriends, profileConfig } from "@/config";
import { blogChangelogEntries } from "@/data/blog-changelog";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
const openSourcePost = await getEntry("spec", "about-open-source");
if (!openSourcePost) {
	throw new Error("About page open-source repositories not found");
}
const { Content: OpenSourceContent } = await render(openSourcePost);
const friendCount = getEnabledFriends().length;
const changelogDateCounts = new Map<string, number>();
for (const entry of blogChangelogEntries) {
	changelogDateCounts.set(
		entry.date,
		(changelogDateCounts.get(entry.date) ?? 0) + 1,
	);
}

const aboutChangelogMilestones = [
	{
		version: "V1.0.0",
		title: "博客从零上线",
		summary: "记录建站流程，确定博客内容方向与维护方式。",
	},
	{
		version: "V2.0.0",
		title: "朋友圈接入友链 RSS",
		summary: "聚合友链 RSS，开始在朋友圈查看其他博客更新。",
	},
	{
		version: "V4.0.0",
		title: "重做首页与侧栏",
		summary: "重构页面切换、个人资料卡和侧栏，补充账单页与外观设置。",
	},
	{
		version: "V4.1.0",
		title: "重做个人主页与博客历程",
		summary: "整理个人介绍、开源项目和站点里程碑，并重做更新日志的浏览方式。",
	},
] as const;

const aboutChangelogEntries = aboutChangelogMilestones.flatMap((milestone) => {
	const entry = blogChangelogEntries.find(
		(item) => item.version === milestone.version,
	);
	if (!entry) return [];

	const anchor =
		changelogDateCounts.get(entry.date) === 1
			? `blog-changelog-${entry.date}`
			: `blog-changelog-${entry.date}-${entry.version.toLowerCase().replaceAll(".", "-")}`;

	return [
		{
			...entry,
			title: milestone.title,
			summary: milestone.summary,
			month: entry.date.slice(0, 7).replace("-", "."),
			href: `/blog-changelog/#${anchor}`,
		},
	];
});

const personalProjects = [
	{
		title: "Ai 全自动上架",
		description:
			"面向跨境电商的批量发布中枢，把表格、图库、视频与店铺流程串成可复盘的自动化链路。",
		tags: ["AI", "自动化", "跨境电商"],
		tone: "blue",
		icon: "material-symbols:auto-awesome-rounded",
	},
	{
		title: "Rain（记账）",
		description:
			"一款轻量的个人记账工具，把日常收支、分类和复盘整理成自己的节奏。",
		tags: ["效率工具", "生活记录"],
		tone: "mint",
		icon: "material-symbols:history-rounded",
	},
	{
		title: "Ai 画布智能体",
		description:
			"把产品图、提示词、参考风格与生成结果组织进可编排、可追溯的无限画布。",
		tags: ["AI", "工作流", "图片生成"],
		tone: "gold",
		icon: "material-symbols:auto-awesome-rounded",
	},
	{
		title: "个人博客",
		description:
			"记录技术实践、工具复盘与生活思考，把做过的事情慢慢整理成可以回看的文字。",
		tags: ["Astro", "写作", "持续更新"],
		tone: "violet",
		icon: "material-symbols:edit-note-rounded",
	},
];

const interests = [
	"效率工具",
	"AI 工程化",
	"跨境电商",
	"开源",
	"网络安全",
	"逆向工程",
];
const stack = [
	"React",
	"TypeScript",
	"Astro",
	"ExtendScript",
	"Shopee",
	"TikTok",
	"BigSeller",
];
---

<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
	<!--
		ABOUT DESIGN CONTRACT
		THESIS: 用 GitHub profile / README 的信息秩序呈现朝朝听雨，而不是再造一个独立的壁纸英雄页。
		WORLD: 轻量边框、标签、状态行与项目列表；蓝色代表本站，金色代表被认真打磨的项目，薄荷色代表 RSS 连接。
		FIRST VIEWPORT: 先看到头像、身份、简介与行动入口，再看到 README 标签页与置顶项目。
		FINISH: 桌面双栏，手机单列；所有项目、友链与朋友圈入口保持可触达。
	-->
	<section class="github-profile" aria-labelledby="about-title">
		<header class="profile-header card-base onload-animation">
			<div class="profile-header__main">
				<div class="profile-avatar" aria-hidden="true">
					<ImageWrapper
						src={profileConfig.avatar || ""}
						alt={profileConfig.name}
						class="profile-avatar__image"
						loading="eager"
						widths={[160, 320]}
						sizes="6rem"
					/>
				</div>
				<div class="profile-identity">
					<div class="profile-kicker">
						<span class="profile-kicker__dot"></span>
						<span>PUBLIC PROFILE</span>
						<span class="profile-kicker__divider">/</span>
						<span>RAINZT.CN</span>
					</div>
					<h1 id="about-title">朝朝听雨</h1>
					<p class="profile-handle">Rain · 独立开发者 / 博客作者</p>
					<p class="profile-lead">把真实业务问题，拆成能被工具、文字和时间重新组织的答案。</p>
					<div class="profile-status" aria-label="当前状态">
						<span class="profile-status__dot"></span>
						<span>正在构建效率工具，也在持续写作</span>
					</div>
				</div>
			</div>

			<div class="profile-actions" aria-label="个人主页操作">
				<a class="profile-action profile-action--primary" href="https://github.com/Jarvis0227" target="_blank" rel="noopener noreferrer">
					<Icon is:inline name="fa7-brands:github" aria-hidden="true" />
					<span>查看 GitHub</span>
					<Icon is:inline name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
				</a>
				<a class="profile-action" href="/guestbook/">
					<Icon is:inline name="material-symbols:chat-bubble-outline-rounded" aria-hidden="true" />
					<span>去留言</span>
				</a>
			</div>
		</header>

		<nav class="profile-tabs" aria-label="关于我页面导航">
			<a class="profile-tab profile-tab--active" href="/about/" aria-current="page">
				<Icon is:inline name="material-symbols:person-outline-rounded" aria-hidden="true" />
				<span>个人资料</span>
			</a>
			<a class="profile-tab" href="/blog-changelog/">
				<Icon is:inline name="material-symbols:history-rounded" aria-hidden="true" />
				<span>博客日志</span>
			</a>
			<a class="profile-tab" href="/friends/">
				<Icon is:inline name="material-symbols:link-rounded" aria-hidden="true" />
				<span>友链</span>
				<em>{friendCount}</em>
			</a>
			<a class="profile-tab" href="/moments/">
				<Icon is:inline name="material-symbols:rss-feed-rounded" aria-hidden="true" />
				<span>朋友圈</span>
			</a>
		</nav>

		<div class="profile-layout">
			<main class="profile-main">
				<section class="profile-panel profile-readme card-base" aria-labelledby="readme-title">
					<header class="profile-panel__header">
						<div class="profile-panel__title">
							<Icon is:inline name="material-symbols:menu-book-rounded" aria-hidden="true" />
							<h2 id="readme-title">README.md</h2>
						</div>
						<span class="profile-panel__meta">公开 · 持续更新</span>
					</header>
					<div class="profile-readme__body">
						<p class="profile-readme__quote">“物物而不物于物，念念而不念于念。”</p>
						<Markdown class="profile-markdown">
							<Content />
						</Markdown>
					</div>
				</section>

				<section class="profile-panel card-base" aria-labelledby="personal-projects-title">
					<header class="profile-section-heading">
						<div>
							<p class="profile-section-kicker">MY PROJECTS</p>
							<h2 id="personal-projects-title">本人项目</h2>
						</div>
						<span class="profile-section-note">持续迭代中</span>
					</header>
					<div class="project-grid">
						{personalProjects.map((project) => (
							<article class:list={["project-card", `project-card--${project.tone}`]}>
								<span class="project-card__icon" aria-hidden="true"><Icon is:inline name={project.icon} /></span>
								<span class="project-card__body">
									<strong>{project.title}</strong>
									<span>{project.description}</span>
									<span class="project-card__tags">
										{project.tags.map((tag) => <em>{tag}</em>)}
									</span>
								</span>
							</article>
						))}
					</div>
					<p class="project-continuation"><strong>未完待续</strong>，还有一些想法正在慢慢打磨，准备好后再补进来。</p>
				</section>

				<section class="profile-panel card-base profile-foundation-panel" aria-labelledby="profile-foundation-title">
					<header class="profile-section-heading">
						<h2 id="profile-foundation-title">站在巨人的肩膀上</h2>
						<span class="profile-section-note">页面加载 · GitHub API</span>
					</header>
					<p class="profile-foundation-copy">我的博客源码开源在 Aemeath。本站基于 CuteLeaf 的 Firefly 主题继续二次创作，也在这里向原作者致谢。</p>
					<Markdown class="profile-foundation-list">
						<OpenSourceContent />
					</Markdown>
				</section>

			</main>

			<aside class="profile-sidebar" aria-label="个人资料补充信息">
				<section class="profile-panel profile-side-panel card-base" aria-labelledby="interests-title">
					<header class="profile-side-heading">
						<Icon is:inline name="material-symbols:explore-rounded" aria-hidden="true" />
						<h2 id="interests-title">正在关注</h2>
					</header>
					<p>从一线业务里找值得自动化的摩擦，也从文章和开源项目里找新的解法。</p>
					<div class="chip-list">
						{interests.map((item) => <span>{item}</span>)}
					</div>
				</section>

				<section class="profile-panel profile-side-panel card-base" aria-labelledby="stack-title">
					<header class="profile-side-heading">
						<Icon is:inline name="material-symbols:terminal-rounded" aria-hidden="true" />
						<h2 id="stack-title">技术轨迹</h2>
					</header>
					<div class="stack-list">
						{stack.map((item) => <span>{item}</span>)}
					</div>
					<p class="profile-side-note">工具会变化，解决问题的方式会留下。</p>
				</section>

				<section class="profile-panel profile-side-panel card-base" aria-labelledby="connect-title">
					<header class="profile-side-heading">
						<Icon is:inline name="material-symbols:alternate-email-rounded" aria-hidden="true" />
						<h2 id="connect-title">保持联系</h2>
					</header>
					<div class="profile-connect-list">
						<a href="https://github.com/Jarvis0227" target="_blank" rel="noopener noreferrer"><Icon is:inline name="fa7-brands:github" aria-hidden="true" /><span>GitHub</span><Icon class="profile-connect-arrow" is:inline name="material-symbols:arrow-outward-rounded" aria-hidden="true" /></a>
						<a href="https://space.bilibili.com/473321504" target="_blank" rel="noopener noreferrer"><Icon is:inline name="simple-icons:bilibili" aria-hidden="true" /><span>Bilibili</span><Icon class="profile-connect-arrow" is:inline name="material-symbols:arrow-outward-rounded" aria-hidden="true" /></a>
						<a href="mailto:1953549196@qq.com"><Icon is:inline name="fa7-solid:envelope" aria-hidden="true" /><span>1953549196@qq.com</span><Icon class="profile-connect-arrow" is:inline name="material-symbols:arrow-outward-rounded" aria-hidden="true" /></a>
					</div>
				</section>

				<section class="profile-panel profile-side-panel profile-server-panel card-base" aria-labelledby="server-title">
					<header class="profile-side-heading profile-server-heading">
						<Icon is:inline name="material-symbols:cloud-outline" aria-hidden="true" />
						<h2 id="server-title">服务器状态</h2>
					</header>
					<p class="profile-side-note">公开源码不包含服务器状态接口；如需展示，请在自己的部署环境中接入。</p>
				</section>

				<section class="profile-panel profile-side-panel card-base profile-mini-history" aria-labelledby="profile-history-title">
					<header class="profile-side-heading">
						<Icon is:inline name="material-symbols:history-rounded" aria-hidden="true" />
						<h2 id="profile-history-title">魔改日记</h2>
						<a class="profile-history-more" href="/blog-changelog/">完整记录 <span aria-hidden="true">→</span></a>
					</header>
					<p class="profile-history-intro">从博客上线开始，记下几次重要变化。</p>
					<ol class="profile-history-list">
						{aboutChangelogEntries.map((entry) => (
							<li class="profile-history-item">
								<span class="profile-history-track" aria-hidden="true">
									<span class:list={["profile-history-dot", `profile-history-dot--${entry.tone}`]}></span>
								</span>
								<a class="profile-history-card" href={entry.href}>
									<span class="profile-history-card__heading">
										<time class="profile-history-date" datetime={entry.date}>{entry.month}</time>
										<strong>{entry.title}</strong>
									</span>
									<span class="profile-history-card__summary">{entry.summary}</span>
								</a>
							</li>
						))}
					</ol>
				</section>
			</aside>
		</div>

		<footer class="profile-footer card-base">
			<div>
				<span class="profile-footer__eyebrow">OPEN SOURCE, OPEN CHANNEL</span>
				<strong>如果你也在把想法变成东西，欢迎来坐坐。</strong>
			</div>
			<div class="profile-footer__links">
				<a href="/friends/">认识友链 <Icon is:inline name="material-symbols:arrow-right-alt-rounded" aria-hidden="true" /></a>
				<a href="/moments/">看看朋友圈 <Icon is:inline name="material-symbols:arrow-right-alt-rounded" aria-hidden="true" /></a>
			</div>
		</footer>
	</section>
</MainGridLayout>



<style>
	.github-profile {
		display: grid;
		gap: 1rem;
		width: 100%;
		padding-bottom: 0.5rem;
	}

	.profile-header,
	.profile-panel,
	.profile-footer {
		border: 1px solid color-mix(in srgb, var(--primary) 14%, var(--line-divider));
		box-shadow: 0 0.7rem 1.8rem rgb(58 91 137 / 6%);
	}

	.profile-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 1.5rem;
		padding: clamp(1.1rem, 2.5vw, 1.65rem);
	}

	.profile-header__main {
		display: flex;
		align-items: flex-start;
		gap: 1.15rem;
		min-width: 0;
	}

	.profile-avatar {
		width: 6.25rem;
		height: 6.25rem;
		flex: 0 0 auto;
		padding: 0.22rem;
		border: 1px solid color-mix(in srgb, var(--primary) 32%, var(--line-divider));
		border-radius: 1.2rem;
		background: color-mix(in srgb, var(--primary) 8%, var(--card-bg));
		box-shadow: 0 0.55rem 1.2rem color-mix(in srgb, var(--primary) 12%, transparent);
	}

	:global(.profile-avatar__image) {
		width: 100%;
		height: 100%;
		border-radius: 0.95rem;
		background: var(--card-bg);
	}

	:global(.profile-avatar__image img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.profile-identity {
		min-width: 0;
	}

	.profile-kicker,
	.profile-footer__eyebrow,
	.profile-section-kicker {
		display: flex;
		align-items: center;
		gap: 0.42rem;
		margin: 0;
		color: var(--content-meta);
		font-size: 0.64rem;
		font-weight: 780;
		letter-spacing: 0.12em;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.profile-kicker__dot,
	.profile-status__dot {
		width: 0.48rem;
		height: 0.48rem;
		flex: 0 0 auto;
		border-radius: 50%;
		background: #34c759;
		box-shadow: 0 0 0 0.22rem rgb(52 199 89 / 14%);
	}

	.profile-kicker__divider {
		color: color-mix(in srgb, var(--content-meta) 45%, transparent);
	}

	.profile-identity h1 {
		margin: 0.55rem 0 0;
		color: var(--text-color);
		font-size: clamp(1.7rem, 3.2vw, 2.35rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.1;
	}

	.profile-handle {
		margin: 0.3rem 0 0;
		color: var(--content-meta);
		font-size: 0.9rem;
	}

	.profile-lead {
		max-width: 42rem;
		margin: 0.75rem 0 0;
		color: var(--text-color);
		font-size: 0.97rem;
		line-height: 1.7;
	}

	.profile-status {
		display: inline-flex;
		align-items: center;
		gap: 0.48rem;
		margin-top: 0.75rem;
		color: var(--content-meta);
		font-size: 0.76rem;
	}

	.profile-status__dot {
		width: 0.38rem;
		height: 0.38rem;
		box-shadow: none;
	}

	.profile-actions {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.55rem;
		min-width: 9.2rem;
	}

	.profile-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.48rem;
		min-height: 2.35rem;
		padding: 0.55rem 0.8rem;
		border: 1px solid var(--glass-control-border);
		border-radius: 0.65rem;
		background: transparent;
		color: var(--primary);
		font-size: 0.78rem;
		font-weight: 720;
		text-decoration: none;
		transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease;
	}

	.profile-action svg:first-child {
		font-size: 1rem;
	}

	.profile-action svg:last-child {
		margin-left: auto;
		font-size: 0.9rem;
		opacity: 0.68;
	}

	.profile-action--primary {
		border-color: color-mix(in srgb, var(--primary) 65%, var(--line-divider));
		background: transparent;
		color: var(--primary);
	}

	.profile-action:hover,
	.profile-action:focus-visible {
		border-color: var(--primary);
		background: transparent;
		transform: translateY(-1px);
		outline: none;
	}

	.profile-action--primary:hover,
	.profile-action--primary:focus-visible {
		background: transparent;
		color: var(--primary);
	}

	.profile-tabs {
		display: flex;
		align-items: stretch;
		gap: 0.25rem;
		min-height: 3rem;
		overflow-x: auto;
		border: 1px solid color-mix(in srgb, var(--primary) 16%, var(--line-divider));
		border-radius: 1rem;
		background: color-mix(in srgb, var(--card-bg) 94%, transparent);
		box-shadow: 0 0.35rem 1rem rgb(58 91 137 / 4%);
		scrollbar-width: none;
	}

	.profile-tabs::-webkit-scrollbar {
		display: none;
	}

	.profile-tab {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.42rem;
		min-width: max-content;
		padding: 0.78rem 0.9rem 0.68rem;
		border-bottom: 2px solid transparent;
		border-radius: 0.72rem 0.72rem 0 0;
		color: var(--content-meta);
		font-size: 0.8rem;
		font-weight: 680;
		text-decoration: none;
		transition: color 180ms ease, border-color 180ms ease, background-color 180ms ease;
	}

	.profile-tab svg {
		font-size: 1rem;
	}

	.profile-tab em {
		min-width: 1.25rem;
		padding: 0.1rem 0.32rem;
		border-radius: 999px;
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		font-size: 0.65rem;
		font-style: normal;
		line-height: 1.25;
		text-align: center;
	}

	.profile-tab:hover,
	.profile-tab:focus-visible,
	.profile-tab--active {
		border-bottom-color: var(--primary);
		color: var(--primary);
		outline: none;
	}

	.profile-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(15rem, 18rem);
		align-items: start;
		gap: 1rem;
	}

	.profile-main,
	.profile-sidebar {
		display: grid;
		gap: 1rem;
		min-width: 0;
	}

	.profile-panel {
		padding: clamp(1rem, 2.5vw, 1.45rem);
	}

	.profile-panel__header,
	.profile-section-heading,
	.profile-side-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
	}

	.profile-panel__title,
	.profile-side-heading {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
	}

	.profile-panel__title svg,
	.profile-side-heading svg {
		flex: 0 0 auto;
		color: var(--primary);
		font-size: 1.08rem;
	}

	.profile-panel__title h2,
	.profile-section-heading h2,
	.profile-side-heading h2 {
		margin: 0;
		color: var(--text-color);
		font-size: 1rem;
		font-weight: 780;
		letter-spacing: -0.015em;
	}

	.profile-panel__meta,
	.profile-section-note {
		color: var(--content-meta);
		font-size: 0.68rem;
		white-space: nowrap;
	}

	.profile-readme__body {
		margin-top: 1.1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--line-divider);
	}

	.profile-readme.card-base {
		position: relative;
		z-index: 1;
		overflow: visible;
	}

	.profile-readme__quote {
		margin: 0 0 1.15rem;
		padding: 0.8rem 1rem;
		border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--line-divider));
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--primary) 7%, var(--card-bg));
		color: var(--text-color);
		font-size: clamp(1rem, 1.8vw, 1.18rem);
		font-weight: 700;
		line-height: 1.7;
	}

	:global(.profile-markdown) {
		margin: 0;
		color: var(--content-meta);
	}

	:global(.profile-markdown h1) {
		display: none;
	}

	:global(.profile-markdown p) {
		max-width: none;
		margin: 0.85rem 0 0;
		font-size: 0.92rem;
		line-height: 1.9;
	}

	:global(.profile-markdown p:first-of-type) {
		margin-top: 0;
	}

	:global(.profile-markdown strong) {
		color: color-mix(in srgb, var(--primary) 80%, var(--text-color));
	}

	:global(.profile-markdown h2) {
		margin: 1.45rem 0 0.55rem;
		color: var(--text-color);
		font-family: "KaiTi", "STKaiti", var(--font-lxgw-wenkai), serif;
		font-size: 1.16rem;
		font-weight: 780;
		letter-spacing: 0.01em;
		line-height: 1.55;
		text-wrap: balance;
	}

	:global(.profile-markdown h3) {
		margin: 0.9rem 0 0.35rem;
		color: var(--text-color);
		font-family: "KaiTi", "STKaiti", var(--font-lxgw-wenkai), serif;
		font-size: 1rem;
		font-weight: 760;
		letter-spacing: 0.01em;
		line-height: 1.55;
	}

	:global(.profile-markdown .profile-about-wordmark) {
		--profile-popover-accent: #e4a2b5;
		--profile-popover-soft: #ffe7ed;
		--profile-popover-ink: #984b65;
		position: relative;
		display: inline-block;
		border-radius: 0.18em;
		padding-inline: 0.08em;
		color: var(--profile-popover-ink);
		background: color-mix(in srgb, var(--profile-popover-soft) 58%, transparent);
		font-family: var(--font-active-sans, var(--font-sans, sans-serif));
		font-size: 1.08em;
		font-weight: 760;
		letter-spacing: 0.035em;
		text-decoration: underline wavy color-mix(in srgb, var(--profile-popover-accent) 90%, transparent);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 0.2em;
		cursor: help;
	}

	:global(.profile-markdown .profile-about-wordmark:focus-visible) {
		outline: 2px solid color-mix(in srgb, var(--profile-popover-accent) 65%, transparent);
		outline-offset: 3px;
	}

	:global(.profile-markdown .profile-author-trigger) {
		--profile-popover-accent: #e4cb73;
		--profile-popover-soft: #fff2c2;
		--profile-popover-ink: #816714;
		position: relative;
		display: inline-block;
		border-radius: 0.18em;
		padding-inline: 0.08em;
		color: var(--profile-popover-ink);
		background: color-mix(in srgb, var(--profile-popover-soft) 58%, transparent);
		font-weight: 780;
		text-decoration: underline wavy color-mix(in srgb, var(--profile-popover-accent) 90%, transparent);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 0.22em;
		cursor: help;
	}

	:global(.profile-markdown .profile-author-trigger:focus-visible) {
		border-radius: 0.15rem;
		outline: 2px solid color-mix(in srgb, #7654c2 55%, transparent);
		outline-offset: 3px;
	}

	:global(.profile-markdown .profile-author-tooltip) {
		position: absolute;
		z-index: 40;
		top: calc(100% + 0.38rem);
		left: 0;
		display: flex;
		align-items: center;
		gap: 0.52rem;
		width: min(16rem, calc(100vw - 2rem));
		padding: 0.26rem 0.68rem;
		border: 1px solid color-mix(in srgb, var(--profile-popover-accent, #8872e8) 30%, var(--line-divider));
		border-radius: 0.78rem;
		background: color-mix(in srgb, var(--card-bg) 96%, var(--profile-popover-soft, #8872e8) 4%);
		box-shadow: 0 0.45rem 1.2rem color-mix(in srgb, var(--profile-popover-accent, #8872e8) 10%, transparent);
		color: var(--text-color);
		font-size: 0.8rem;
		font-weight: 400;
		font-family: var(--font-active-sans, var(--font-sans, sans-serif));
		line-height: 1.45;
		text-decoration: none;
		white-space: normal;
		opacity: 0;
		visibility: hidden;
		transform: translateY(-0.25rem);
		transition: opacity 150ms ease, transform 150ms ease, visibility 150ms ease;
		pointer-events: auto;
	}

	:global(.profile-markdown .profile-author-tooltip::before) {
		position: absolute;
		top: -0.3rem;
		left: 1.1rem;
		width: 0.52rem;
		height: 0.52rem;
		border-top: 1px solid color-mix(in srgb, var(--profile-popover-accent, #8872e8) 42%, var(--line-divider));
		border-left: 1px solid color-mix(in srgb, var(--profile-popover-accent, #8872e8) 42%, var(--line-divider));
		background: color-mix(in srgb, var(--card-bg) 92%, var(--profile-popover-soft, #8872e8) 8%);
		content: "";
		transform: rotate(45deg);
	}

	:global(.profile-markdown .profile-author-trigger:hover .profile-author-tooltip),
	:global(.profile-markdown .profile-author-trigger:focus .profile-author-tooltip),
	:global(.profile-markdown .profile-about-wordmark:hover .profile-author-tooltip),
	:global(.profile-markdown .profile-about-wordmark:focus .profile-author-tooltip) {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	:global(.profile-markdown .profile-author-tooltip--site) {
		left: 0;
		right: auto;
	}

	:global(.profile-markdown .profile-author-tooltip--site::before) {
		left: 1.75rem;
		right: auto;
	}

	:global(.profile-markdown .profile-author-tooltip img) {
		flex: 0 0 2.45rem;
		width: 2.45rem;
		height: 2.45rem;
		border: 2px solid color-mix(in srgb, var(--profile-popover-accent, #8872e8) 45%, var(--card-bg));
		border-radius: 50%;
		object-fit: cover;
	}

	:global(.profile-markdown .profile-author-tooltip__copy) {
		display: grid;
		gap: 0.08rem;
		min-width: 0;
	}

	:global(.profile-markdown .profile-author-tooltip__copy strong) {
		color: var(--profile-popover-ink, var(--text-color));
		font-size: 0.9rem;
		font-weight: 780;
	}

	:global(.profile-markdown .profile-author-tooltip__role) {
		color: color-mix(in srgb, var(--profile-popover-ink, var(--primary)) 90%, var(--text-color));
		font-size: 0.72rem;
		font-weight: 650;
	}

	:global(.profile-markdown .profile-author-tooltip__bio) {
		color: color-mix(in srgb, var(--text-color) 72%, var(--content-meta));
		font-size: 0.76rem;
		line-height: 1.42;
	}

	:global(.profile-markdown .profile-about-accent) {
		font-weight: 700;
	}

	:global(.profile-markdown .profile-about-accent--blue) {
		color: color-mix(in srgb, #287fc3 86%, var(--text-color));
	}

	:global(.profile-markdown .profile-about-accent--violet) {
		color: color-mix(in srgb, #875bd1 84%, var(--text-color));
	}

	:global(.profile-markdown .profile-about-accent--mint) {
		color: color-mix(in srgb, #128b7d 86%, var(--text-color));
	}

	:global(.profile-markdown .profile-tech-pill) {
		display: inline-block;
		margin: 0 0.04em;
		padding: 0.03em 0.4em;
		border: 1px solid color-mix(in srgb, currentColor 17%, transparent);
		border-radius: 0.45em;
		font-size: 0.88em;
		font-weight: 680;
		line-height: 1.55;
		white-space: nowrap;
	}

	:global(.profile-markdown .profile-tech-pill--astro) {
		color: color-mix(in srgb, #7654c2 86%, var(--text-color));
		background: color-mix(in srgb, #7654c2 9%, var(--card-bg));
	}

	:global(.profile-markdown .profile-tech-pill--svelte) {
		color: color-mix(in srgb, #db542f 88%, var(--text-color));
		background: color-mix(in srgb, #db542f 8%, var(--card-bg));
	}

	:global(.profile-markdown .profile-tech-pill--typescript) {
		color: color-mix(in srgb, #287fc3 88%, var(--text-color));
		background: color-mix(in srgb, #287fc3 8%, var(--card-bg));
	}

	:global(.profile-markdown .profile-tech-pill--tailwind) {
		color: color-mix(in srgb, #128b9f 88%, var(--text-color));
		background: color-mix(in srgb, #128b9f 8%, var(--card-bg));
	}

	:global(.profile-markdown .profile-tech-pill--waline) {
		color: color-mix(in srgb, #168768 88%, var(--text-color));
		background: color-mix(in srgb, #168768 8%, var(--card-bg));
	}

	:global(.profile-markdown .profile-tech-pill--umami) {
		color: color-mix(in srgb, #bd6a20 88%, var(--text-color));
		background: color-mix(in srgb, #bd6a20 8%, var(--card-bg));
	}

	.profile-section-heading {
		align-items: flex-end;
		margin-bottom: 1rem;
	}

	.profile-section-heading > div {
		display: grid;
		gap: 0.25rem;
	}

	.profile-section-kicker {
		color: var(--primary);
		font-size: 0.6rem;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.7rem;
	}

	.project-continuation {
		margin: 0.7rem 0 0;
		color: var(--content-meta);
		font-size: 0.7rem;
		line-height: 1.65;
		text-align: center;
	}

	.project-continuation strong {
		margin-right: 0.2rem;
		color: var(--text-color);
		font-weight: 700;
	}

	.project-card {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr);
		align-items: start;
		gap: 0.7rem;
		min-width: 0;
		padding: 0.82rem;
		border: 1px solid color-mix(in srgb, var(--primary) 24%, var(--line-divider));
		border-radius: 0.78rem;
		background: transparent;
		color: inherit;
		text-decoration: none;
		transition: transform 180ms ease, border-color 180ms ease;
	}

	.project-card:hover {
		border-color: color-mix(in srgb, var(--primary) 48%, var(--line-divider));
		transform: translateY(-2px);
	}

	.project-card:focus-visible {
		border-color: var(--primary);
		outline: 2px solid color-mix(in srgb, var(--primary) 55%, transparent);
		outline-offset: 2px;
	}

	.project-card__icon {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 0.6rem;
		background: color-mix(in srgb, var(--primary) 12%, transparent);
		color: var(--primary);
		font-size: 1.1rem;
	}

	.project-card--gold .project-card__icon {
		background: color-mix(in srgb, #f0b933 20%, transparent);
		color: #c48a08;
	}

	.project-card--mint .project-card__icon {
		background: color-mix(in srgb, #42c7b0 18%, transparent);
		color: #159b8b;
	}

	.project-card--violet .project-card__icon {
		background: color-mix(in srgb, #8b78db 17%, transparent);
		color: #7361c8;
	}

	.project-card__body {
		display: grid;
		gap: 0.35rem;
		min-width: 0;
	}

	.project-card__body > strong {
		overflow: hidden;
		color: var(--text-color);
		font-size: 0.88rem;
		font-weight: 760;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.project-card__body > span:not(.project-card__tags) {
		display: -webkit-box;
		overflow: hidden;
		color: var(--content-meta);
		font-size: 0.74rem;
		line-height: 1.55;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.project-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
	}

	.project-card__tags em {
		padding: 0.18rem 0.34rem;
		border-radius: 0.35rem;
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		font-size: 0.6rem;
		font-style: normal;
		line-height: 1.2;
	}

	/* Let the open-source introduction use the full content width. */
	.profile-foundation-copy {
		max-width: 100%;
		margin: 0.8rem 0 1rem;
		color: var(--content-meta);
		font-size: 0.82rem;
		line-height: 1.75;
	}

	.profile-foundation-list {
		display: grid;
		gap: 0.5rem;
		min-width: 0;
	}

	.profile-side-panel {
		padding: 1rem;
	}

	.profile-side-heading {
		justify-content: flex-start;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--line-divider);
	}

	.profile-side-panel > p {
		margin: 0.85rem 0 0;
		color: var(--content-meta);
		font-size: 0.76rem;
		line-height: 1.75;
	}

	.profile-history-intro {
		margin-top: 0.65rem !important;
		font-size: 0.7rem !important;
	}

	.profile-history-more {
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
		margin-left: auto;
		color: var(--primary);
		font-size: 0.64rem;
		font-weight: 650;
		text-decoration: none;
		white-space: nowrap;
	}

	.profile-history-more:hover,
	.profile-history-more:focus-visible {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.profile-history-list {
		display: grid;
		gap: 0.45rem;
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
	}

	.profile-history-item {
		display: grid;
		grid-template-columns: 0.7rem minmax(0, 1fr);
		align-items: stretch;
		gap: 0.45rem;
		min-width: 0;
	}

	.profile-history-date {
		color: var(--primary);
		font-size: 0.62rem;
		font-weight: 730;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.profile-history-track {
		position: relative;
		display: flex;
		justify-content: center;
	}

	.profile-history-track::before {
		position: absolute;
		top: -0.45rem;
		bottom: -0.45rem;
		width: 1px;
		background: color-mix(in srgb, var(--primary) 35%, var(--line-divider));
		content: "";
	}

	.profile-history-item:first-child .profile-history-track::before {
		top: 0.62rem;
	}

	.profile-history-item:last-child .profile-history-track::before {
		bottom: calc(100% - 0.62rem);
	}

	.profile-history-dot {
		position: relative;
		z-index: 1;
		width: 0.52rem;
		height: 0.52rem;
		margin-top: 0.62rem;
		border: 2px solid var(--card-bg);
		border-radius: 50%;
		background: var(--primary);
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 32%, transparent);
	}

	.profile-history-dot--mint {
		background: #159b8b;
		box-shadow: 0 0 0 1px color-mix(in srgb, #159b8b 32%, transparent);
	}

	.profile-history-dot--gold {
		background: #c48a08;
		box-shadow: 0 0 0 1px color-mix(in srgb, #c48a08 32%, transparent);
	}

	.profile-history-card {
		display: grid;
		gap: 0.32rem;
		min-width: 0;
		padding: 0.52rem 0.25rem 0.58rem 0.05rem;
		border-bottom: 1px solid color-mix(in srgb, var(--primary) 14%, var(--line-divider));
		color: inherit;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.profile-history-card:hover,
	.profile-history-card:focus-visible {
		color: var(--primary);
		outline: none;
	}

	.profile-history-item:last-child .profile-history-card {
		border-bottom: 0;
	}

	.profile-history-card__heading {
		display: grid;
		grid-template-columns: 3.2rem minmax(0, 1fr);
		align-items: baseline;
		gap: 0.3rem;
		min-width: 0;
	}

	.profile-history-card__heading strong {
		min-width: 0;
		color: var(--text-color);
		font-size: 0.72rem;
		font-weight: 720;
		line-height: 1.45;
		text-wrap: pretty;
	}

	.profile-history-card__summary {
		display: block;
		color: var(--content-meta);
		font-size: 0.66rem;
		line-height: 1.55;
	}

	.chip-list,
	.stack-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.8rem;
	}

	.chip-list span,
	.stack-list span {
		padding: 0.28rem 0.5rem;
		border: 1px solid color-mix(in srgb, var(--primary) 16%, var(--line-divider));
		border-radius: 0.45rem;
		background: color-mix(in srgb, var(--primary) 6%, var(--card-bg));
		color: var(--btn-content);
		font-size: 0.65rem;
		line-height: 1.2;
	}

	.stack-list span {
		border-color: color-mix(in srgb, #42c7b0 18%, var(--line-divider));
		background: color-mix(in srgb, #42c7b0 7%, var(--card-bg));
	}

	.profile-side-note {
		font-size: 0.7rem !important;
	}

	.profile-server-heading {
		justify-content: flex-start;
	}

	.server-status {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		flex: 0 0 auto;
		margin-left: auto;
		color: #159b62;
		font-size: 0.66rem;
		font-weight: 720;
		white-space: nowrap;
	}

	.server-status > span:first-child {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 999px;
		background: #34c759;
		box-shadow: 0 0 0 0.2rem rgb(52 199 89 / 14%);
	}

	.server-status[data-state="loading"] {
		color: var(--content-meta);
	}

	.server-status[data-state="loading"] > span:first-child {
		background: #f2b94b;
		box-shadow: 0 0 0 0.2rem rgb(242 185 75 / 14%);
	}

	.server-status[data-state="offline"] {
		color: #c5782e;
	}

	.server-status[data-state="offline"] > span:first-child {
		background: #e19a45;
		box-shadow: 0 0 0 0.2rem rgb(225 154 69 / 14%);
	}

	.server-stat-list {
		display: grid;
		gap: 0.35rem;
		margin-top: 0.8rem;
	}

	.server-stat {
		display: grid;
		grid-template-columns: 1.45rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		padding: 0.5rem 0.45rem;
		border: 1px solid color-mix(in srgb, var(--primary) 24%, var(--line-divider));
		border-radius: 0.55rem;
		background: transparent;
	}

	.server-stat__icon {
		display: grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 0.42rem;
		background: color-mix(in srgb, var(--primary) 11%, transparent);
		color: var(--primary);
		font-size: 0.9rem;
	}

	.server-stat__copy {
		display: grid;
		gap: 0.08rem;
		min-width: 0;
	}

	.server-stat__copy strong {
		overflow: hidden;
		color: var(--text-color);
		font-size: 0.72rem;
		font-weight: 720;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.server-stat__copy small {
		overflow: hidden;
		color: var(--content-meta);
		font-size: 0.62rem;
		line-height: 1.35;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.server-stat__value {
		color: var(--text-color);
		font-size: 0.72rem;
		font-weight: 780;
		white-space: nowrap;
	}

	.server-stat__meter {
		display: block;
		grid-column: 2 / -1;
		height: 0.24rem;
		overflow: hidden;
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary) 12%, var(--line-divider));
	}

	.server-stat__meter > span {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: inherit;
		background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 68%, #fff), var(--primary));
		transform: scaleX(var(--meter-scale, 0));
		transform-origin: left center;
		transition: transform 420ms ease;
	}

	.server-stat[data-server-stat="system"] .server-stat__meter {
		display: none;
	}


									<strong>{project.title}</strong>
									<span>{project.description}</span>
									<span class="project-card__tags">
										{project.tags.map((tag) => <em>{tag}</em>)}
									</span>
								</span>
								<Icon class="project-card__arrow" is:inline name="material-symbols:arrow-outward-rounded" aria-hidden="true" />

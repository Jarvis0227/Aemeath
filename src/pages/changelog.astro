const articleByVersion = new Map(
	noticeArticles.map((article) => [article.version, article.html]),
);

const availableNotices = notices.filter((notice) =>
	articleByVersion.has(notice.version),
);
const latestNotice = availableNotices[0] ?? notices[0];
const latestNoticeVersion = latestNotice.version;
const noticeMetaJson = JSON.stringify(
	Object.fromEntries(notices.map((notice) => [notice.version, notice])),
);
---

<MainGridLayout title="更新日志" description="自动上架系统完整更新公告">
	<section
		class="notice-page"
		data-notice-root
		data-latest-notice-version={latestNoticeVersion}
		data-notice-views={noticeMetaJson}
	>
		<aside class="notice-aside">
			<section class="notice-hero">
				<div class="notice-hero-kicker">
					<Icon is:inline name="material-symbols:history-edu-rounded" />
					<span data-notice-kicker>{latestNotice.kicker}</span>
					<span class="notice-new-badge" data-notice-new-badge>NEW</span>
				</div>
				<h1 data-notice-title>{latestNotice.title}</h1>
				<p data-notice-desc>{latestNotice.desc}</p>
				<div class="notice-version">
					<span>公告版本</span>
					<strong data-notice-version>{latestNotice.version}</strong>
				</div>
			</section>

			<nav class="notice-nav" aria-label="公告目录">
				<p class="notice-nav-title">快速查看</p>
				<a href="#summary" data-section="summary"><i></i>本次更新内容</a>
				<a href="#sheet-maker" data-section="sheet-maker"><i></i>表格制作变化</a>
				<a href="#export-order" data-section="universal"><i></i>检查方法</a>
				<a href="#history" data-section="interface"><i></i>公告历史</a>
				<a href="#checklist" data-section="checklist"><i></i>更新后检查</a>
			</nav>

			<section class="notice-history" aria-label="历史公告">
				<div class="notice-history-title">
					<Icon is:inline name="material-symbols:history-rounded" />
					<span>历史公告</span>
				</div>
				<div class="history-card">
					{availableNotices.map((notice, index) => (
						<button
							class:list={["history-entry", index === 0 && "active"]}
							type="button"
							data-notice-button={notice.version}
						>
							<strong>
								{notice.version.replaceAll("-", ".").replace(".0", ".")} {index === 0 ? "最新公告" : "更新公告"}
								{index === 0 && <span class="history-new-badge">NEW</span>}
							</strong>
							<span>{notice.brief}</span>
						</button>
					))}
				</div>
			</section>
		</aside>

		<div class="notice-content">
			{availableNotices.length > 0 ? (
				availableNotices.map((notice, index) => (
					<article
						class="notice-main notice-view"
						data-notice-version={notice.version}
						hidden={index !== 0}
						set:html={articleByVersion.get(notice.version)}
					/>
				))
			) : (
				<article class="notice-main notice-empty">
					<h2>暂时没有读取到公告</h2>
					<p>请确认主项目公告文件存在：{noticePath}</p>
				</article>
			)}
		</div>
	</section>
</MainGridLayout>

<style>
	.notice-page {
		display: grid;
		grid-template-columns: minmax(13rem, 15rem) minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
		width: 100%;
		position: relative;
		z-index: 1;
		--notice-ink: rgb(0 0 0 / 0.9);
		--notice-muted: rgb(0 0 0 / 0.6);
		--notice-soft: rgb(0 0 0 / 0.42);
		--notice-panel: color-mix(in oklab, var(--card-bg) 72%, transparent);
		--notice-panel-strong: color-mix(in oklab, var(--card-bg) 86%, transparent);
	}

	:global(:root.dark) .notice-page {
		--notice-ink: rgb(255 255 255 / 0.9);
		--notice-muted: rgb(255 255 255 / 0.62);
		--notice-soft: rgb(255 255 255 / 0.42);
	}

	.notice-aside {
		position: sticky;
		top: 4.75rem;
		display: grid;
		gap: 0.75rem;
	}

	.notice-hero,
	.notice-nav,
	.notice-history,
	.notice-main,
	.notice-section,
	.notice-lead,
	.feature-box,
	.tool-block,
	.tutorial-step {
		border: 1px solid color-mix(in oklab, var(--line-divider) 75%, transparent);
		background: var(--notice-panel);
		backdrop-filter: blur(18px);
		box-shadow: 0 14px 38px rgb(0 0 0 / 0.045);
	}

	.notice-hero,
	.notice-nav,
	.notice-history,
	.notice-main {
		border-radius: var(--radius-large);
	}

	.notice-hero {
		padding: 1rem;
	}

	.notice-hero-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 0.8rem;
		padding: 0.36rem 0.6rem;
		border-radius: 0.5rem;
		color: var(--primary);
		background: color-mix(in oklab, var(--primary) 13%, transparent);
		font-size: 0.76rem;
		font-weight: 850;
	}

	.notice-new-badge,
	.history-new-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 1.38rem;
		padding: 0.16rem 0.54rem;
		border-radius: 0.35rem;
		color: white;
		background: linear-gradient(135deg, #00b7ff, #007aff);
		box-shadow:
			0 0.42rem 1rem rgb(0 183 255 / 0.3),
			inset 0 1px 0 rgb(255 255 255 / 0.38);
		font-size: 0.7rem;
		font-weight: 950;
		line-height: 1;
		letter-spacing: 0;
	}

	.notice-new-badge {
		position: relative;
		margin-left: 0.12rem;
		transform: rotate(-3deg);
	}

	.notice-new-badge::after {
		content: "";
		position: absolute;
		right: -0.3rem;
		top: 50%;
		width: 0;
		height: 0;
		border-top: 0.35rem solid transparent;
		border-bottom: 0.35rem solid transparent;
		border-left: 0.35rem solid #007aff;
		transform: translateY(-50%);
	}

	.notice-new-badge[hidden] {
		display: none;
	}

	.notice-hero h1 {
		margin: 0;
		color: var(--notice-ink);
		font-size: 1.35rem;
		line-height: 1.35;
		font-weight: 900;
		letter-spacing: 0;
	}

	.notice-hero p {
		margin: 0.65rem 0 0;
		color: var(--notice-muted);
		font-size: 0.88rem;
		line-height: 1.72;
	}

	.notice-version {
		display: flex;
		justify-content: space-between;
		gap: 0.6rem;
		margin-top: 0.85rem;
		padding: 0.65rem 0.7rem;
		border-radius: 0.65rem;
		color: var(--notice-muted);
		background: color-mix(in oklab, var(--primary) 9%, transparent);
		font-size: 0.76rem;
		font-weight: 800;
	}

	.notice-version strong {
		color: var(--primary);
	}

	.notice-nav {
		padding: 0.7rem;
	}

	.notice-nav-title,
	.notice-history-title {
		display: flex;
		align-items: center;
		gap: 0.38rem;
		margin: 0 0 0.55rem;
		color: var(--notice-soft);
		font-size: 0.76rem;
		font-weight: 900;
	}

	.notice-nav a {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2rem;
		padding: 0.45rem 0.55rem;
		border-radius: 0.5rem;
		color: var(--notice-muted);
		text-decoration: none;
		font-size: 0.82rem;
		font-weight: 850;
		transition:
			background 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}

	.notice-nav a:hover {
		color: var(--primary);
		background: color-mix(in oklab, var(--primary) 12%, transparent);
		transform: translateX(0.12rem);
	}

	.notice-nav i {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 999px;
		background: var(--primary);
		flex: 0 0 auto;
	}

	.notice-history {
		padding: 0.7rem;
	}

	.history-card {
		display: grid;
		gap: 0.45rem;
	}

	.history-entry {
		position: relative;
		width: 100%;
		display: grid;
		gap: 0.25rem;
		padding: 0.78rem 0.75rem;
		border: 1px solid transparent;
		border-radius: 0.55rem;
		background: transparent;
		color: inherit;
		text-align: left;
		cursor: pointer;
		font: inherit;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.history-entry:hover,
	.history-entry.active {
		border-color: color-mix(in oklab, var(--primary) 24%, var(--line-divider));
		background: color-mix(in oklab, var(--primary) 11%, transparent);
		transform: translateX(0.1rem);
	}

	.history-entry strong {
		display: flex;
		align-items: center;
		gap: 0.38rem;
		color: var(--notice-ink);
		font-size: 0.83rem;
		line-height: 1.35;
	}

	.history-new-badge {
		position: absolute;
		top: -0.5rem;
		right: 0.45rem;
		min-height: 1.35rem;
		padding: 0.18rem 0.5rem;
		border: 2px solid color-mix(in oklab, var(--card-bg) 92%, transparent);
		border-radius: 999px;
		font-size: 0.66rem;
		transform: rotate(4deg);
	}

	.history-entry .history-new-badge {
		color: white !important;
	}

	.history-entry span {
		color: var(--notice-muted);
		font-size: 0.75rem;
		line-height: 1.48;
	}

	.notice-content {
		min-width: 0;
	}

	.notice-main {

---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import noticeHtml from "@/data/notice.html?raw";

const noticePath = "src/data/notice.html";

const articlePattern =
	/<article class="notice-main notice-view" data-notice-version="([^"]+)"(?: hidden)?>([\s\S]*?)<\/article>/g;

const noticeArticles = Array.from(noticeHtml.matchAll(articlePattern)).map(
	(match) => ({
		version: match[1],
		html: match[2].trim(),
	}),
);


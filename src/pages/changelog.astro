		brief: "BigSeller 适配、UI 重塑、爱弥斯 AI、批量小工具、单主图库教学",
		sections: {
			summary: "old-summary",
			"sheet-maker": "old-lazy-tools",
			"bulk-import": "old-lazy-tools",
			universal: "old-aimisi",
			interface: "old-summary",
			safety: "old-single-main",
			checklist: "old-checklist",
		},
		labels: {

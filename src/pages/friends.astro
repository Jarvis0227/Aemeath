    /* 背景光带与文字光带共用周期，并在周期末同时离开可视区域。 */
    .friend-recommended-sweep::before {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 2;
      width: 45%;
      content: "";
      pointer-events: none;
      background: linear-gradient(
        90deg,
        transparent 0 20%,
        rgba(239, 173, 19, 0.1) 35%,
        rgba(255, 224, 104, 0.48) 50%,
        rgba(239, 173, 19, 0.1) 65%,
        transparent 80% 100%
      );
      transform: translateX(-150%) skewX(-25deg);
    }

    .friend-recommended-sweep.is-sweep-running::before {
      animation: friend-recommended-sweep var(--friend-recommended-sweep-cycle) linear infinite;
    }

    /* 标题和徽标使用同一条白色文字高亮，扫过边界对齐 3 秒周期。 */
    [data-sweep-text] {
      position: relative;
    }

    [data-sweep-text]::after {
      position: absolute;
      inset: 0;
      overflow: hidden;
      content: attr(data-sweep-text);
      pointer-events: none;
      color: #fff;
      text-shadow: none;
      -webkit-text-stroke: 0.3px rgba(132, 78, 5, 0.55);
      paint-order: stroke fill;
      opacity: 0;
      mask-image: linear-gradient(
        115deg,
        transparent 42%,
        rgba(255, 255, 255, 0.5) 46%,
        #fff 48% 52%,
        rgba(255, 255, 255, 0.5) 54%,
        transparent 58%
      );
      mask-size: 238% 100%;
      mask-repeat: no-repeat;
    }

    .friend-card--recommended.is-sweep-running [data-sweep-text]::after {
      opacity: 0.9;
      animation: friend-recommended-text-sweep var(--friend-recommended-sweep-cycle) linear infinite;
    }

    .friend-card--recommended.is-sweep-running .friend-recommended-badge [data-sweep-text]::after {
      opacity: 0.85;
    }

    @keyframes friend-recommended-text-sweep {
      from {
        mask-position: 100% 0;
      }
      to {
        mask-position: 0% 0;
      }
    }

    @keyframes friend-recommended-sweep {
      from {
        transform: translateX(-80%) skewX(-25deg);
      }
      to {
        transform: translateX(205%) skewX(-25deg);
      }

---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import FriendAvatarMarquee from "@components/friends/FriendAvatarMarquee.astro";
import FriendRecommendationGuide from "@components/friends/FriendRecommendationGuide.astro";
import FriendsMagicLink from "@components/friends/FriendsMagicLink.astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	friendsPageConfig,
	friendsProjects,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import friendAvatarColors from "@/constants/friend-avatar-colors.json";
import friendsLatencySnapshot from "@/data/friends-latency-snapshot.json";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import type { FriendLatencySnapshot } from "@/types/friendLatency";
import { getFriendLatencyDisplay } from "@/utils/friend-latency";
import { loadFriendsFeed } from "@/utils/friends-feed";
import { formatRemediationCountdown, remediationSeconds } from "@/utils/friend-remediation";
import "@/styles/friends-magic-link.css";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

// 使用配置文件中的友链数据，按权重排序
const items = getEnabledFriends();
const projects = friendsProjects.filter((item) => item.enabled);
const avatarColors = friendAvatarColors.colors as Record<string, { hue: number; saturation: number }>;
const avatarTagStyle = (source: string) => {
	const color = avatarColors[source];
	return color ? `--friend-avatar-hue: ${color.hue}; --friend-avatar-saturation: ${color.saturation}%;` : undefined;
};
// 控制推荐卡片扫光、Canvas 流动星星和标题循环发光。
const recommendedSweepEnabled = true;
const recommendedStarsEnabled = true;
const recommendedTitleGlowEnabled = false;
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();
const normalizeFriendUrl = (url: string) =>
	url
		.trim()
		.replace(/^https?:\/\//i, "")
		.replace(/^www\./i, "")
		.replace(/\/+$/, "")
		.toLowerCase();
const ownSiteUrl = normalizeFriendUrl(siteConfig.site_url);
const recommendedFriends = items.filter(
	(item) => item.recommended === true && normalizeFriendUrl(item.siteurl) !== ownSiteUrl,
);
const feed = await loadFriendsFeed(items, { cachedOnly: import.meta.env.DEV });
const rssUpdates = new Map<string, { date: Date; title: string; stale: boolean }>();
const staleFeeds = new Set(feed.sources.filter(source => source.stale).map(source => normalizeFriendUrl(source.friendUrl)));
for (const entry of feed.items) {
	if (!entry.publishedAt) continue;
	const key = normalizeFriendUrl(entry.friendUrl);
	const previous = rssUpdates.get(key);
	if (!previous || entry.publishedAt > previous.date) {
		rssUpdates.set(key, { date: entry.publishedAt, title: entry.title, stale: staleFeeds.has(key) });
	}
}
const rssDateLabel = (date: Date) => date.toLocaleDateString("sv-SE", { timeZone: "Asia/Shanghai" });
// 页面标题和描述
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
---

<MainGridLayout
	 title={title}
	description={description}
>
  <div
    id="friends-page"
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
      <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="friends-heading-row mb-4">
        <div class="friends-heading-copy">
          <div class="flex flex-wrap items-center gap-3 mb-3">
            <div
              class="h-8 w-8 shrink-0 flex items-center justify-center text-neutral-900 dark:text-neutral-100"
            >
              <Icon is:inline name="material-symbols:group" class="text-[1.5rem]" />
            </div>
            <h1 class="friends-title shrink-0 whitespace-nowrap text-3xl font-bold text-neutral-900 dark:text-neutral-100">
              {title}
            </h1>
            <span class="friends-count" aria-label={`当前共收录 ${items.length} 个友链`}>
              <strong>{items.length}</strong>
              <span>个</span>
            </span>
          </div>
          {
            description && (
              <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-0">
                {description}
              </p>
            )
          }
        </div>

        <div class="friends-heading-actions">
          <FriendRecommendationGuide friends={recommendedFriends} />
          <a
            href="#post-comments"
            class="friends-apply-button"
            data-friends-application
            aria-label="申请友链，前往评论区提交申请"
          >
            <Icon is:inline name="material-symbols:link-rounded" aria-hidden="true" />
            <span>申请友链</span>
          </a>
          <FriendsMagicLink />
        </div>
      </div>

      {items.length > 0 && <FriendAvatarMarquee friends={items} ownSiteUrl={ownSiteUrl} />}

      <!-- 搜索框 -->
      {
        items.length > 0 && (
          <friend-filter class="mb-6">
            <div class="relative mb-3">
              <Icon is:inline
                name="material-symbols:search"
                class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 dark:text-neutral-400 text-lg pointer-events-none"
              />
              <input
                type="text"
                data-search
                placeholder={i18n(I18nKey.searchFriends) || "搜索友链..."}
                class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-400 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm"
              />
            </div>
            <div class="friend-filter-tags-shell" data-tags-shell>
              <div
                class="friend-filter-tags-viewport"
                data-tags-viewport
              >
                <div
                  id="friend-tags-list"
                  class="friend-filter-tags"
                  data-tags-list
                  aria-label="友链标签"
                >
                  <button
                    type="button"
                    data-tag="all"
                    aria-pressed="true"
                    class="friend-filter-tag is-active"
                  >
                    {i18n(I18nKey.all)}
                  </button>
                  {allTags.map((tag) => (
                    <button
                      type="button"
                      data-tag={tag}
                      aria-pressed="false"
                      class="friend-filter-tag"
                    >
                      {tag}
                    </button>
                  ))}
                </div>
              </div>
              <button
                type="button"
                data-tags-toggle
                data-expanded="false"
                aria-controls="friend-tags-list"
                aria-expanded="false"
                class="friend-filter-tags-toggle hidden"
              >
                <span data-tags-toggle-label>展开标签</span>
                <Icon is:inline name="material-symbols:expand-more-rounded" class="transition-transform duration-200" />
              </button>
            </div>
          </friend-filter>
        )
      }

      <div class="friends-grid my-4">
        {
          items.length === 0 && (
            <div class="col-span-full flex flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-400">
              <Icon is:inline name="material-symbols:group-off-outline" class="text-4xl mb-3" />
              <div class="text-sm">{i18n(I18nKey.friendsEmpty)}</div>
            </div>
          )
        }
        {
		items.map((item) => {
			const isOwnSite = normalizeFriendUrl(item.siteurl) === ownSiteUrl;
			const latency = getFriendLatencyDisplay(friendsLatencySnapshot as FriendLatencySnapshot, item.siteurl);
			const rssUpdate = rssUpdates.get(normalizeFriendUrl(item.siteurl));
			const rssDate = rssUpdate ? rssDateLabel(rssUpdate.date) : null;
			const rssLabel = rssUpdate
				? `${rssUpdate.stale ? "RSS 缓存" : "RSS"} 最近文章时间：${rssDate}，${rssUpdate.title}`
				: `${item.title}，RSS 暂无有效更新日期`;
			const isRecommended = !isOwnSite && item.recommended === true;
			const isDegradedRecommended = isRecommended && item.recommendedTier === "degraded";
			const visibilityStatus = item.visibilityStatus || (item.temporarilyUnavailable ? "temporarily_unavailable" : "normal");
			const isTemporarilyUnavailable = visibilityStatus === "temporarily_unavailable";
			const isPolicyViolation = visibilityStatus === "policy_violation";
			const violationStartedAt = Number.isSafeInteger(item.violationStartedAt) && (item.violationStartedAt || 0) > 0 ? item.violationStartedAt || 0 : 0;
			const unavailableStartedAt = Number.isSafeInteger(item.unavailableStartedAt) && (item.unavailableStartedAt || 0) > 0 ? item.unavailableStartedAt || 0 : 0;
			const remediationStartedAt = isTemporarilyUnavailable ? unavailableStartedAt : violationStartedAt;
			const remediationDeadline = remediationStartedAt ? remediationStartedAt + remediationSeconds(visibilityStatus) : 0;
			return (
              <a
                href={isTemporarilyUnavailable || isPolicyViolation ? undefined : item.siteurl}
                data-friend-site-url={item.siteurl}
                data-friend-unavailable={String(isTemporarilyUnavailable)}
                data-friend-visibility-status={visibilityStatus}
                data-friend-violation-started-at={violationStartedAt || undefined}
                data-friend-unavailable-started-at={unavailableStartedAt || undefined}
                data-friend-title={item.title}
                data-friend-recommended={String(isRecommended)}
                data-friend-own-site={String(isOwnSite)}
                data-friend-original-tabindex=""
                target="_blank"
                rel="noopener noreferrer"
                aria-disabled={isTemporarilyUnavailable || isPolicyViolation ? "true" : undefined}
                tabindex={isTemporarilyUnavailable || isPolicyViolation ? -1 : undefined}
                aria-label={
                  isTemporarilyUnavailable
                    ? `${item.title}，短暂失联，${formatRemediationCountdown(remediationStartedAt, visibilityStatus)}`
                    : isPolicyViolation
                    ? `${item.title}，违规友链，${formatRemediationCountdown(remediationStartedAt, visibilityStatus)}`
                    : isRecommended
                    ? `${item.title}，推荐友链`
                    : isOwnSite
                      ? `${item.title}，本站`
                      : item.title
                }
                data-tags={item.tags?.join(",")}
                style={avatarTagStyle(item.imgurl)}
                data-umami-event={isOwnSite ? undefined : "friend-link-click"}
                data-umami-event-site={isOwnSite ? undefined : item.siteurl}
                class:list={[
                  "friend-card friend-list-card group flex items-center gap-3 p-2.5 rounded-xl relative overflow-visible",
                  isOwnSite && "friend-card--own",
                  isRecommended && "friend-card--recommended",
                  isRecommended && !recommendedTitleGlowEnabled && "friend-card--recommended-no-title-glow",
                  isDegradedRecommended && "friend-card--recommended-degraded",
                  isTemporarilyUnavailable && "friend-card--temporarily-unavailable",
                  isPolicyViolation && "friend-card--policy-violation",
                ]}
              >
              {/* 背景容器继续负责屏幕外暂停观察；上层光带单独绘制。 */}
              <div class:list={[
                "friend-card-surface absolute inset-0 rounded-xl overflow-hidden pointer-events-none",
                isRecommended && !isDegradedRecommended && recommendedSweepEnabled && "friend-recommended-sweep",
              ]}>
                <img
                  class="friend-card-avatar-backdrop"
                  src={item.imgurl}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-(--primary) opacity-0 group-hover:opacity-5 transition-opacity duration-300" />
                {
                  isRecommended && !isDegradedRecommended && recommendedStarsEnabled && (
                    <recommended-star-flow class="friend-recommended-flow" aria-hidden="true">
                      <canvas class="friend-recommended-canvas"></canvas>
                    </recommended-star-flow>
                  )
                }
              </div>

              {/* 头像 */}
              <div class="friend-card-avatar relative z-10 w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform duration-300">
                <img
                  src={item.imgurl}
                  alt={item.title}
                  data-friend-avatar
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
              </div>

              {/* 内容 */}
              <div class="friend-card-content relative z-10 grow min-w-0 flex flex-col justify-center gap-0.5">
                <div class="friend-card-heading flex items-center justify-between gap-2 min-w-0">
                  <div
                    data-sweep-text={isRecommended && !isDegradedRecommended && recommendedSweepEnabled ? item.title : undefined}
                    class:list={[
                      "friend-card-title font-bold text-base text-neutral-900 dark:text-neutral-100 transition-colors truncate",
                      isRecommended && "friend-card-title--recommended",
                    ]}
                  >
                    {item.title}
                  </div>
                    <span class:list={["friend-latency", `friend-latency--${latency.state}`]} title={latency.label} aria-label={latency.label}>
                      <span class="friend-latency-dot" aria-hidden="true"></span>
                      {latency.value.endsWith("ms") ? (
                        <><span>{latency.value.slice(0, -2)}</span><span class="friend-click-count-unit" aria-hidden="true">ms</span></>
                      ) : <span>{latency.value}</span>}
                    </span>
                </div>

                <div
                  class="friend-card-description text-sm line-clamp-1"
                  title={item.desc}
                  data-friend-description-title={item.desc}
                  hidden={isPolicyViolation}
                >
                  {item.desc}
                </div>

                {/* 标签 */}
				<div class="friend-card-tags flex flex-wrap items-center gap-1 mt-1">
					{item.tags && item.tags.length > 0
                    ? item.tags
                        .slice(0, isOwnSite ? 4 : 3)
                        .map((tag) => (
                          <span class="friend-card-tag text-[0.65rem] font-medium px-1.5 py-0.5 rounded transition-colors duration-300">
                            {tag}
                          </span>
                        ))
                    : null}
                </div>
              </div>

              <div class="friend-card-footer">
                <div class="friend-card-footer__identity">
                  {(isRecommended || isOwnSite) && (
                    <span class:list={["friend-recommended-badge", isOwnSite && "friend-site-owner-badge"]} aria-hidden="true">
                      <svg class:list={[isOwnSite ? "friend-owner-icon" : "friend-recommended-icon"]} viewBox="0 0 24 24" role="presentation">
                        {isOwnSite ? (
                          <path d="m4.7 10.4 7.3-5.6 7.3 5.6v7.3c0 .83-.67 1.5-1.5 1.5H6.2c-.83 0-1.5-1.5-1.5-1.5v-7.3Zm3.1 1.1v6.2h2.8v-3.3h2.8v3.3h2.8v-6.2L12 8.6l-4.2 2.9Z" />
                        ) : (
                          <path d="M12 3.1c.7 0 1.32.42 1.6 1.06l1.41 3.32c.18.43.58.73 1.04.77l3.59.32c.7.06 1.29.54 1.49 1.22.2.67-.03 1.4-.59 1.82l-2.73 2.08c-.37.28-.53.76-.4 1.2l.84 3.49c.17.69-.09 1.41-.68 1.79-.58.39-1.35.39-1.94 0l-3.02-1.96a1.37 1.37 0 0 0-1.5 0l-3.02 1.96c-.59.39-1.36.39-1.94 0-.59-.38-.85-1.1-.68-1.79l.84-3.49c.13-.44-.03-.92-.4-1.2l-2.73-2.08c-.56-.42-.79-1.15-.59-1.82.2-.68.79-1.16 1.49-1.22l3.59-.32c.46-.04.86-.34 1.04-.77l1.41-3.32A1.73 1.73 0 0 1 12 3.1Z" />
                        )}
                      </svg>
                      <span data-sweep-text={isRecommended && !isDegradedRecommended && recommendedSweepEnabled ? "推荐友链" : undefined}>{isOwnSite ? "本站主理人" : "推荐友链"}</span>
                    </span>
                  )}
                  {rssUpdate ? (
                    <time class="friend-rss-updated" datetime={rssUpdate.date.toISOString()} title={rssLabel} aria-label={rssLabel}>
                      最近更新于 {rssDate}
                    </time>
                  ) : (
                    <span class="friend-rss-updated" title={rssLabel}>RSS 暂无</span>
                  )}
                </div>
                <div class="friend-card-footer__metrics">
                <span
                  class="friend-click-count"
                  data-friend-clicks-for={isOwnSite ? undefined : item.siteurl}
                  title={isOwnSite ? "本站总访问次数" : "从本站点击次数"}
                  aria-label={isOwnSite ? "本站总访问次数" : `${item.title}，从本站点击次数`}
                >
                  <Icon is:inline name="material-symbols:ads-click-rounded" aria-hidden="true" />
                  <span data-friend-clicks-value={isOwnSite ? undefined : true} data-friend-site-pageviews={isOwnSite ? true : undefined} aria-live="polite">…</span>
                  <span class="friend-click-count-unit" aria-hidden="true">次</span>
                </span>

                </div>
              </div>

              {
                <div class="friend-card-status-overlay" hidden={!isTemporarilyUnavailable && !isPolicyViolation} aria-hidden="true">
                  <div class="friend-card-remediation-overlay" hidden={!isTemporarilyUnavailable && !isPolicyViolation}>
                    <span class="friend-card-remediation-title" title={item.title}>{item.title}</span>
                    <div class="friend-card-status-badge" hidden={!isTemporarilyUnavailable}><Icon is:inline name="material-symbols:cloud-off-rounded" aria-hidden="true" /><span>短暂失联</span></div>
                    <span class="friend-card-policy-label" hidden={!isPolicyViolation}><Icon is:inline name="material-symbols:warning-rounded" aria-hidden="true" />违规友链</span>
                    <time class="friend-card-remediation-countdown" datetime={remediationDeadline ? new Date(remediationDeadline * 1000).toISOString() : undefined} data-friend-remediation-countdown aria-live="off">
                      {formatRemediationCountdown(remediationStartedAt, visibilityStatus)}
                    </time>
                  </div>
                </div>
              }

              {item.screenshot && (
                <figure class="friend-site-preview" aria-hidden="true">
                  <img
                    src={item.screenshot}
                    alt=""
                    width="1200"
                    height="675"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              )}
              </a>
            );
          })
        }
      </div>

      {/* 搜索无结果提示 */}
      <div class="friends-empty hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-400">
        <Icon is:inline name="material-symbols:search-off-rounded" class="text-4xl mb-3" />
        <div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
      </div>

      {projects.length > 0 && (
        <section class="friends-projects" aria-labelledby="friends-projects-title">
          <div class="friends-projects-heading">
            <div class="friends-projects-heading-icon">
              <Icon is:inline name="material-symbols:rocket-launch-rounded" class="text-[1.2rem]" />
            </div>
            <div>
              <h2 id="friends-projects-title">加入的项目</h2>
              <p>这里收录了我加入的博客社区与交流项目。</p>
            </div>
          </div>

          <div class="friends-grid friends-projects-grid">
            {projects.map((item) => (
              (() => {
                const visibilityStatus = item.visibilityStatus || (item.temporarilyUnavailable ? "temporarily_unavailable" : "normal");
                const isTemporarilyUnavailable = visibilityStatus === "temporarily_unavailable";
                const isPolicyViolation = visibilityStatus === "policy_violation";
                const violationStartedAt = Number.isSafeInteger(item.violationStartedAt) && (item.violationStartedAt || 0) > 0 ? item.violationStartedAt || 0 : 0;
                const unavailableStartedAt = Number.isSafeInteger(item.unavailableStartedAt) && (item.unavailableStartedAt || 0) > 0 ? item.unavailableStartedAt || 0 : 0;
			const remediationStartedAt = isTemporarilyUnavailable ? unavailableStartedAt : violationStartedAt;
			const remediationDeadline = remediationStartedAt ? remediationStartedAt + remediationSeconds(visibilityStatus) : 0;
                return (
              <a
                href={isTemporarilyUnavailable || isPolicyViolation ? undefined : item.siteurl}
                data-friend-site-url={item.siteurl}
                data-friend-unavailable={String(isTemporarilyUnavailable)}
                data-friend-visibility-status={visibilityStatus}
                data-friend-violation-started-at={violationStartedAt || undefined}
                data-friend-unavailable-started-at={unavailableStartedAt || undefined}
                data-friend-title={item.title}
                data-friend-original-tabindex=""
                target="_blank"
                rel="noopener noreferrer"
                aria-label={isTemporarilyUnavailable ? `${item.title}，短暂失联，${formatRemediationCountdown(remediationStartedAt, visibilityStatus)}` : isPolicyViolation ? `${item.title}，违规友链，${formatRemediationCountdown(remediationStartedAt, visibilityStatus)}` : `${item.title}，加入的项目`}
                aria-disabled={isTemporarilyUnavailable || isPolicyViolation ? "true" : undefined}
                tabindex={isTemporarilyUnavailable || isPolicyViolation ? -1 : undefined}
                style={avatarTagStyle(item.imgurl)}
                class:list={["friend-card group flex items-center gap-3 p-2.5 rounded-xl relative overflow-visible", isTemporarilyUnavailable && "friend-card--temporarily-unavailable", isPolicyViolation && "friend-card--policy-violation"]}
              >
                <div class="friend-card-surface absolute inset-0 rounded-xl overflow-hidden pointer-events-none">
                  <div class="absolute inset-0 bg-(--primary) opacity-0 group-hover:opacity-5 transition-opacity duration-300" />
                </div>

                <div class="friend-card-status-overlay" hidden={!isTemporarilyUnavailable && !isPolicyViolation} aria-hidden="true">
                  <div class="friend-card-remediation-overlay" hidden={!isTemporarilyUnavailable && !isPolicyViolation}>
                    <span class="friend-card-remediation-title" title={item.title}>{item.title}</span>
                    <div class="friend-card-status-badge" hidden={!isTemporarilyUnavailable}><Icon is:inline name="material-symbols:cloud-off-rounded" aria-hidden="true" /><span>短暂失联</span></div>
                    <span class="friend-card-policy-label" hidden={!isPolicyViolation}><Icon is:inline name="material-symbols:warning-rounded" aria-hidden="true" />违规友链</span>
                    <time class="friend-card-remediation-countdown" datetime={remediationDeadline ? new Date(remediationDeadline * 1000).toISOString() : undefined} data-friend-remediation-countdown aria-live="off">
                      {formatRemediationCountdown(remediationStartedAt, visibilityStatus)}
                    </time>
                  </div>
                </div>

                <div class="friend-card-avatar relative z-10 w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform duration-300">
                  <img
                    src={item.imgurl}
                    alt={item.title}
                    data-friend-avatar
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover"
                  />
                </div>

                <div class="friend-card-content relative z-10 grow min-w-0 flex flex-col justify-center gap-0.5">
                  <div class="flex items-center justify-between">
                    <div class="friend-card-title font-bold text-base text-neutral-900 dark:text-neutral-100 transition-colors truncate">
                      {item.title}
                    </div>
                  </div>
                  <div class="friend-card-description text-sm line-clamp-1" title={item.desc}>
                    {item.desc}
                  </div>
                  <div class="flex flex-wrap items-center gap-1 mt-1">
                    {item.tags?.slice(0, 3).map((tag) => (
                      <span class="friend-card-tag text-[0.65rem] font-medium px-1.5 py-0.5 rounded transition-colors duration-300">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>

                {item.screenshot && (

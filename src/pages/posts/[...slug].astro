    gap: 0.8rem;
    padding: 0.9rem 0 0.7rem;
    border-top: 2px solid var(--chapter-accent);
    border-bottom: 1px solid var(--chapter-rule);
    color: var(--monthly-ink);
    font-variant-numeric: tabular-nums;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(1) > h2::after {
    align-self: center;
    width: 100%;
    height: 0.65rem;
    content: "";
    background:
      linear-gradient(90deg, var(--chapter-accent) 0 0.35rem, transparent 0.35rem 0.62rem) 0 50% / 0.62rem 1px repeat-x,
      linear-gradient(90deg, transparent 0 0.1rem, var(--chapter-rule) 0.1rem calc(100% - 0.1rem), transparent calc(100% - 0.1rem)) 0 50% / 100% 1px no-repeat;
    opacity: 0.75;
  }

  /* Updates: a handwritten-looking highlight band, kept geometric and crisp. */
  #swup-container .monthly-post-layout > section:nth-of-type(2) > h2 {
    display: inline-block;
    width: fit-content;
    max-width: 100%;

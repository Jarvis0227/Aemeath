  #swup-container .monthly-post-layout > section:nth-of-type(2) > h2::after {
    position: absolute;
    right: -0.4rem;
    bottom: 0.18rem;
    left: -0.12rem;
    z-index: -1;
    height: 0.34em;
    content: "";
    background: color-mix(in srgb, var(--chapter-accent) 20%, transparent);
    clip-path: polygon(0 24%, 18% 8%, 39% 25%, 62% 2%, 100% 17%, 97% 86%, 70% 72%, 46% 92%, 20% 73%, 2% 91%);
    transform: rotate(-1.2deg);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(2) > h2 > .anchor {
    margin-left: 0.2rem;
  }

  /* Automation keeps the user's five-colour flowing title, but gives it a
   * distinctive terminal-like rail so it reads as a technical chapter. */
  #swup-container .monthly-post-layout > section:nth-of-type(3) > h2 {
    position: relative;
    overflow: visible;
    padding-left: 1.2rem;
    border-block: 1px solid var(--chapter-rule);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(3) > h2::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.34rem;
    height: 0.34rem;
    content: "";
    border-radius: 999px;
    background: var(--chapter-accent);
    box-shadow:
      0 -0.58rem 0 -0.03rem color-mix(in srgb, var(--chapter-accent) 72%, transparent),
      0 0.58rem 0 -0.03rem color-mix(in srgb, var(--chapter-accent) 72%, transparent);

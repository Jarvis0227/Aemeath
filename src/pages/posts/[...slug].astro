    z-index: 1;
  }

  #swup-container .monthly-post-layout > section > h2 > .anchor {
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
  }

  /* 01 — report page: the title rests against a small ruler; its three
   * readout lights wake up in sequence. */
  #swup-container .monthly-post-layout > section:nth-of-type(1) > h2 {
    display: grid;
    grid-template-columns: auto minmax(2.2rem, 1fr) auto auto;
    align-items: center;
    gap: 0.62rem;
    margin-bottom: 1.1rem;
    padding: 0.5rem 0 0.42rem;
    border: 0;
    color: var(--monthly-ink);
    font-size: clamp(1.65rem, 3.6vw, 2.25rem);
    font-variant-numeric: tabular-nums;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(1) > h2 > .monthly-chapter-title__label {
    grid-column: 1;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(1) > h2 > .monthly-title-dots {
    display: inline-flex;
    grid-column: 3;
    align-items: center;
    gap: 0.32rem;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(1) > h2 > .anchor {
    grid-column: 4;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(1) > h2::before {
    content: none;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(1) > h2::after {
    display: block;
    grid-column: 2;
    align-self: center;
    width: 100%;
    height: 0.56rem;
    content: "";
    background:
      repeating-linear-gradient(90deg, var(--chapter-accent) 0 1px, transparent 1px 0.55rem) 0 0 / auto 0.22rem no-repeat,
      linear-gradient(90deg, var(--chapter-rule), color-mix(in srgb, var(--chapter-rule) 18%, transparent)) 0 50% / 100% 1px no-repeat,
      repeating-linear-gradient(90deg, var(--chapter-rule) 0 1px, transparent 1px 0.55rem) 0 100% / auto 0.16rem no-repeat;
    opacity: 0.92;
  }

  #swup-container .monthly-post-layout .monthly-title-dot {
    display: block;
    width: 0.38rem;
    height: 0.38rem;
    border: 1px solid color-mix(in srgb, var(--chapter-accent) 52%, var(--line-divider));
    border-radius: 50%;
    background: var(--card-bg);
    box-shadow: inset 0 0 0 0.08rem color-mix(in srgb, var(--chapter-accent) 7%, transparent);
    opacity: 0.5;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(1) > h2.monthly-scroll-reveal--visible .monthly-title-dot {
    animation: monthly-title-readout 1.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(1) > h2.monthly-scroll-reveal--visible .monthly-title-dot:nth-child(2) {
    animation-delay: 130ms;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(1) > h2.monthly-scroll-reveal--visible .monthly-title-dot:nth-child(3) {
    animation-delay: 260ms;
  }

  @keyframes monthly-title-readout {
    0%, 20% {
      background: var(--card-bg);
      box-shadow: inset 0 0 0 0.08rem color-mix(in srgb, var(--chapter-accent) 7%, transparent);
      opacity: 0.48;
      transform: scale(0.82);
    }

    42% {
      background: var(--chapter-accent);
      box-shadow: 0 0 0.52rem color-mix(in srgb, var(--chapter-accent) 56%, transparent);
      opacity: 1;
      transform: scale(1.18);
    }

    100% {
      background: color-mix(in srgb, var(--chapter-accent) 72%, var(--card-bg));
      box-shadow: 0 0 0.3rem color-mix(in srgb, var(--chapter-accent) 36%, transparent);
      opacity: 0.88;
      transform: scale(1);
    }
  }

  /* 02 — handwritten annotation: the blue marker is written in only after
   * this heading arrives in view. */
  #swup-container .monthly-post-layout > section:nth-of-type(2) > h2 {
    display: inline-flex;
    align-items: baseline;
    width: fit-content;
    max-width: 100%;
    margin-bottom: 1.45rem;
    padding: 0.12rem 0.3rem 0.35rem 0.08rem;
    border: 0;
    color: var(--monthly-ink);
    font-size: clamp(2rem, 5vw, 3.1rem);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(2) > h2::before {
    content: none;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(2) > h2::after {
    position: absolute;
    right: -0.32rem;
    bottom: 0.18rem;
    left: -0.12rem;
    z-index: -1;
    height: 0.34em;
    content: "";
    background: color-mix(in srgb, var(--chapter-accent) 22%, transparent);
    clip-path: polygon(0 25%, 16% 8%, 39% 24%, 63% 3%, 100% 17%, 97% 86%, 69% 72%, 46% 93%, 20% 73%, 2% 91%);
    opacity: 0.88;
    transform: rotate(-1.2deg) scaleX(0.035);
    transform-origin: left center;
    transition: transform 720ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(2) > h2.monthly-scroll-reveal--visible::after {
    transform: rotate(-1.2deg) scaleX(1);
  }

  /* 03 — automation: five-colour type stays, while two task routes connect
   * from the margins toward the heading instead of a decorative divider. */
  #swup-container .monthly-post-layout > section:nth-of-type(3) > h2 {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.42rem;
    padding: 0.28rem 0 0.82rem;
    border: 0;
    overflow: visible;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(3) > h2 > .monthly-chapter-title__label {
    background: var(--automation-title-gradient);
    background-position: 0% 50%;
    background-size: 200% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: monthly-automation-title-flow 6s linear infinite;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(3) > h2::before,
  #swup-container .monthly-post-layout > section:nth-of-type(3) > h2::after {
    position: absolute;
    bottom: 0.15rem;
    width: calc(50% - 0.74rem);
    height: 0.58rem;
    content: "";
    background: linear-gradient(90deg, transparent, var(--chapter-accent) 16%, var(--chapter-accent) 84%, transparent);
    opacity: 0.8;
    transform: scaleX(0.04);
    transition: transform 760ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(3) > h2::before {
    left: 0;
    clip-path: polygon(0 44%, 82% 44%, 100% 50%, 82% 56%, 0 56%);
    transform-origin: left center;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(3) > h2::after {
    right: 0;
    clip-path: polygon(0 50%, 18% 44%, 100% 44%, 100% 56%, 18% 56%);
    transform-origin: right center;
    transition-delay: 90ms;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(3) > h2.monthly-scroll-reveal--visible::before,
  #swup-container .monthly-post-layout > section:nth-of-type(3) > h2.monthly-scroll-reveal--visible::after {
    transform: scaleX(1);
  }

  /* 04 — a withdrawal, not an alarm: the last word is briefly crossed out,
   * then allowed to settle back into the line. */
  #swup-container .monthly-post-layout > section:nth-of-type(4) > h2 {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 0.28rem;
    margin-top: clamp(4.5rem, 9vw, 6.8rem);
    padding: 0;
    border: 0;
    color: color-mix(in srgb, var(--monthly-ink) 84%, var(--chapter-accent));
    font-size: clamp(1.85rem, 4.2vw, 2.6rem);
    text-align: center;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(4) > h2::before,
  #swup-container .monthly-post-layout > section:nth-of-type(4) > h2::after {
    content: none;
  }

  #swup-container .monthly-post-layout .monthly-title-stop__returned {
    position: relative;
    display: inline-block;
    opacity: 0.56;
    transform: translateY(0.035em);
    transition: opacity 440ms ease, transform 440ms ease;
  }

  #swup-container .monthly-post-layout .monthly-title-stop__returned::after {
    position: absolute;
    top: 53%;
    right: -0.04em;
    left: -0.04em;
    height: 1px;
    content: "";
    background: color-mix(in srgb, var(--chapter-accent) 65%, var(--monthly-muted));
    opacity: 0;
    transform: rotate(-3deg) scaleX(0.06);
    transform-origin: left center;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(4) > h2.monthly-scroll-reveal--visible .monthly-title-stop__returned {
    opacity: 1;
    transform: translateY(0);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(4) > h2.monthly-scroll-reveal--visible .monthly-title-stop__returned::after {
    animation: monthly-stop-release 1.55s cubic-bezier(0.22, 1, 0.36, 1) both 140ms;
  }

  @keyframes monthly-stop-release {
    0% { opacity: 0; transform: rotate(-3deg) scaleX(0.06); }
    34% { opacity: 0.78; transform: rotate(-3deg) scaleX(1); }
    100% { opacity: 0; transform: rotate(-3deg) scaleX(1); }
  }

  /* 05 — add / delete: only the two verbs pull in opposite directions, then
   * return to a calm line when the chapter reaches the reader. */
  #swup-container .monthly-post-layout > section:nth-of-type(5) > h2 {
    display: block;
    margin-bottom: 1.48rem;
    padding: 0.45rem 0 0.7rem;
    border: 0;
    color: var(--monthly-ink);
    font-size: clamp(1.85rem, 4.7vw, 2.85rem);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(5) > h2::before,
  #swup-container .monthly-post-layout > section:nth-of-type(5) > h2::after {
    content: none;
  }

  #swup-container .monthly-post-layout .monthly-title-pull {
    position: relative;
    display: inline-block;
    font-weight: 800;
    transition: transform 780ms cubic-bezier(0.16, 1, 0.3, 1), color 560ms ease;
  }

  #swup-container .monthly-post-layout .monthly-title-pull--add {
    color: color-mix(in srgb, var(--chapter-accent) 74%, var(--monthly-ink));
    transform: translateX(0.34em);
  }

  #swup-container .monthly-post-layout .monthly-title-pull--remove {
    color: color-mix(in srgb, var(--chapter-secondary-source) 76%, var(--monthly-ink));
    transform: translateX(-0.34em);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(5) > h2.monthly-scroll-reveal--visible .monthly-title-pull {
    transform: translateX(0);
  }

  /* 06 — warm photo page: an unframed title sits in a soft pool of light,
   * with a few nearly-there dust motes underneath. */
  #swup-container .monthly-post-layout > section:nth-of-type(6) > h2 {
    display: flex;
    justify-content: center;
    align-items: center;
    width: fit-content;
    margin-inline: auto;
    padding: 0.42rem 0.95rem 0.86rem;
    border: 0;
    color: color-mix(in srgb, var(--monthly-ink) 84%, var(--chapter-accent));
    font-size: clamp(2.1rem, 5.2vw, 3.1rem);
    text-align: center;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(6) > h2::before {
    position: absolute;
    right: -0.8rem;
    bottom: 0.24rem;
    left: -0.8rem;
    z-index: -1;
    height: 1.65em;
    content: "";
    background: radial-gradient(ellipse at 50% 62%, color-mix(in srgb, var(--chapter-accent) 23%, transparent), transparent 68%);
    filter: blur(0.08rem);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(6) > h2::after {
    position: absolute;
    bottom: -0.06rem;
    left: 49%;
    z-index: -1;
    width: 0.25rem;
    height: 0.25rem;
    content: "";
    border-radius: 50%;
    background: color-mix(in srgb, var(--chapter-accent) 36%, transparent);
    box-shadow:
      -2.15rem 0.22rem 0 -0.03rem color-mix(in srgb, var(--chapter-accent) 29%, transparent),
      1.9rem -0.1rem 0 0.02rem color-mix(in srgb, var(--chapter-accent) 22%, transparent),
      3.15rem 0.3rem 0 -0.06rem color-mix(in srgb, var(--chapter-accent) 25%, transparent);
    animation: monthly-life-motes 5.8s ease-in-out infinite alternate;
  }

  @keyframes monthly-life-motes {
    from { opacity: 0.36; transform: translateY(0); }
    to { opacity: 0.78; transform: translateY(-0.12rem); }
  }

  /* 07 — friends: a slim gold bookmark slides out from the left and hands
   * off to a quiet rule, so the cards below still do the talking. */
  #swup-container .monthly-post-layout > section:nth-of-type(7) > h2 {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0 0.62rem 1rem;
    border: 0;
    color: color-mix(in srgb, var(--monthly-ink) 78%, var(--chapter-accent));
    font-size: clamp(1.9rem, 4.5vw, 2.75rem);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(7) > h2::before {
    position: absolute;
    top: 0.08rem;
    bottom: 0.12rem;
    left: 0;
    z-index: -1;
    width: 1.12rem;
    content: "";
    background: linear-gradient(180deg, color-mix(in srgb, var(--chapter-accent) 86%, #ffd968), var(--chapter-accent));
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 81%, 0 100%);
    box-shadow: 0 0.18rem 0.46rem color-mix(in srgb, var(--chapter-accent) 26%, transparent);
    transform: translateX(-0.78rem);
    transition: transform 720ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(7) > h2::after {
    display: block;
    flex: 1 1 3rem;
    height: 1px;
    min-width: 2rem;
    content: "";
    background: linear-gradient(90deg, var(--chapter-accent), transparent);
    opacity: 0.72;
    transform: scaleX(0.12);
    transform-origin: left center;
    transition: transform 820ms cubic-bezier(0.16, 1, 0.3, 1) 110ms;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(7) > h2.monthly-scroll-reveal--visible::before {
    transform: translateX(0);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(7) > h2.monthly-scroll-reveal--visible::after {
    transform: scaleX(1);
  }

  /* 08 — editorial ruler: just a few unequal proofing ticks at the margin.
   * There is deliberately no block or badge here. */
  #swup-container .monthly-post-layout > section:nth-of-type(8) > h2 {
    display: inline-flex;
    align-items: center;
    gap: 0.72rem;
    margin-bottom: 1.15rem;
    padding: 0.3rem 0;
    border: 0;
    color: color-mix(in srgb, var(--monthly-ink) 82%, var(--chapter-accent));
    font-size: clamp(1.5rem, 3.3vw, 2rem);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(8) > h2::before {
    display: block;
    flex: 0 0 0.7rem;
    width: 0.7rem;
    height: 1.04em;
    content: "";
    background:
      linear-gradient(90deg, var(--chapter-accent), var(--chapter-accent)) 0 12% / 0.7rem 1px no-repeat,
      linear-gradient(90deg, var(--chapter-rule), var(--chapter-rule)) 0 38% / 0.38rem 1px no-repeat,
      linear-gradient(90deg, var(--chapter-accent), var(--chapter-accent)) 0 64% / 0.56rem 1px no-repeat,
      linear-gradient(90deg, var(--chapter-rule), var(--chapter-rule)) 0 90% / 0.26rem 1px no-repeat;
    opacity: 0.86;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(8) > h2::after {
    content: none;
  }

  /* 09 — final page: the heading reads like a signature, then its small
   * underline fades away instead of opening another grand chapter. */
  #swup-container .monthly-post-layout > section:nth-of-type(9) > h2 {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 0 1.9rem;
    padding: 0 0 0.92rem;
    border: 0;
    color: color-mix(in srgb, var(--monthly-ink) 86%, var(--chapter-accent));
    font-size: clamp(1.8rem, 4.4vw, 2.6rem);
    letter-spacing: 0.16em;
    text-align: center;
    text-indent: 0.16em;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(9) > h2::before {
    content: none;
  }

  #swup-container .monthly-post-layout > section:nth-of-type(9) > h2::after {
    position: absolute;
    bottom: 0.08rem;
    left: 50%;
    width: 3.4rem;
    height: 1px;
    content: "";
    background: linear-gradient(90deg, transparent, var(--chapter-accent), transparent);
    opacity: 0.8;
    transform: translateX(-50%);
  }

  #swup-container .monthly-post-layout > section:nth-of-type(9) > h2.monthly-scroll-reveal--visible::after {
    animation: monthly-signoff-line 2.8s cubic-bezier(0.22, 1, 0.36, 1) both 340ms;
  }

  @keyframes monthly-signoff-line {
    0% { opacity: 0.82; transform: translateX(-50%) scaleX(1); }
    100% { opacity: 0; transform: translateX(-50%) scaleX(0.1); }
  }

  @media (max-width: 767px) {
    #swup-container .monthly-post-layout > section:nth-of-type(1) > h2 {
      grid-template-columns: minmax(0, 1fr) auto auto;
      column-gap: 0.42rem;
      row-gap: 0.42rem;
    }

    #swup-container .monthly-post-layout > section:nth-of-type(1) > h2 > .monthly-chapter-title__label {
      grid-column: 1 / -1;
    }

    #swup-container .monthly-post-layout > section:nth-of-type(1) > h2::after {
      grid-column: 1;
    }

    #swup-container .monthly-post-layout > section:nth-of-type(2) > h2 {
      font-size: clamp(1.95rem, 10vw, 2.7rem);
    }

    #swup-container .monthly-post-layout > section:nth-of-type(3) > h2 {
      padding-bottom: 0.72rem;
      font-size: clamp(1.55rem, 7.3vw, 2.05rem);
    }

    #swup-container .monthly-post-layout > section:nth-of-type(3) > h2::before,
    #swup-container .monthly-post-layout > section:nth-of-type(3) > h2::after {
      width: calc(50% - 0.42rem);
    }

    #swup-container .monthly-post-layout > section:nth-of-type(4) > h2 {
      font-size: clamp(1.55rem, 7.5vw, 2rem);
    }

    #swup-container .monthly-post-layout > section:nth-of-type(5) > h2 {
      font-size: clamp(1.55rem, 7.5vw, 2.05rem);
    }

    #swup-container .monthly-post-layout > section:nth-of-type(6) > h2 {
      padding-inline: 0.55rem;
      font-size: clamp(2rem, 11vw, 2.65rem);
    }

    #swup-container .monthly-post-layout > section:nth-of-type(7) > h2 {
      gap: 0.5rem;
      padding-left: 0.86rem;
      font-size: clamp(1.65rem, 8.2vw, 2.1rem);
    }

    #swup-container .monthly-post-layout > section:nth-of-type(8) > h2 {
      font-size: clamp(1.45rem, 6.5vw, 1.85rem);
    }

    #swup-container .monthly-post-layout > section:nth-of-type(9) > h2 {
      font-size: clamp(1.55rem, 7.5vw, 2rem);
      letter-spacing: 0.11em;
      text-indent: 0.11em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #swup-container .monthly-post-layout .monthly-title-dot,
    #swup-container .monthly-post-layout > section:nth-of-type(6) > h2::after,
    #swup-container .monthly-post-layout > section:nth-of-type(9) > h2.monthly-scroll-reveal--visible::after {
      animation: none !important;
    }

    #swup-container .monthly-post-layout > section:nth-of-type(2) > h2::after,
    #swup-container .monthly-post-layout > section:nth-of-type(3) > h2::before,
    #swup-container .monthly-post-layout > section:nth-of-type(3) > h2::after,
    #swup-container .monthly-post-layout > section:nth-of-type(7) > h2::after {
      transform: none !important;
    }

    #swup-container .monthly-post-layout > section:nth-of-type(7) > h2::before,
    #swup-container .monthly-post-layout .monthly-title-pull,
    #swup-container .monthly-post-layout .monthly-title-stop__returned {
      transform: none !important;
      transition: none !important;
    }

    #swup-container .monthly-post-layout .monthly-title-stop__returned::after {
      animation: none !important;
    }
  }

  /* Kinetic chapter type: the titles carry the character of each chapter on
   * their own. No panels, rulers, bookmark shapes, or decorative dividers. */
  #swup-container .monthly-post-layout > section > h2[data-monthly-title-effect] {
    display: block !important;
    width: fit-content;
    max-width: 100%;
    margin-top: clamp(3.9rem, 8vw, 6.3rem);
    margin-bottom: 1rem;
    padding: 0 !important;
    border: 0 !important;
    background: none !important;
    background-clip: border-box !important;
    -webkit-background-clip: border-box !important;
    color: var(--monthly-ink) !important;
    font-family: var(--font-zen-maru-gothic), sans-serif;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 760;
    line-height: 1.24;
    text-align: start;
    text-wrap: balance;
    -webkit-text-fill-color: currentColor !important;
    animation: none !important;
  }

  #swup-container .monthly-post-layout > section:first-of-type > h2[data-monthly-title-effect] {
    margin-top: 2.65rem;
  }

  #swup-container .monthly-post-layout > section > h2[data-monthly-title-effect]::before,
  #swup-container .monthly-post-layout > section > h2[data-monthly-title-effect]::after {
    content: none !important;
  }

  #swup-container .monthly-post-layout > section > h2[data-monthly-title-effect].monthly-scroll-reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }

  #swup-container .monthly-post-layout > section > h2[data-monthly-title-effect] > .monthly-chapter-title__label {
    display: inline;
    color: inherit;

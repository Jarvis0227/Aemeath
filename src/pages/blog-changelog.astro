---
import { Icon } from "astro-icon/components";
import { blogChangelogEntries } from "@/data/blog-changelog";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const dateCounts = new Map<string, number>();
for (const entry of blogChangelogEntries) {
	dateCounts.set(entry.date, (dateCounts.get(entry.date) ?? 0) + 1);
}

const entries = blogChangelogEntries.map((entry, index) => ({
	...entry,
	index,
	number: blogChangelogEntries.length - index,
	anchor:
		dateCounts.get(entry.date) === 1
			? `blog-changelog-${entry.date}`
			: `blog-changelog-${entry.date}-${entry.version.toLowerCase().replaceAll(".", "-")}`,
}));

const relatedByEntry = new Map<
	number,
	Array<(typeof entries)[number] & { sharedTags: string[] }>
>();
const maxRelatedEntries = 6;
for (let from = 0; from < entries.length; from += 1) {
	for (let to = from + 1; to < entries.length; to += 1) {
		const fromLinks = relatedByEntry.get(from) ?? [];
		const toLinks = relatedByEntry.get(to) ?? [];
		if (
			fromLinks.length >= maxRelatedEntries ||
			toLinks.length >= maxRelatedEntries
		)
			continue;
		const sharedTags = entries[from].tags.filter((tag) =>
			entries[to].tags.includes(tag),
		);
		if (sharedTags.length === 0) continue;
		relatedByEntry.set(from, [...fromLinks, { ...entries[to], sharedTags }]);
		relatedByEntry.set(to, [...toLinks, { ...entries[from], sharedTags }]);
	}
}

const entriesWithRelated = entries.map((entry) => ({
	...entry,
	related: relatedByEntry.get(entry.index) ?? [],
}));
const timelineEntries = entriesWithRelated;
---

<MainGridLayout title="更新日志" description="记录博客项目的功能迭代、问题修复与重要变更">
	<section class="blog-changelog" aria-labelledby="blog-changelog-title">
		<header class="blog-changelog__intro">
			<h1 id="blog-changelog-title">
				<Icon is:inline name="material-symbols:history-rounded" aria-hidden="true" />
				更新日志
			</h1>
			<p>记录博客项目的功能迭代、问题修复与重要变更。</p>
		</header>

		<div class="blog-changelog__section-heading">
			<div class="blog-changelog__section-summary">
				<h2>更新日志</h2>
				<span>{entries.length} 条记录</span>
			</div>
			<ul class="blog-changelog__legend" aria-label="更新颜色说明">
				<li class="tone-major" aria-label="重大更新"><span class="blog-changelog__dot" aria-hidden="true"></span><span class="blog-changelog__legend-full">重大更新</span><span class="blog-changelog__legend-short" aria-hidden="true">重大</span></li>
				<li class="tone-feature" aria-label="功能迭代"><span class="blog-changelog__dot" aria-hidden="true"></span><span class="blog-changelog__legend-full">功能迭代</span><span class="blog-changelog__legend-short" aria-hidden="true">功能</span></li>
				<li class="tone-minor" aria-label="优化维护"><span class="blog-changelog__dot" aria-hidden="true"></span><span class="blog-changelog__legend-full">优化维护</span><span class="blog-changelog__legend-short" aria-hidden="true">优化</span></li>
				<li class="tone-fix" aria-label="问题修复"><span class="blog-changelog__dot" aria-hidden="true"></span><span class="blog-changelog__legend-full">问题修复</span><span class="blog-changelog__legend-short" aria-hidden="true">修复</span></li>
				<li class="tone-content" aria-label="内容更新"><span class="blog-changelog__dot" aria-hidden="true"></span><span class="blog-changelog__legend-full">内容更新</span><span class="blog-changelog__legend-short" aria-hidden="true">内容</span></li>
			</ul>
			<div class="blog-changelog__view-switch" role="group" aria-label="更新日志视图">
				<button type="button" data-changelog-view="timeline" aria-pressed="false">时间线</button>
				<button type="button" data-changelog-view="graph" aria-pressed="true">关系图</button>
			</div>
		</div>

		<div class="blog-changelog__board" data-view="graph">
			<ol class="blog-changelog__timeline" data-changelog-timeline aria-label="按时间排列的博客更新记录">
				{timelineEntries.map((entry) => (
					<li class:list={["blog-changelog__timeline-item", `tone-${entry.tone}`]} id={entry.anchor} data-changelog-timeline-entry data-index={entry.index}>
						<time class="blog-changelog__timeline-date" datetime={entry.date}>{entry.date.replaceAll("-", ".")}</time>
						<span class="blog-changelog__timeline-marker" aria-hidden="true">
							<span class:list={["blog-changelog__dot", `tone-${entry.tone}`]}></span>
						</span>
						<button
							class="blog-changelog__timeline-card"
							type="button"
							data-changelog-open={entry.index}
							aria-haspopup="dialog"
							aria-label={`查看第 ${entry.number} 条更新：${entry.title}`}
						>
							<span class="blog-changelog__timeline-heading">
								<strong>{entry.title}</strong>
								<span class:list={["blog-changelog__timeline-kind", `tone-${entry.tone}`]}>{entry.kind}</span>
							</span>
							<span class="blog-changelog__timeline-summary">{entry.summary}</span>
						</button>
					</li>
				))}
			</ol>

			<div class="blog-changelog__graph" data-changelog-graph>
				<svg class="blog-changelog__connectors" data-changelog-wires aria-hidden="true" focusable="false">
					<defs>
						<marker id="blog-changelog-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
							<path d="M 2 1 L 8 5 L 2 9" fill="none" stroke="context-stroke" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
						</marker>
					</defs>
				</svg>
				<ol class="blog-changelog__grid" aria-label="博客更新关联图">
					{entriesWithRelated.map((entry) => (
						<li
							class:list={["blog-changelog__item", `tone-${entry.tone}`]}
							data-changelog-card
							data-index={entry.index}
							data-num={entry.number}
							data-links={JSON.stringify(entry.related.map((link) => ({ t: link.index, p: link.sharedTags })))}
						>
							<button
								class="blog-changelog__card"
								type="button"
								data-changelog-open={entry.index}
								aria-haspopup="dialog"
								aria-label={`查看第 ${entry.number} 条更新：${entry.title}`}
							>
								<span class="blog-changelog__number" aria-hidden="true">#{String(entry.number).padStart(2, "0")}</span>
								<span class="blog-changelog__meta">
									<span class="blog-changelog__kind">
										<span class:list={["blog-changelog__dot", `tone-${entry.tone}`]} aria-hidden="true"></span>
										{entry.kind}
									</span>
									<time datetime={entry.date}>{entry.date}</time>
								</span>
								<strong class="blog-changelog__card-title">{entry.title}</strong>
								<span class="blog-changelog__summary">{entry.summary}</span>
								<span class="blog-changelog__card-version">{entry.version}</span>
							</button>
						</li>
					))}
				</ol>
			</div>
		</div>

		<dialog class="blog-changelog__dialog" aria-label="更新详情">
			<div class="blog-changelog__dialog-frame">
				<div class="blog-changelog__dialog-bar">
					<span>更新详情</span>
					<button class="blog-changelog__close" type="button" data-changelog-close aria-label="关闭更新详情">
						<Icon is:inline name="material-symbols:close-rounded" aria-hidden="true" />
					</button>
				</div>
				<div class="blog-changelog__dialog-body" data-changelog-body></div>
			</div>
		</dialog>

		{entriesWithRelated.map((entry) => (
			<template data-changelog-template={entry.index}>
				<article class:list={["blog-changelog__entry", `tone-${entry.tone}`]}>
					<div class="blog-changelog__entry-meta">
						<span class="blog-changelog__entry-kind">
							<span class:list={["blog-changelog__dot", `tone-${entry.tone}`]} aria-hidden="true"></span>
							{entry.kind}
						</span>
						<time datetime={entry.date}>{entry.displayDate}</time>
					</div>
					<h2 class="blog-changelog__entry-title" tabindex="-1">{entry.title}</h2>
					<p class="blog-changelog__entry-summary">{entry.summary}</p>

					<div class="blog-changelog__version">
						<span>版本</span>
						<strong>{entry.version}</strong>
					</div>

					<section class="blog-changelog__detail-section" aria-labelledby={`blog-changelog-topics-${entry.index}`}>
						<h3 id={`blog-changelog-topics-${entry.index}`}>涉及内容</h3>
						<ul class="blog-changelog__tags">
							{entry.tags.map((tag) => <li>{tag}</li>)}
						</ul>
					</section>

					<section class="blog-changelog__detail-section" aria-labelledby={`blog-changelog-details-${entry.index}`}>
						<h3 id={`blog-changelog-details-${entry.index}`}>更新详情</h3>
						<ol class="blog-changelog__details">
							{entry.details.map((detail, detailIndex) => (
								<li>
									<span>{String(detailIndex + 1).padStart(2, "0")}</span>
									<p>{detail}</p>
								</li>
							))}
						</ol>
					</section>

					{entry.related.length > 0 && (
						<section class="blog-changelog__detail-section" aria-labelledby={`blog-changelog-related-${entry.index}`}>
							<h3 id={`blog-changelog-related-${entry.index}`}>相关更新</h3>
							<ul class="blog-changelog__related">
								{entry.related.map((related) => (
									<li>
										<button type="button" data-changelog-related={related.index}>
											<span>{related.version} · {related.sharedTags.slice(0, 2).join("、")}</span>
											<strong>{related.title}</strong>
										</button>
									</li>
								))}
							</ul>
						</section>
					)}
				</article>
			</template>
		))}
	</section>
</MainGridLayout>



<style is:global>
	.blog-changelog {
		--changelog-accent: var(--primary);
		--changelog-soft: color-mix(in oklch, var(--primary) 12%, var(--card-bg));
		--changelog-card-bg: color-mix(in oklch, var(--card-bg) 98%, var(--primary) 2%);
		--tone-major: oklch(0.57 0.17 303);
		--tone-feature: color-mix(in oklch, var(--primary) 82%, var(--text-color));
		--tone-minor: oklch(0.54 0.14 163);
		--tone-fix: oklch(0.58 0.2 25);
		--tone-content: oklch(0.59 0.13 78);
		width: 100%;
		padding: 0 0.15rem 2.5rem;
		color: var(--text-color);
	}

	:root.dark .blog-changelog {
		--tone-major: oklch(0.77 0.14 303);
		--tone-minor: oklch(0.75 0.13 163);
		--tone-fix: oklch(0.76 0.17 25);
		--tone-content: oklch(0.78 0.12 78);
	}

	.blog-changelog .tone-major { --entry-accent: var(--tone-major); }
	.blog-changelog .tone-feature { --entry-accent: var(--tone-feature); }
	.blog-changelog .tone-minor { --entry-accent: var(--tone-minor); }
	.blog-changelog .tone-fix { --entry-accent: var(--tone-fix); }
	.blog-changelog .tone-content { --entry-accent: var(--tone-content); }

	.blog-changelog__intro {
		margin: 0 0 2.1rem;
	}

	.blog-changelog__intro h1 {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0;
		font-size: clamp(1.55rem, 2.5vw, 1.95rem);
		font-weight: 720;
		letter-spacing: -0.025em;
		line-height: 1.25;
		text-wrap: balance;
	}

	.blog-changelog__intro h1 :global(svg) {
		width: 1.18em;
		height: 1.18em;
		color: var(--changelog-accent);
	}

	.blog-changelog__intro p {
		margin: 0.55rem 0 0 2.05rem;
		color: var(--content-meta);
		font-size: 0.9rem;
		line-height: 1.65;
		text-wrap: pretty;
	}

	.blog-changelog__section-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: 0 0 1.1rem;
		padding-left: 0.85rem;
		border-left: 3px solid var(--changelog-accent);
	}

	.blog-changelog__section-heading h2 {
		margin: 0;
		font-size: 1.12rem;
		font-weight: 680;
		letter-spacing: -0.015em;
	}

	.blog-changelog__section-summary {
		display: flex;
		flex: 0 0 auto;
		align-items: baseline;
		gap: 0.65rem;
		min-width: 0;
	}

	.blog-changelog__section-summary > span {
		color: var(--content-meta);
		font-size: 0.78rem;
	}

	.blog-changelog__legend {
		display: flex;
		flex: 1 1 auto;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-start;
		gap: 0.3rem 0.75rem;
		min-width: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.blog-changelog__legend li {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--entry-accent);
		font-size: 0.73rem;
		font-weight: 650;
		line-height: 1.5;
		white-space: nowrap;
	}

	.blog-changelog__legend .blog-changelog__dot {
		width: 0.48rem;
		height: 0.48rem;
	}

	.blog-changelog__legend-short { display: none; }

	.blog-changelog__view-switch {
		display: flex;
		flex: 0 0 auto;
		gap: 0.3rem;
	}

	.blog-changelog__view-switch button {
		padding: 0.34rem 0.6rem;
		border: 1px solid transparent;
		border-radius: 0.45rem;
		background: transparent;
		color: var(--content-meta);
		font: inherit;
		font-size: 0.73rem;
		cursor: pointer;
		transition: border-color 150ms ease, color 150ms ease;
	}

	.blog-changelog__view-switch button[aria-pressed="true"] {
		border-color: color-mix(in oklch, var(--primary) 42%, var(--line-divider));
		background: color-mix(in oklch, var(--primary) 8%, var(--card-bg));
		color: var(--changelog-accent);
		font-weight: 650;
	}

	.blog-changelog__view-switch button:focus-visible {
		outline: 2px solid color-mix(in oklch, var(--primary) 65%, transparent);
		outline-offset: 2px;
	}

	.blog-changelog__board {
		position: relative;
		isolation: isolate;
		padding-inline: 0;
	}

	.blog-changelog__board[data-view="timeline"] [data-changelog-graph],
	.blog-changelog__board[data-view="graph"] [data-changelog-timeline] {
		display: none;
	}

	.blog-changelog__graph {
		position: relative;
		padding-inline: 1.25rem;
	}

	.blog-changelog__timeline {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.blog-changelog__timeline-item {
		display: grid;
		grid-template-columns: minmax(5.4rem, 6.4rem) 1.2rem minmax(0, 1fr);
		gap: 0.55rem;
		align-items: stretch;
		min-width: 0;
	}

	.blog-changelog__timeline-date {
		grid-column: 1;
		grid-row: 1;
		justify-self: end;
		padding-top: 0.93rem;
		color: var(--changelog-accent);
		font-family: var(--font-active-sans, inherit);
		font-size: 0.73rem;
		font-variant-numeric: tabular-nums;
		font-weight: 600;
		line-height: 1.5;
		white-space: nowrap;
	}

	.blog-changelog__timeline-marker {
		position: relative;
		grid-column: 2;
		grid-row: 1;
		display: flex;
		justify-content: center;
	}

	.blog-changelog__timeline-marker::before {
		position: absolute;
		top: -1rem;
		bottom: -1rem;
		left: 50%;
		width: 1px;
		background: color-mix(in oklch, var(--changelog-accent) 38%, var(--line-divider));
		content: "";
	}

	.blog-changelog__timeline-item:first-child .blog-changelog__timeline-marker::before {
		top: 1.5rem;
	}

	.blog-changelog__timeline-item:last-child .blog-changelog__timeline-marker::before {
		bottom: calc(100% - 1.5rem);
	}

	.blog-changelog__timeline-marker > .blog-changelog__dot {
		position: relative;
		z-index: 1;
		width: 0.72rem;
		height: 0.72rem;
		margin-top: 1.12rem;
		border: 2px solid color-mix(in oklch, var(--entry-accent) 27%, var(--card-bg));
		border-radius: 50%;
		background: var(--entry-accent);
		box-shadow: 0 0 0 2px color-mix(in oklch, var(--entry-accent) 9%, transparent);
	}

	.blog-changelog__timeline-card {
		grid-column: 3;
		grid-row: 1;
		display: grid;
		gap: 0.34rem;
		min-width: 0;
		padding: 0.7rem 0.9rem;
		border: 1px solid color-mix(in oklch, var(--primary) 38%, var(--line-divider));
		border-radius: 0.78rem;
		background: transparent;
		color: var(--text-color);
		text-align: left;
		cursor: pointer;
		transition: border-color 160ms ease, transform 160ms ease;
	}

	.blog-changelog__timeline-card:hover {
		border-color: color-mix(in oklch, var(--changelog-accent) 70%, var(--line-divider));
		transform: translateX(2px);
	}

	.blog-changelog__timeline-card:focus-visible {
		outline: 2px solid color-mix(in oklch, var(--changelog-accent) 65%, transparent);
		outline-offset: 2px;
	}

	.blog-changelog__timeline-heading {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.42rem 0.55rem;
	}

	.blog-changelog__timeline-heading > strong {
		font-size: 0.91rem;
		font-weight: 680;
		line-height: 1.45;
	}

	.blog-changelog__timeline-kind {
		padding: 0.11rem 0.44rem;
		border-radius: 999px;
		background: color-mix(in oklch, var(--entry-accent) 12%, transparent);
		color: var(--entry-accent);
		font-size: 0.64rem;
		font-weight: 650;
		line-height: 1.4;
	}

	.blog-changelog__timeline-summary {
		color: var(--content-meta);
		font-size: 0.76rem;
		line-height: 1.6;
		text-wrap: pretty;
	}

	.blog-changelog__timeline-item.is-flash .blog-changelog__timeline-card {
		animation: blog-changelog-flash 1.3s ease;
	}

	.blog-changelog__connectors {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.blog-changelog__wire {
		fill: none;
		stroke-width: 1.5;
	}

	.blog-changelog__wire--hover {
		stroke: var(--changelog-accent);
		stroke-width: 1.75;
	}

	.blog-changelog__wire--hover.is-drawn {
		stroke-dasharray: 6 5;
		animation: blog-changelog-dash 0.7s linear infinite;
	}

	.blog-changelog__wire-arrow {
		fill: var(--changelog-accent);
	}

	.blog-changelog__connectors marker path {
		stroke: var(--changelog-accent);
	}

	.blog-changelog__wire-label {
		position: absolute;
		z-index: 3;
		max-width: 12rem;
		padding: 0.25rem 0.625rem;
		overflow: hidden;
		border: 1px solid color-mix(in oklch, var(--primary) 35%, var(--line-divider));
		border-radius: 999px;
		background: var(--card-bg);
		box-shadow: 0 2px 8px rgb(0 0 0 / 0.08);
		color: var(--changelog-accent);
		font-size: 0.6875rem;
		font-weight: 700;
		line-height: 1.4;
		text-overflow: ellipsis;
		white-space: nowrap;
		transform: translate(-50%, -50%);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.35s ease 0.1s, visibility 0.35s ease 0.1s;
		visibility: hidden;
	}

	.blog-changelog__wire-label.is-in {
		opacity: 1;
		visibility: visible;
	}

	@keyframes blog-changelog-dash {
		to { stroke-dashoffset: -11; }
	}

	.blog-changelog__grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.875rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.blog-changelog__item {
		position: relative;
		min-width: 0;
		aspect-ratio: 1.12 / 1;
		transition: opacity 0.25s ease;
	}

	.blog-changelog__board.is-hovering .blog-changelog__item {
		opacity: 0.3;
	}

	.blog-changelog__board.is-hovering .blog-changelog__item.is-active,
	.blog-changelog__board.is-hovering .blog-changelog__item.is-linked {
		opacity: 1;
	}

	.blog-changelog__item.is-active .blog-changelog__card {
		box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.12);
	}

	.blog-changelog__item.is-linked .blog-changelog__card {
		box-shadow: inset 0 0 0 1.5px var(--changelog-accent);
	}

	.blog-changelog__item.is-flash .blog-changelog__card {
		animation: blog-changelog-flash 1.3s ease;
	}

	@keyframes blog-changelog-flash {
		0%, 55% { box-shadow: inset 0 0 0 2px var(--changelog-accent); }
		100% { box-shadow: none; }
	}

	.blog-changelog__card {
		position: relative;

---
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { url } from "@/utils/url-utils";

interface Props { href?: string; title?: string; description?: string; image?: string }
const { href = "", title = "请添加自己的相关阅读", description = "通过组件属性配置标题、封面和文章地址。", image = "/assets/ai-xiaoai-avatar.png" } = Astro.props;
---

<aside class="centennial-related" aria-labelledby="centennial-related-title">
	<div class="centennial-related__heading">
		<span>相关阅读</span>
		<p id="centennial-related-title">{title}</p>
	</div>
	<a class="centennial-related__story" href={href ? url(href) : undefined}>
		<ImageWrapper
			src={image}
			alt={title}
			widths={[360, 540, 720]}
			sizes="(max-width: 760px) 100vw, 280px"
			class="centennial-related__image"
			loading="lazy"
		/>
		<span class="centennial-related__copy">
			<span>{description}</span>
			<strong>{title} <span aria-hidden="true">↗</span></strong>
		</span>
	</a>
</aside>

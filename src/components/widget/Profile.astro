---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { analyticsConfig } from "@/config/analyticsConfig";
import { profileConfig } from "@/config/profileConfig";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;
const umamiAnalytics = analyticsConfig.umamiAnalytics;
const showUmamiStats = Boolean(
  umamiAnalytics?.websiteId &&
  umamiAnalytics.shareId &&
  umamiAnalytics.shareApiBase &&
  umamiAnalytics.showSiteStats !== false,
);
---

<div class:list={["profile-card", "card-base", "relative", "p-3", className]} style={style}>
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95"
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
    >
      <Icon is:inline
        name="fa7-regular:address-card"
        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl"
      />
    </div>
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class="avatar-surface mx-auto lg:w-full h-full lg:mt-0 bg-white"
      loading="eager"
      fetchpriority="high"
      widths={[350]}
      sizes="350px"
    />
  </a>
  <div class="px-2">
    <div
      class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
    >
      {profileConfig.name}
    </div>
    <div
      class="h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"
    >
    </div>
    <div class="text-center text-neutral-400 mb-2.5 transition">
      {profileConfig.bio}
    </div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {profileConfig.links.length > 1 && profileConfig.links.map(item =>
                    {
                    const showName = item.showName;
                    const className = showName 
                        ? "btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95" 
                        : "btn-regular rounded-lg h-10 w-10 active:scale-90";

                    if (item.url.startsWith("copy:")) {
                        const copyValue = item.url.replace("copy:", "");
                        return <a rel="me" aria-label={item.name} href="javascript:void(0)" data-copy-value={copyValue} data-copy-message={`${item.name}已复制`} onclick={`
                                            (function(event) {
                                                event.preventDefault();
                                                const value = this.getAttribute('data-copy-value') || '';
                                                const message = this.getAttribute('data-copy-message') || '已复制';
                                                const showToast = () => {
                                                    const card = this.closest('.profile-card');
                                                    const toast = card && card.querySelector('.profile-copy-toast');
                                                    if (!toast) return;
                                                    toast.textContent = message;
                                                    toast.classList.remove('opacity-0', 'translate-y-1', 'pointer-events-none');
                                                    toast.classList.add('opacity-100', 'translate-y-0');
                                                    clearTimeout(toast._profileCopyTimer);
                                                    toast._profileCopyTimer = setTimeout(function() {
                                                        toast.classList.remove('opacity-100', 'translate-y-0');
                                                        toast.classList.add('opacity-0', 'translate-y-1', 'pointer-events-none');
                                                    }, 1600);
                                                };
                                                const fallbackCopy = () => {
                                                    const input = document.createElement('textarea');
                                                    input.value = value;
                                                    input.setAttribute('readonly', '');
                                                    input.style.position = 'fixed';
                                                    input.style.opacity = '0';
                                                    document.body.appendChild(input);
                                                    input.select();
                                                    document.execCommand('copy');
                                                    document.body.removeChild(input);
                                                };
                                                if (navigator.clipboard && navigator.clipboard.writeText) {
                                                    navigator.clipboard.writeText(value).catch(fallbackCopy).finally(showToast);
                                                } else {
                                                    fallbackCopy();
                                                    showToast();
                                                }
                                            }).call(this, event);
                                        `.replace(/\s+/g, " ").trim()
                                    },
                                    class={className}>
                            <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                    }
                    if (item.url.startsWith("mailto:")) {
                        const encodedEmail = Buffer.from(item.url.replace("mailto:", "")).toString("base64");
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={`
                                            (function() {
                                                const encodedEmail = this.getAttribute('data-encoded-email');
                                                const decodedEmail = atob(encodedEmail);
                                                this.href = 'mailto:' + decodedEmail;
                                                this.removeAttribute('data-encoded-email');
                                                this.removeAttribute('onclick');
                                                this.click();
                                                return false;
                                            }).call(this);
                                        `.replace(/\s+/g, " ").trim()
                                    },
                                    class={className}>
                            <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank" class={className}>
                            <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                    }
                    }
            )}
            {profileConfig.links.length == 1 && (function(item){
                if (item.url.startsWith("copy:")) {
                        const copyValue = item.url.replace("copy:", "");
                        return <a rel="me" aria-label={item.name} href="javascript:void(0)" data-copy-value={copyValue} data-copy-message={`${item.name}已复制`} onclick={`
                                            (function(event) {
                                                event.preventDefault();
                                                const value = this.getAttribute('data-copy-value') || '';
                                                const message = this.getAttribute('data-copy-message') || '已复制';
                                                const showToast = () => {
                                                    const card = this.closest('.profile-card');
                                                    const toast = card && card.querySelector('.profile-copy-toast');
                                                    if (!toast) return;
                                                    toast.textContent = message;
                                                    toast.classList.remove('opacity-0', 'translate-y-1', 'pointer-events-none');
                                                    toast.classList.add('opacity-100', 'translate-y-0');
                                                    clearTimeout(toast._profileCopyTimer);
                                                    toast._profileCopyTimer = setTimeout(function() {
                                                        toast.classList.remove('opacity-100', 'translate-y-0');
                                                        toast.classList.add('opacity-0', 'translate-y-1', 'pointer-events-none');
                                                    }, 1600);
                                                };
                                                const fallbackCopy = () => {
                                                    const input = document.createElement('textarea');
                                                    input.value = value;
                                                    input.setAttribute('readonly', '');
                                                    input.style.position = 'fixed';
                                                    input.style.opacity = '0';
                                                    document.body.appendChild(input);
                                                    input.select();
                                                    document.execCommand('copy');
                                                    document.body.removeChild(input);
                                                };
                                                if (navigator.clipboard && navigator.clipboard.writeText) {
                                                    navigator.clipboard.writeText(value).catch(fallbackCopy).finally(showToast);
                                                } else {
                                                    fallbackCopy();
                                                    showToast();
                                                }
                                            }).call(this, event);
                                        `.replace(/\s+/g, " ").trim()
                                    },
                                    class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                            <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
                            {item.name}
                        </a>
                    }
                if (item.url.startsWith("mailto:")) {
                        const encodedEmail = Buffer.from(item.url.replace("mailto:", "")).toString("base64");
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={`
                                            (function() {
                                                const encodedEmail = this.getAttribute('data-encoded-email');
                                                const decodedEmail = atob(encodedEmail);
                                                this.href = 'mailto:' + decodedEmail;
                                                this.removeAttribute('data-encoded-email');
                                                this.removeAttribute('onclick');
                                                this.click();
                                                return false;
                                            }).call(this);
                                        `.replace(/\s+/g, " ").trim()
                                    },
                                    class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                            <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
                            {item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                                <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
                                {item.name}
                            </a>
                    }
            })(profileConfig.links[0])}
        </div>
        {showUmamiStats && (
          <div class="mt-3 grid grid-cols-2 gap-2 border-t border-(--line-divider) pt-3" aria-label="站点访问统计">
            <div class="rounded-xl bg-(--btn-regular-bg) px-2 py-2 text-center">
              <div class="mb-0.5 flex items-center justify-center gap-1 text-(--primary)">
                <Icon is:inline name="material-symbols:group-outline" class="text-[0.95rem]" aria-hidden="true" />
                <span class="text-[0.68rem] font-semibold text-(--content-meta)">累计访客</span>
              </div>
              <strong class="block text-sm font-bold text-(--text-color)" data-umami-stat="visitors" aria-live="polite">加载中</strong>
            </div>
            <div class="rounded-xl bg-(--btn-regular-bg) px-2 py-2 text-center">
              <div class="mb-0.5 flex items-center justify-center gap-1 text-(--primary)">
                <Icon is:inline name="material-symbols:visibility-outline-rounded" class="text-[0.95rem]" aria-hidden="true" />
                <span class="text-[0.68rem] font-semibold text-(--content-meta)">总浏览量</span>
              </div>
              <strong class="block text-sm font-bold text-(--text-color)" data-umami-stat="pageviews" aria-live="polite">加载中</strong>
            </div>
          </div>
        )}
        <div class="profile-copy-toast pointer-events-none absolute bottom-2 left-1/2 z-10 w-fit max-w-[calc(100%-1rem)] -translate-x-1/2 rounded-full bg-(--primary) px-3 py-1 text-xs font-bold text-white opacity-0 translate-y-1 transition-all duration-200">
          已复制
        </div>
  </div>
</div>

---
---

<div
  id="scroll-progress-circle"
  class="scroll-progress-circle"
  role="img"
  aria-label="页面滚动进度 0%"
>
  <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <circle class="scroll-progress-circle__track" cx="24" cy="24" r="19" pathLength="100" />
    <circle
      id="scroll-progress-circle-value"
      class="scroll-progress-circle__value"
      cx="24"
      cy="24"
      r="19"
      pathLength="100"
    />
  </svg>
  <span id="scroll-progress-circle-label">0%</span>
</div>

<style>
  .scroll-progress-circle {
    position: relative;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    color: var(--primary);
    border: 1px solid var(--glass-control-border);
    border-radius: 1rem;
    background-color: transparent;
    box-shadow: none;
    backdrop-filter: none;
    overflow: hidden;
    pointer-events: none;
  }

  .scroll-progress-circle svg {
    position: absolute;
    inset: 0.18rem;
    width: calc(100% - 0.36rem);
    height: calc(100% - 0.36rem);
    overflow: visible;
    transform: rotate(-90deg);
  }

  .scroll-progress-circle circle {
    fill: none;
    stroke-linecap: round;
    stroke-width: 3.5;
  }

  .scroll-progress-circle__track {
    stroke: color-mix(in srgb, var(--primary) 14%, var(--line-divider));
  }

  .scroll-progress-circle__value {
    stroke: var(--primary);
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 120ms linear;
  }

  .scroll-progress-circle > span {
    position: relative;
    z-index: 1;
    min-width: 2.3em;
    color: var(--primary);
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  :global(.dark) .scroll-progress-circle {
    border-color: var(--glass-control-border);
    background-color: transparent;
    box-shadow: none;
  }

  @media (max-width: 768px) {
    .scroll-progress-circle {
      width: 3rem;
      height: 3rem;
      border-radius: 1rem;
    }
  }

  @media (max-width: 480px) {
    .scroll-progress-circle {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 1rem;
    }
  }

  @media (max-width: 360px) {
    .scroll-progress-circle {
      width: 2rem;
      height: 2rem;
      border-radius: 1rem;
    }

    .scroll-progress-circle > span {
      font-size: 0.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-progress-circle__value {
      transition: none;
    }
  }
</style>

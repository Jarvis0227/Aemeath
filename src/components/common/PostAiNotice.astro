---
import { Icon } from "astro-icon/components";

interface Props {
	text?: string;
}
const { text = "本文已使用Ai辅助创作" } = Astro.props;
---

<div class="post-ai-polish-mark" role="note" aria-label={text}>
	<Icon is:inline name="material-symbols:auto-awesome-rounded" class="text-base" />
	<span>{text}</span>
</div>

<style>
	.post-ai-polish-mark {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-inline-start: auto;
		padding: 0.28rem 0.55rem;
		border: 1px dashed color-mix(in srgb, var(--primary) 40%, transparent);
		border-radius: 0.45rem;
		background: color-mix(in srgb, var(--primary) 7%, transparent);
		color: color-mix(in srgb, var(--primary) 72%, var(--text-color));
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		opacity: 0.78;
		transform: rotate(-1.5deg);
		white-space: nowrap;
	}
	.post-ai-polish-mark svg { flex: 0 0 auto; }
	@media (max-width: 640px) {
		.post-ai-polish-mark { margin-inline: auto; }
	}
</style>

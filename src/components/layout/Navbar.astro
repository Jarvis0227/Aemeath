---
import { Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import DisplaySettings from "@/components/controls/DisplaySettingsIntegrated.svelte";
import LightDarkSwitch from "@/components/controls/LightDarkSwitch.svelte";
import Search from "@/components/controls/Search.svelte";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import { backgroundWallpaper, navBarConfig, siteConfig } from "@/config";
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { NavBarLink } from "@/types/config";
import { getFallbackFormat, getImageFormats } from "@/utils/image-utils";
import { isHomePage } from "@/utils/layout-utils";
import { url } from "@/utils/url-utils";
import DropdownMenu from "./DropdownMenu.astro";
import NavMenuPanel from "./NavMenuPanel.astro";

const className = Astro.props.class;

// 获取导航栏透明模式配置
const navbarTransparentMode =
	backgroundWallpaper.mode === "banner"
		? backgroundWallpaper.common?.navbar?.transparentMode || "semi"
		: "semi";

// 获取导航栏毛玻璃效果配置
const navbarEnableBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.common?.navbar?.enableBlur ?? true)
		: false;

// 获取导航栏模糊度
const navbarBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.common?.navbar?.blur ?? 20)
		: 0;

// 获取导航栏标题，如果没有设置则使用 siteConfig.title
const navbarTitle = siteConfig.navbar.title || siteConfig.title;

// 获取导航栏宽度配置
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
const navbarMenuAlign = siteConfig.navbar.menuAlign ?? "center";
const isNavbarMenuCentered = navbarMenuAlign === "center";

// 检查是否为首页
const isHomePageCheck = isHomePage(Astro.url.pathname);

// 根据 siteConfig.pages 过滤导航栏链接
const pages = siteConfig.pages;

function isPageEnabled(link: NavBarLink): boolean {
	if (!link.pageKey) return true;
	return pages[link.pageKey as keyof typeof pages] !== false;
}

function filterLinks(link: NavBarLink): NavBarLink | null {
	if (!link.children) {
		return isPageEnabled(link) ? link : null;
	}

	const filteredChildren = link.children.filter(isPageEnabled);

	if (filteredChildren.length === 0) return null;
	if (filteredChildren.length === 1) return filteredChildren[0];
	return { ...link, children: filteredChildren };
}

let links: NavBarLink[] = navBarConfig.links
	.map(filterLinks)
	.filter((link): link is NavBarLink => link !== null);

// 处理导航栏 Logo 图片
const logoValue = siteConfig.navbar.logo?.value || "";
const isLocalSrcLogo =
	siteConfig.navbar.logo?.type === "image" &&
	logoValue &&
	!logoValue.startsWith("/") &&
	!logoValue.startsWith("http");
let logoImg: ImageMetadata | null = null;

if (isLocalSrcLogo) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
		{ import: "default" },
	);
	const normalizedPath = path
		.normalize(path.join("../../", logoValue))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (file) {
		logoImg = await file();
	}
}
---
<div id="navbar" class="z-50 firefly-navbar" style={`--navbar-glass-blur: ${navbarBlur}px;`} data-transparent-mode={navbarTransparentMode} data-enable-blur={String(navbarEnableBlur)} data-is-home={isHomePageCheck} data-full-width={navbarWidthFull}>
    <div class:list={[
        className,
        "firefly-nav-shell relative overflow-visible! h-18 px-4"
    ]}>
        <div class="nav-container mx-auto h-full w-full grid grid-cols-[auto_minmax(0,1fr)_auto] items-center">
            <a href={url('/')} class="nav-brand btn-plain scale-animation rounded-lg h-13 px-5 font-bold active:scale-95">
                <span class:list={[
                    "brand-name flex flex-row items-center text-md",
                    siteConfig.navbar.followTheme ? "text-(--primary)" : "dark:text-white text-black"
                ]} style="font-family: var(--font-navbar-title, inherit)">
                                    {siteConfig.navbar.logo?.type === "icon" ? (
                                        <Icon is:inline name={siteConfig.navbar.logo.value || "material-symbols:home-pin-outline"} class="text-[1.75rem] mb-1 mr-2" />
                                    ) : siteConfig.navbar.logo?.type === "image" && logoImg ? (
                                        <Picture
                                            src={logoImg}
                                            alt={siteConfig.navbar.logo.alt || siteConfig.title}
                                            class="h-7 w-7 mb-1 mr-2 rounded-md bg-white object-contain ring-1 ring-sky-100/80 dark:ring-white/20"
                                            formats={getImageFormats()}
                                            fallbackFormat={getFallbackFormat()}
                                            widths={[28, 56]}
                                            loading="eager"
                                            fetchpriority="high"
                                        />
                                    ) : siteConfig.navbar.logo?.type === "image" ? (
                                        <img src={url(siteConfig.navbar.logo.value)} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-7 w-7 mb-1 mr-2 rounded-md bg-white object-contain ring-1 ring-sky-100/80 dark:ring-white/20" fetchpriority="high" />
                                    ) : siteConfig.navbar.logo?.type === "url" ? (
                                        <img src={siteConfig.navbar.logo.value} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-7 w-7 mb-1 mr-2 rounded-md bg-white object-contain ring-1 ring-sky-100/80 dark:ring-white/20" fetchpriority="high" />
                                    ) : (
                                        <Icon is:inline name="material-symbols:home-pin-outline" class="text-[1.75rem] mb-1 mr-2" />
                                    )}
                    {navbarTitle}
                </span>
            </a>
            <div class:list={[
                "nav-links hidden lg:flex items-center space-x-1 col-start-2",
                isNavbarMenuCentered ? "justify-self-center justify-center" : "justify-self-start justify-start"
            ]}>
                {links.map((l) => {
                    return <DropdownMenu link={l} />;
                })}
            </div>
            <div class="nav-actions flex items-center gap-1 col-start-3 justify-self-end min-w-0">
                <!--<SearchPanel client:load>-->
                <Search
                    client:load
                />
                {musicPlayerConfig.showInNavbar && (
                    <button aria-label={i18n(I18nKey.music)} class="theme-btn btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="music-player-switch">
                        <Icon is:inline name="material-symbols:music-note-rounded" class="text-[1.25rem]"></Icon>
                    </button>
                )}
                {backgroundWallpaper.playerEnable && backgroundWallpaper.mode !== "none" && (
                    <button
                        aria-label={i18n(I18nKey.videoPlay)}
                        class="theme-btn btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90"
                        id="bg-player-toggle"
                        data-i18n-play={i18n(I18nKey.videoPlay)}
                        data-i18n-pause={i18n(I18nKey.videoPause)}
                    >
                        <Icon is:inline name="material-symbols:play-arrow-rounded" class="text-[1.5rem]" />
                    </button>
                )}
                <button aria-label="外观设置" title="外观设置" class="theme-btn btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                    <Icon is:inline name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                </button>
                {/* @ts-ignore */}
                <LightDarkSwitch client:load></LightDarkSwitch>
                <button aria-label="Menu" aria-controls="nav-menu-panel" aria-expanded="false" name="Nav Menu" class="menu-btn btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90" id="nav-menu-switch">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
        {musicPlayerConfig.showInNavbar && (
            <div id="music-nav-panel" class="float-panel float-panel-closed absolute transition-all right-16 p-2 pt-4.5 w-80 z-50">
                <MusicPlayer />
            </div>
        )}
        <DisplaySettings client:load></DisplaySettings>
    </div>
    <!-- Keep the drawer outside the glass shell: backdrop-filter creates a
         containing block for fixed descendants on mobile. -->
    <NavMenuPanel links={links}></NavMenuPanel>
</div>

<script>
function loadButtonScript() {
    function setMobileMenuOpen(open: boolean) {
        let menuPanel = document.getElementById("nav-menu-panel");
        let menuButton = document.getElementById("nav-menu-switch");
        if (!menuPanel) return;

        if (!open) {
            menuPanel.querySelectorAll<HTMLElement>(".mobile-nav-group").forEach((group) => {
                const expanded = group.classList.contains("mobile-nav-group-active");
                group.dataset.open = String(expanded);
                group.querySelector<HTMLButtonElement>(".mobile-group-title")?.setAttribute("aria-expanded", String(expanded));
                const panel = group.querySelector<HTMLElement>(".mobile-group-panel");
                panel?.toggleAttribute("inert", !expanded);
                if (expanded) panel?.removeAttribute("aria-hidden");
                else panel?.setAttribute("aria-hidden", "true");
            });
        }

        menuPanel.classList.toggle("float-panel-closed", !open);
        menuPanel.classList.toggle("active", open);
        menuPanel.setAttribute("aria-hidden", String(!open));
        document.getElementById("top-row")?.classList.toggle("mobile-nav-open", open);
        menuButton?.classList.toggle("active", open);
        menuButton?.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
    }

    (window as Window & { __fireflySetMobileMenuOpen?: (open: boolean) => void })
        .__fireflySetMobileMenuOpen = setMobileMenuOpen;

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                setMobileMenuOpen(!menuPanel.classList.contains("active"));
            }
        };
    }

    let musicBtn = document.getElementById("music-player-switch");
    if (musicBtn) {
        musicBtn.onclick = function () {
            let musicPanel = document.getElementById("music-nav-panel");
            if (musicPanel) {
                musicPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    // 背景视频播放器控制按钮
    let bgPlayerBtn = document.getElementById("bg-player-toggle");
    if (bgPlayerBtn) {
        bgPlayerBtn.onclick = function () {
            window.dispatchEvent(new CustomEvent("bg-player-toggle"));
        };
        window.addEventListener("bg-player-state-change", function (e) {
            var ce = e as CustomEvent;
            var playing = ce.detail && ce.detail.playing;
            var i18nPlay = bgPlayerBtn!.getAttribute("data-i18n-play") ?? "";
            var i18nPause = bgPlayerBtn!.getAttribute("data-i18n-pause") ?? "";
            var label = playing ? i18nPause : i18nPlay;
            bgPlayerBtn!.innerHTML = playing
                ? '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M16 19q-.825 0-1.412-.587T14 17V7q0-.825.588-1.412T16 5t1.413.588T18 7v10q0 .825-.587 1.413T16 19m-8 0q-.825 0-1.412-.587T6 17V7q0-.825.588-1.412T8 5t1.413.588T10 7v10q0 .825-.587 1.413T8 19"/></svg>'
                : '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M8 17.175V6.825q0-.425.3-.713t.7-.287q.125 0 .263.037t.262.113l8.15 5.175q.225.15.338.375t.112.475t-.112.475t-.338.375l-8.15 5.175q-.125.075-.262.113T9 18.175q-.4 0-.7-.288t-.3-.712"/></svg>';
            bgPlayerBtn!.setAttribute("title", label);
            bgPlayerBtn!.setAttribute("aria-label", label);
        });
        // 切换壁纸模式时隐藏/显示播放按钮
        window.addEventListener("wallpaperModeChange", function (e) {
            var ce = e as CustomEvent;
            var mode = ce.detail && ce.detail.mode;
            bgPlayerBtn!.style.display = mode === "none" ? "none" : "";
        });
        // Swup 导航时同步播放按钮状态（BackgroundPlayer 可能被重建，也可能持久存在）
        function syncBgPlayerBtn() {
            var playing = document.documentElement.hasAttribute("data-bg-video-playing");
            var i18nPlay = bgPlayerBtn!.getAttribute("data-i18n-play") ?? "";
            var i18nPause = bgPlayerBtn!.getAttribute("data-i18n-pause") ?? "";
            var label = playing ? i18nPause : i18nPlay;
            bgPlayerBtn!.innerHTML = playing
                ? '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M16 19q-.825 0-1.412-.587T14 17V7q0-.825.588-1.412T16 5t1.413.588T18 7v10q0 .825-.587 1.413T16 19m-8 0q-.825 0-1.412-.587T6 17V7q0-.825.588-1.412T8 5t1.413.588T10 7v10q0 .825-.587 1.413T8 19"/></svg>'
                : '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M8 17.175V6.825q0-.425.3-.713t.7-.287q.125 0 .263.037t.262.113l8.15 5.175q.225.15.338.375t.112.475t-.112.475t-.338.375l-8.15 5.175q-.125.075-.262.113T9 18.175q-.4 0-.7-.288t-.3-.712"/></svg>';
            bgPlayerBtn!.setAttribute("title", label);
            bgPlayerBtn!.setAttribute("aria-label", label);
        }
        if (window.swup && window.swup.hooks) {
            window.swup.hooks.on("content:replace", syncBgPlayerBtn);
        } else {
            document.addEventListener("swup:enable", function () {
                window.swup.hooks.on("content:replace", syncBgPlayerBtn);
            });
        }
    }

    let themeSwitchBtn = document.getElementById("scheme-switch");
    if (themeSwitchBtn) {
        themeSwitchBtn.onclick = function () {
            let themePanel = document.getElementById("theme-mode-panel");
            if (themePanel) {
                themePanel.classList.toggle("float-panel-closed");
            }
        };
    }

    document.addEventListener("click", function(event) {
        const panels = ["display-setting", "nav-menu-panel", "music-nav-panel", "theme-mode-panel"];
        const buttons = ["display-settings-switch", "nav-menu-switch", "music-player-switch", "scheme-switch"];

        panels.forEach((id, index) => {
            const panel = document.getElementById(id);
            const button = document.getElementById(buttons[index]);
            if (panel && button && !panel.classList.contains("float-panel-closed")) {
                if (event.target instanceof Node && !panel.contains(event.target) && !button.contains(event.target)) {
                    if (id === "nav-menu-panel") {
                        setMobileMenuOpen(false);
                    } else {
                        panel.classList.add("float-panel-closed");
                    }
                }
            }
        });
    });
}

loadButtonScript();

const compactNavbarTransitionDuration = 1100;
const compactNavbarFoldPoint = 0.54;
let compactNavbarModuleAnimations: Animation[] = [];
let compactNavbarAnimatedMenu: HTMLElement | null = null;

function cancelCompactNavbarModuleMotion() {
    compactNavbarModuleAnimations.forEach((animation) => animation.cancel());
    compactNavbarModuleAnimations = [];
    compactNavbarAnimatedMenu?.classList.remove("is-module-folding");
    compactNavbarAnimatedMenu = null;
}

function transitionCompactNavbarModules(navLinks: HTMLElement, expand: boolean, changeState: () => void) {
    const items = Array.from(navLinks.querySelectorAll<HTMLElement>(":scope > .dropdown-container"));
    const active = navLinks.querySelector<HTMLElement>(":scope > .nav-compact-active");
    const activeIndex = active ? items.indexOf(active) : -1;
    if (!navLinks.classList.contains("is-layout-ready") || !active || activeIndex < 0
        || window.innerWidth <= 1440 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        cancelCompactNavbarModuleMotion();
        changeState();
        return;
    }

    const menuRect = navLinks.getBoundingClientRect();
    const menuCenter = menuRect.left + menuRect.width / 2;
    const currentOffsets = items.map((item) => {
        const rect = item.getBoundingClientRect();
        return rect.left + rect.width / 2 - menuCenter;
    });
    const currentOpacities = items.map((item) => Number.parseFloat(getComputedStyle(item).opacity));
    const expandedOffsets = items.map((item) => Number.parseFloat(item.style.getPropertyValue("--nav-item-expanded-offset")) || 0);
    const activeOffset = currentOffsets[activeIndex];
    const activeExpandedOffset = expandedOffsets[activeIndex];

    cancelCompactNavbarModuleMotion();
    changeState();
    const targetOffset = expand ? activeExpandedOffset : 0;
    if (Math.abs(activeOffset - targetOffset) < 2
        && items.every((_, index) => Math.abs(currentOffsets[index] - (expand ? expandedOffsets[index] : 0)) < 2)) return;

    navLinks.classList.add("is-module-folding");
    compactNavbarAnimatedMenu = navLinks;
    const at = (offset: number) => `calc(50% + ${offset}px)`;
    const activeTransform = (offset: number) => `translate(-50%, -50%) translateX(${offset}px)`;
    const slideEase = "cubic-bezier(0.4, 0, 0.2, 1)";
    const motion: KeyframeAnimationOptions = { duration: compactNavbarTransitionDuration, easing: "linear", fill: "forwards" };
    const activeFrames = expand
        ? [
            { left: at(activeExpandedOffset), transform: activeTransform(activeOffset - activeExpandedOffset), offset: 0, easing: slideEase },
            { left: at(activeExpandedOffset), transform: activeTransform(0), offset: 1 - compactNavbarFoldPoint, easing: slideEase },
            { left: at(activeExpandedOffset), transform: activeTransform(0), offset: 1 },
        ]
        : [
            { left: at(0), transform: activeTransform(activeOffset), offset: 0, easing: slideEase },
            { left: at(0), transform: activeTransform(activeOffset), offset: compactNavbarFoldPoint, easing: slideEase },
            { left: at(0), transform: activeTransform(0), offset: 1 },
        ];
    const activeAnimation = active.animate(activeFrames, motion);
    compactNavbarModuleAnimations = [activeAnimation, ...items.flatMap((item, index) => {
        if (index === activeIndex) return [];
        const distance = Math.abs(index - activeIndex);
        const joinPoint = Math.min(0.51, 0.29 + distance * 0.03);
        const frames = expand
            ? [
                { left: at(currentOffsets[index]), opacity: currentOpacities[index], offset: 0, easing: slideEase },
                { left: at(activeExpandedOffset), opacity: 0, offset: 1 - compactNavbarFoldPoint },
                { left: at(activeExpandedOffset), opacity: 0.12, offset: 1 - joinPoint, easing: slideEase },
                { left: at(expandedOffsets[index]), opacity: 1, offset: 1 },
            ]
            : [
                { left: at(currentOffsets[index]), opacity: currentOpacities[index], offset: 0, easing: slideEase },
                { left: at(activeOffset), opacity: 0.12, offset: joinPoint },
                { left: at(activeOffset), opacity: 0, offset: compactNavbarFoldPoint, easing: slideEase },
                { left: at(0), opacity: 0, offset: 1 },
            ];
        return [item.animate(frames, motion)];
    })];
    activeAnimation.onfinish = () => {
        if (compactNavbarModuleAnimations[0] === activeAnimation) cancelCompactNavbarModuleMotion();
    };
}

function prepareCompactNavbarReveal(navLinks: HTMLElement) {
    const inactiveItem = navLinks.querySelector<HTMLElement>(":scope > .dropdown-container:not(.nav-compact-active)");
    if (!inactiveItem) return;

    // If a collapse is interrupted, keep the visible items moving without
    // freezing their opacity while the menu reverses direction.
    if (Number.parseFloat(getComputedStyle(inactiveItem).opacity) > 0.08) {
        navLinks.style.setProperty("--nav-item-reveal-delay", "0ms");
        return;
    }

    const style = getComputedStyle(navLinks);
    const compactWidth = Number.parseFloat(style.getPropertyValue("--nav-links-compact-width"));
    const expandedWidth = Number.parseFloat(style.getPropertyValue("--nav-links-expanded-width"));
    const widthRange = expandedWidth - compactWidth;
    const progress = widthRange > 0
        ? Math.min(1, Math.max(0, (navLinks.getBoundingClientRect().width - compactWidth) / widthRange))
        : 0;
    const revealDelay = Math.round(760 * (1 - Math.min(1, progress / 0.85)));
    navLinks.style.setProperty("--nav-item-reveal-delay", `${revealDelay}ms`);
}

function normalizeNavPath(path: string) {
    var pathname = (path || "/").split(/[?#]/)[0] || "/";
    try {
        if (/^https?:\/\//.test(pathname)) {
            pathname = new URL(pathname).pathname;
        }
    } catch (_) {}
    if (!pathname.startsWith("/")) pathname = "/" + pathname;
    var basePath = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
    if (basePath && basePath !== "/" && pathname.startsWith(basePath)) {
        pathname = pathname.slice(basePath.length) || "/";
    }
    return pathname.length > 1 ? pathname.replace(/\/+$/g, "") : "/";
}

function navPathMatches(currentPath: string, candidatePath: string) {
    if (!candidatePath) return false;
    if (candidatePath === "/") return currentPath === "/";
    return currentPath === candidatePath || currentPath.startsWith(candidatePath + "/");
}

function setCompactNavbarExpanded(navbar: HTMLElement, expand: boolean, revealSubmenu = false) {
    if (!navbar.classList.contains("scrolled")) return;
    const navLinks = navbar.querySelector<HTMLElement>(".nav-links");
    if (!navLinks || !navLinks.querySelector(".nav-compact-active .nav-link")) return;

    if (expand) {
        if (!navLinks.classList.contains("is-hover-expanded")) {
            compactNavbarMotionUntil = performance.now() + compactNavbarTransitionDuration;
            prepareCompactNavbarReveal(navLinks);
            transitionCompactNavbarModules(navLinks, true, () => navLinks.classList.add("is-hover-expanded"));
        }
        if (revealSubmenu) {
            const submenuDelay = Math.max(0, compactNavbarMotionUntil - performance.now());
            navLinks.style.setProperty("--nav-submenu-reveal-delay", `${submenuDelay}ms`);
            navLinks.classList.remove("is-scroll-revealed");
            navLinks.classList.add("is-active-submenu-open");
        } else {
            navLinks.classList.add("is-scroll-revealed");
            navLinks.classList.remove("is-active-submenu-open");
        }
    } else {
        compactNavbarMotionUntil = 0;
        navLinks.style.removeProperty("--nav-submenu-reveal-delay");
        setCompactNavbarSubmenu(navLinks, null);
        transitionCompactNavbarModules(navLinks, false, () => {
            navLinks.classList.remove("is-hover-expanded", "is-active-submenu-open", "is-scroll-revealed");
        });
    }
}

function updateNavbarMenuSizing() {
    const navbar = document.getElementById("navbar");
    const navLinks = navbar?.querySelector<HTMLElement>(".nav-links");
    if (!navbar || !navLinks) return;

    cancelCompactNavbarModuleMotion();

    const wasScrolled = navbar.classList.contains("scrolled");
    const hadStickyShadow = navbar.classList.contains("navbar-sticky-shadow");
    const previousStyle = navLinks.getAttribute("style");
    const navItems = Array.from(navLinks.querySelectorAll<HTMLElement>(".dropdown-container"));
    const previousItemStyles = navItems.map((item) => item.getAttribute("style"));

    // Measure the complete menu offscreen so it also works at breakpoints where
    // the full desktop menu is hidden in favor of the existing mobile drawer.
    navbar.classList.remove("scrolled", "navbar-sticky-shadow");
    navLinks.style.setProperty("position", "fixed", "important");
    navLinks.style.setProperty("top", "0", "important");
    navLinks.style.setProperty("left", "-10000px", "important");
    navLinks.style.setProperty("display", "flex", "important");
    navLinks.style.setProperty("width", "max-content", "important");
    navLinks.style.setProperty("max-width", "none", "important");
    navLinks.style.setProperty("transform", "none", "important");
    navLinks.style.setProperty("visibility", "hidden", "important");
    navLinks.style.setProperty("pointer-events", "none", "important");
    navLinks.style.setProperty("transition", "none", "important");

    navItems.forEach((item) => {
        item.style.setProperty("position", "relative", "important");
        item.style.setProperty("top", "auto", "important");
        item.style.setProperty("left", "auto", "important");
        item.style.setProperty("display", "flex", "important");
        item.style.setProperty("opacity", "1", "important");
        item.style.setProperty("visibility", "visible", "important");
        item.style.setProperty("pointer-events", "auto", "important");
        item.style.setProperty("transform", "none", "important");
        item.style.setProperty("transition", "none", "important");
    });

    const expandedRect = navLinks.getBoundingClientRect();
    const expandedWidth = Math.ceil(expandedRect.width);
    const itemOffsets = navItems.map((item) => {
        const itemRect = item.getBoundingClientRect();
        return itemRect.left + itemRect.width / 2 - (expandedRect.left + expandedRect.width / 2);
    });
    const activeLink = navLinks.querySelector<HTMLElement>(".nav-link-active, .active")
        || navLinks.querySelector<HTMLElement>(".nav-link");
    const rootFontSize = Number.parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    const compactWidth = Math.ceil((activeLink?.getBoundingClientRect().width || rootFontSize * 4) + rootFontSize * 0.48 + 2);

    if (previousStyle === null) navLinks.removeAttribute("style");
    else navLinks.setAttribute("style", previousStyle);
    navItems.forEach((item, index) => {
        const previousItemStyle = previousItemStyles[index];
        if (previousItemStyle === null) item.removeAttribute("style");
        else if (previousItemStyle !== undefined) item.setAttribute("style", previousItemStyle);
    });
    if (wasScrolled) navbar.classList.add("scrolled");
    if (hadStickyShadow) navbar.classList.add("navbar-sticky-shadow");

    navLinks.style.setProperty("--nav-links-expanded-width", `${expandedWidth}px`);
    navLinks.style.setProperty("--nav-links-compact-width", `${compactWidth}px`);

    navLinks.querySelectorAll(".nav-compact-active").forEach((item) => item.classList.remove("nav-compact-active"));
    const compactLink = navLinks.querySelector<HTMLElement>(".nav-link-active, .active")
        || navLinks.querySelector<HTMLElement>(".nav-link");
    compactLink?.closest(".dropdown-container")?.classList.add("nav-compact-active");
    navLinks.querySelectorAll<HTMLElement>(".dropdown-container").forEach((item, index) => {
        item.style.setProperty("--nav-item-expanded-offset", `${itemOffsets[index] || 0}px`);
    });
    navLinks.classList.add("is-layout-ready");
}

function syncNavbarActiveState() {
    var currentPath = normalizeNavPath(window.location.pathname);

    document.querySelectorAll("[data-nav-item]").forEach(function(item) {
        var paths = (item.getAttribute("data-active-paths") || "").split("|").filter(Boolean);
        var active = paths.some(function(path) {
            return navPathMatches(currentPath, path);
        });
        var link = item.querySelector(".navbar-link");
        if (!link) return;
        link.classList.toggle("nav-link-active", active);
        link.classList.toggle("active", active);
        if (active) {
            link.setAttribute("aria-current", "page");
        } else {
            link.removeAttribute("aria-current");
        }

        item.querySelectorAll<HTMLElement>(".dropdown-item[data-nav-active-paths]").forEach(function(child) {
            var childPaths = (child.getAttribute("data-nav-active-paths") || "").split("|").filter(Boolean);
            var childActive = childPaths.some(function(path) {
                return navPathMatches(currentPath, path);
            });
            child.classList.toggle("current-theme-btn", childActive);
            child.classList.toggle("dropdown-item-active", childActive);
            if (childActive) {
                child.setAttribute("aria-current", "page");
            } else {
                child.removeAttribute("aria-current");
            }
        });
    });

    document.querySelectorAll<HTMLElement>("[data-mobile-nav-item]").forEach(function(item) {
        var paths = (item.getAttribute("data-active-paths") || "").split("|").filter(Boolean);
        var active = paths.some(function(path) {
            return navPathMatches(currentPath, path);
        });
        if (item.classList.contains("mobile-link")) {
            item.classList.toggle("mobile-nav-active", active);
            if (active) {
                item.setAttribute("aria-current", "page");
            } else {
                item.removeAttribute("aria-current");
            }
        }
        if (item.classList.contains("mobile-nav-group")) {
            item.classList.toggle("mobile-nav-group-active", active);
            item.dataset.open = String(active);
            item.querySelector<HTMLButtonElement>(".mobile-group-title")?.setAttribute("aria-expanded", String(active));
            const panel = item.querySelector<HTMLElement>(".mobile-group-panel");
            panel?.toggleAttribute("inert", !active);
            if (active) panel?.removeAttribute("aria-hidden");
            else panel?.setAttribute("aria-hidden", "true");
        }
    });

    updateNavbarMenuSizing();
}

syncNavbarActiveState();
document.addEventListener("astro:page-load", syncNavbarActiveState);
document.addEventListener("swup:contentReplaced", syncNavbarActiveState);

const navbarForHover = document.getElementById("navbar");
const navLinksForHover = navbarForHover?.querySelector<HTMLElement>(".nav-links");
let compactNavbarExpandedUntil = 0;
let compactNavbarHoldTimer: number | undefined;
let compactNavbarPointerActive = false;
let compactNavbarMotionUntil = 0;
function setCompactNavbarSubmenu(navLinks: HTMLElement, item: HTMLElement | null) {
    const dropdown = item?.matches(".dropdown-container") && navLinks.contains(item)
        && item.querySelector(".dropdown-menu") ? item : null;
    const openDropdown = navLinks.querySelector<HTMLElement>(":scope > .dropdown-container.nav-submenu-open");
    if (openDropdown === dropdown) return;

    openDropdown?.classList.remove("nav-submenu-open");
    if (!dropdown) return;

    const delay = Math.max(0, compactNavbarMotionUntil - performance.now());
    navLinks.style.setProperty("--nav-submenu-reveal-delay", `${delay}ms`);
    dropdown.classList.add("nav-submenu-open");
}
function clearCompactNavbarHold() {
    if (compactNavbarHoldTimer !== undefined) {
        window.clearTimeout(compactNavbarHoldTimer);
        compactNavbarHoldTimer = undefined;
    }
}

function keepCompactNavbarExpanded(navbar: HTMLElement, revealSubmenu = false) {
    if (!navbar.classList.contains("scrolled")) return;

    compactNavbarExpandedUntil = performance.now() + 5000;
    setCompactNavbarExpanded(navbar, true, revealSubmenu || compactNavbarPointerActive);
    clearCompactNavbarHold();
    compactNavbarHoldTimer = window.setTimeout(function() {
        compactNavbarHoldTimer = undefined;
        const navLinks = navbar.querySelector<HTMLElement>(".nav-links");
        if (navLinks?.matches(":hover, :focus-within")) return;
        setCompactNavbarExpanded(navbar, false);
    }, 5000);
}

function collapseCompactNavbarWhenPointerLeaves(navbar: HTMLElement) {
    const navLinks = navbar.querySelector<HTMLElement>(".nav-links");
    if (!navbar.classList.contains("scrolled") || !navLinks?.classList.contains("is-hover-expanded")) return;
    if (navLinks.matches(":hover, :focus-within")) return;

    compactNavbarPointerActive = false;
    setCompactNavbarSubmenu(navLinks, null);
    navLinks.classList.add("is-scroll-revealed");
    navLinks.classList.remove("is-active-submenu-open");
    compactNavbarExpandedUntil = performance.now() + 5000;
    clearCompactNavbarHold();
    compactNavbarHoldTimer = window.setTimeout(function() {
        compactNavbarHoldTimer = undefined;
        if (!navLinks.matches(":hover, :focus-within")) {
            setCompactNavbarExpanded(navbar, false);
        }
    }, 5000);
}

if (navbarForHover && navLinksForHover) {
    navLinksForHover.addEventListener("pointerenter", function() {
        keepCompactNavbarExpanded(navbarForHover, false);
    });
    navLinksForHover.addEventListener("pointerleave", function() {
        setCompactNavbarSubmenu(navLinksForHover, null);
        collapseCompactNavbarWhenPointerLeaves(navbarForHover);
    });
    navLinksForHover.addEventListener("pointermove", function(event) {
        const target = event.target;
        if (!(target instanceof Element)) return;

        if (!compactNavbarPointerActive) {
            compactNavbarPointerActive = true;
            keepCompactNavbarExpanded(navbarForHover, true);
        }
        if (!navbarForHover.classList.contains("scrolled")) return;
        setCompactNavbarSubmenu(navLinksForHover, target.closest<HTMLElement>(".dropdown-container"));
    });
    navLinksForHover.addEventListener("focusin", function(event) {
        keepCompactNavbarExpanded(navbarForHover, true);
        const target = event.target;
        if (target instanceof Element) {
            setCompactNavbarSubmenu(navLinksForHover, target.closest<HTMLElement>(".dropdown-container"));
        }
    });
    navLinksForHover.addEventListener("focusout", function() {
        requestAnimationFrame(function() {
            if (!compactNavbarPointerActive) {
                const focused = document.activeElement;
                setCompactNavbarSubmenu(navLinksForHover, focused instanceof Element
                    ? focused.closest<HTMLElement>(".dropdown-container") : null);
            }
            collapseCompactNavbarWhenPointerLeaves(navbarForHover);
        });
    });
}

document.addEventListener("click", function(event) {
    var target = event.target;
    if (!(target instanceof Element)) return;
    var link = target.closest("a[href]");
    if (!link) return;
    var href = link.getAttribute("href") || "";
    if (!href || href.startsWith("#") || /^https?:\/\//.test(href)) return;
    window.setTimeout(syncNavbarActiveState, 80);
    window.setTimeout(syncNavbarActiveState, 240);
});
window.addEventListener("popstate", syncNavbarActiveState);
window.addEventListener("hashchange", syncNavbarActiveState);

let navbarMenuResizeFrame = 0;
window.addEventListener("resize", function() {
    if (navbarMenuResizeFrame) cancelAnimationFrame(navbarMenuResizeFrame);
    navbarMenuResizeFrame = requestAnimationFrame(function() {
        navbarMenuResizeFrame = 0;
        updateNavbarMenuSizing();
    });
}, { passive: true });

// 为semifull模式添加滚动检测逻辑
function initSemifullScrollDetection() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    const transparentMode = navbar.getAttribute('data-transparent-mode');
    const isStatic = document.documentElement.getAttribute('data-navbar-behavior') === 'static';
    if (transparentMode !== 'semifull' && !isStatic) return;

    cancelCompactNavbarModuleMotion();

    // 无论首页/非首页，semifull 都由滚动位置决定是否进入 scrolled 状态
    // 先移除之前的滚动监听器，避免重复绑定
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
        window.semifullScrollHandler = undefined;
    }

    clearCompactNavbarHold();
    const navLinks = navbar.querySelector<HTMLElement>(".nav-links");
    if (navLinks) setCompactNavbarSubmenu(navLinks, null);
    navLinks?.classList.remove("is-hover-expanded", "is-active-submenu-open", "is-scroll-revealed");
    navLinks?.style.removeProperty("--nav-submenu-reveal-delay");
    compactNavbarExpandedUntil = 0;
    compactNavbarPointerActive = false;
    compactNavbarMotionUntil = 0;

    // 顶部与滚动态共用相同定位，切换时只改变横向偏移和可见性。
    navbar.classList.remove('scrolled');
    if (isStatic) return;

    let ticking = false;
    let lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;

    function updateNavbarState() {
        if (document.documentElement.getAttribute('data-navbar-behavior') === 'static') {
            navbar!.classList.remove('scrolled');
            lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;
            ticking = false;
            return;
        }
        if (document.documentElement.classList.contains('is-page-transitioning')) {
            cancelCompactNavbarModuleMotion();
            navbar!.classList.remove('scrolled');
            const navLinks = navbar!.querySelector<HTMLElement>(".nav-links");
            if (navLinks) setCompactNavbarSubmenu(navLinks, null);
            navLinks?.classList.remove("is-hover-expanded", "is-active-submenu-open", "is-scroll-revealed");
            navLinks?.style.removeProperty("--nav-submenu-reveal-delay");
            clearCompactNavbarHold();
            compactNavbarExpandedUntil = 0;
            compactNavbarPointerActive = false;
            compactNavbarMotionUntil = 0;
            lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;
            ticking = false;
            return;
        }

        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const scrollDelta = scrollTop - lastScrollTop;
        const threshold = 50;
        const shouldCollapse = scrollTop > threshold;
        const isCollapsed = navbar!.classList.contains('scrolled');

        if (shouldCollapse !== isCollapsed) {
            if (!shouldCollapse && navLinks) prepareCompactNavbarReveal(navLinks);
            clearCompactNavbarHold();
            compactNavbarExpandedUntil = 0;
            compactNavbarPointerActive = false;
            compactNavbarMotionUntil = 0;
            if (navLinks) setCompactNavbarSubmenu(navLinks, null);
            const changeState = () => {
                navLinks?.classList.remove("is-hover-expanded", "is-active-submenu-open");
                navLinks?.classList.toggle("is-scroll-revealed", shouldCollapse);
                navLinks?.style.removeProperty("--nav-submenu-reveal-delay");
                navbar!.classList.toggle("scrolled", shouldCollapse);
            };
            if (navLinks) transitionCompactNavbarModules(navLinks, !shouldCollapse, changeState);
            else changeState();
        }

        if (navbar!.classList.contains("scrolled") && scrollDelta < -2) {
            keepCompactNavbarExpanded(navbar!, false);
        }
        lastScrollTop = scrollTop;

        ticking = false;
    }

    function requestTick() {
        if (!ticking) {
            requestAnimationFrame(updateNavbarState);
            ticking = true;
        }
    }

    // 移除之前的滚动事件监听器（如果存在）
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
    }

    // 保存新的事件处理器引用
    window.semifullScrollHandler = requestTick as unknown as (() => void);

    // 监听滚动事件
    window.addEventListener('scroll', requestTick, { passive: true });

    // 初始化状态
    updateNavbarState();
}

// 将函数暴露到全局对象，供页面切换时调用
window.initSemifullScrollDetection = initSemifullScrollDetection;
window.addEventListener('navbarBehaviorChange', initSemifullScrollDetection);

// 页面加载完成后初始化滚动检测
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSemifullScrollDetection);
} else {
    initSemifullScrollDetection();
}
</script>

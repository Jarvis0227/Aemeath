---
import { Icon } from "astro-icon/components";
import animalsImage from "@/assets/images/footer-animals.webp";
import { profileConfig, siteConfig } from "@/config";
import { url } from "@/utils/url-utils";

import "@/styles/footer.css";

const currentYear = new Date().getFullYear();
const startAt = new Date(`${siteConfig.siteStartDate}T00:00:00+08:00`);
const elapsedSeconds = Math.max(
	0,
	Math.floor((Date.now() - startAt.getTime()) / 1000),
);
const initialDays = Math.floor(elapsedSeconds / 86400);
const initialHours = Math.floor((elapsedSeconds % 86400) / 3600);
const initialMinutes = Math.floor((elapsedSeconds % 3600) / 60);
const initialSeconds = elapsedSeconds % 60;

const socials = [
	{
		name: "博客",
		icon: "material-symbols:home-outline",
		url: "/",
		external: false,
	},
	{
		name: "GitHub",
		icon: "simple-icons:github",
		url:
			profileConfig.links.find((item) => item.name === "GitHub")?.url ??
			"https://github.com/Jarvis0227",
		external: true,
	},
	{
		name: "Bilibili",
		icon: "fa7-brands:bilibili",
		url:
			profileConfig.links.find((item) => item.name === "Bilibili")?.url ??
			"https://space.bilibili.com/473321504",
		external: true,
	},
];

const techStack = [
	{ label: "Astro", tone: "violet", icon: "simple-icons:astro" },
	{ label: "Tailwind CSS", tone: "cyan", icon: "simple-icons:tailwindcss" },
	{
		label: "Waline",
		tone: "orange",
		icon: "material-symbols:forum-outline-rounded",
	},
	{ label: "QEdge", tone: "blue", icon: "material-symbols:cloud-outline" },
	{ label: "Umami", tone: "green", icon: "simple-icons:umami" },
];
---

<div class="site-footer-stage" data-pagefind-ignore="all">
	<section class="site-footer-kept-layers" aria-label="页脚装饰与技术栈">
		<div class="site-footer-animals" aria-label="一排可爱的动物装饰">
			<img src={animalsImage.src} alt="一排可爱的动物装饰" width="2170" height="305" loading="lazy" />
		</div>

		<div class="site-footer-stack" aria-label="本站使用的技术">
			{techStack.map((item) => (
				<span class={`site-footer-stack__badge site-footer-stack__badge--${item.tone}`}>
					<Icon name={item.icon} aria-hidden="true" />
					<span>{item.label}</span>
				</span>
			))}
			<span class="site-footer-stack__badge site-footer-stack__badge--quiet">© {currentYear} / BY-NC-SA</span>
		</div>

	</section>

	<footer id="site-footer" class="site-footer card-base transition" aria-label="网站页脚">

		<div class="site-footer__decor" aria-hidden="true">
			<svg class="site-footer__parcel" viewBox="0 0 190 150">
				<defs>
					<linearGradient id="site-footer-parcel-gradient" x1="0" y1="0" x2="1" y2="1">
						<stop offset="0" stop-color="var(--footer-parcel-start)"></stop>
						<stop offset="0.58" stop-color="var(--footer-parcel-middle)"></stop>
						<stop offset="1" stop-color="var(--footer-parcel-end)"></stop>
					</linearGradient>
				</defs>
				<g fill="none" stroke="url(#site-footer-parcel-gradient)" stroke-linecap="round" stroke-linejoin="round">
					<path d="m78 58 39-20 39 20-39 20-39-20Zm0 0v45l39 21 39-21V58m-39 20v46m-20-76 39 20" stroke-width="3"></path>
					<path d="M40 95c11 0 18 1 25 7m-8-15 9 15-16 5M164 40c-10-8-21-11-34-10m12-8-13 8 11 10" stroke-width="2.5"></path>
					<path d="M38 51h24M45 62h18" stroke-width="2" stroke-dasharray="5 7"></path>
				</g>
				<g fill="url(#site-footer-parcel-gradient)">
					<circle cx="39" cy="95" r="3"></circle>
					<circle cx="47" cy="40" r="2"></circle>
					<circle cx="171" cy="114" r="2.5"></circle>
				</g>
			</svg>
		</div>

		<div class="site-footer__content">
			<nav class="site-footer__nav" aria-label="页脚快捷导航">
				{socials.map((social) => (
					<a
						class="site-footer__nav-link"
						href={social.url}
						target={social.external ? "_blank" : undefined}
						rel={social.external ? "noreferrer" : undefined}
					>
						<Icon name={social.icon} aria-hidden="true" />
						<span>{social.name}</span>
					</a>
				))}
			</nav>

			<div class="site-footer__runtime" aria-label="网站运行时间">
				<div class="site-footer__clock" aria-hidden="true">
					<span class="site-footer__clock-orbit"></span>
					<svg viewBox="0 0 100 100">
						<circle cx="50" cy="50" r="39"></circle>
						<path d="M50 27v25l17 10"></path>
						<circle cx="50" cy="52" r="4.5"></circle>
					</svg>
				</div>
				<time data-runtime datetime={siteConfig.siteStartDate}>
					本站已运行 <strong>{initialDays}</strong> 天 <strong>{initialHours}</strong> 小时 <strong>{initialMinutes}</strong> 分 <strong>{initialSeconds}</strong> 秒
				</time>
				<span class="site-footer__runtime-sparkle" aria-hidden="true">✦</span>
			</div>

			<div class="site-footer__records" aria-label="网站备案信息">
				<a href="https://icp.gov.moe/?keyword=20260788" target="_blank" rel="noreferrer">
					<svg class="site-footer__shield" viewBox="0 0 36 40" aria-hidden="true">
						<path d="M18 1.5 33 7v12.1c0 9.4-6.3 15.8-15 19.4C9.3 34.9 3 28.5 3 19.1V7z"></path>
						<path class="site-footer__shield-mark" d="m10.2 19.7 5.1 5.1 10.8-12"></path>
					</svg>
					<span>萌ICP备20260788号</span>
				</a>
			</div>

			<div class="site-footer__traffic" aria-label="网站访问统计">
				<span class="site-footer__traffic-item">
					<span>今日访客：</span>
					<strong data-umami-stat="todayVisitors" aria-live="polite">加载中</strong>
				</span>
				<i aria-hidden="true">|</i>
				<span class="site-footer__traffic-item">
					<span>今日访问：</span>
					<strong data-umami-stat="todayPageviews" aria-live="polite">加载中</strong>
				</span>
				<i aria-hidden="true">|</i>
				<span class="site-footer__traffic-item">
					<span>本站访客：</span>
					<strong data-umami-stat="visitors" aria-live="polite">加载中</strong>
				</span>
				<i aria-hidden="true">|</i>
				<span class="site-footer__traffic-item">
					<span>本站访问：</span>
					<strong data-umami-stat="pageviews" aria-live="polite">加载中</strong>
				</span>
			</div>

			<div class="site-footer__divider" aria-hidden="true">
				<span></span>
				<i>✦</i>
				<span></span>
			</div>

			<div class="site-footer__meta">
				<span>© {currentYear} {profileConfig.name}. All Rights Reserved.</span>
				<span class="site-footer__meta-separator" aria-hidden="true"></span>
				<a href={url("rss.xml")}>
					<Icon name="material-symbols:rss-feed-rounded" aria-hidden="true" />
					<span>RSS</span>
				</a>
				<span class="site-footer__meta-separator" aria-hidden="true"></span>
				<a href={url("sitemap-index.xml")}>
					<svg viewBox="0 0 32 32" aria-hidden="true">
						<rect x="13" y="2.5" width="6" height="6" rx="1.5"></rect>
						<rect x="3" y="23.5" width="6" height="6" rx="1.5"></rect>
						<rect x="13" y="23.5" width="6" height="6" rx="1.5"></rect>
						<rect x="23" y="23.5" width="6" height="6" rx="1.5"></rect>
						<path d="M16 8.5v7M6 23.5v-5h20v5M16 15.5v8"></path>
					</svg>
					<span>Sitemap</span>
				</a>
			</div>

			<div class="site-footer__powered">
				<span>Powered by</span>
				<a href="https://astro.build" target="_blank" rel="noreferrer">Astro</a>
				<span>&amp;</span>
				<span class="site-footer__powered-name">Aemeath {siteConfig.themeVersion || "V1.1.1"}</span>
			</div>
		</div>
	</footer>
</div>

<script is:inline define:vars={{ startAt: startAt.getTime() }}>
	const renderFooterRuntime = () => {
		const runtime = document.querySelector("[data-runtime]");
		if (!runtime) return;

		const seconds = Math.max(0, Math.floor((Date.now() - startAt) / 1000));
		const days = Math.floor(seconds / 86400);
		const hours = Math.floor((seconds % 86400) / 3600);
		const minutes = Math.floor((seconds % 3600) / 60);
		const secs = seconds % 60;
		runtime.innerHTML = `本站已运行 <strong>${days}</strong> 天 <strong>${hours}</strong> 小时 <strong>${minutes}</strong> 分 <strong>${secs}</strong> 秒`;
	};

	if (window.__siteFooterRuntimeInterval) window.clearInterval(window.__siteFooterRuntimeInterval);
	renderFooterRuntime();
	window.__siteFooterRuntimeInterval = window.setInterval(renderFooterRuntime, 1000);
</script>

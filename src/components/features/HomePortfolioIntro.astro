---
// 首页入场动画：复用作品展示页现有的角色与上下快门背景。
// 组件固定在主布局中，以便通过 Swup 返回首页时也能重新播放。
import { homePortfolioIntroSettings } from "@/config/homePortfolioIntro";

interface Props {
	initialHome?: boolean;
}

const { initialHome = false } = Astro.props;
const defaultCharacter = homePortfolioIntroSettings.characters.find(
	(character) => character.id === homePortfolioIntroSettings.defaultCharacterId,
) ?? homePortfolioIntroSettings.characters[0];
const desktopBanners = homePortfolioIntroSettings.banners.desktop;
const mobileBanners = homePortfolioIntroSettings.banners.mobile;
const defaultTopBanner = desktopBanners.top.find(
	(banner) => banner.id === homePortfolioIntroSettings.defaultTopBannerId,
) ?? desktopBanners.top[0];
const defaultBottomBanner = desktopBanners.bottom.find(
	(banner) => banner.id === homePortfolioIntroSettings.defaultBottomBannerId,
) ?? desktopBanners.bottom[0];
const defaultMobileTopBanner = mobileBanners.top.find(
	(banner) => banner.id === homePortfolioIntroSettings.defaultMobileTopBannerId,
) ?? mobileBanners.top[0];
const defaultMobileBottomBanner = mobileBanners.bottom.find(
	(banner) => banner.id === homePortfolioIntroSettings.defaultMobileBottomBannerId,
) ?? mobileBanners.bottom[0];
const initialStyle = initialHome
	? "position: fixed; inset: 0; z-index: 49; background: #f8e4ad;"
	: undefined;
---

<section
	id="home-portfolio-intro"
	class:list={["home-portfolio-intro", initialHome && "home-portfolio-intro--boot"]}
	style={initialStyle}
	data-enabled-storage-key={homePortfolioIntroSettings.enabledStorageKey}
	data-character-storage-key={homePortfolioIntroSettings.characterStorageKey}
	data-top-banner-storage-key={homePortfolioIntroSettings.topBannerStorageKey}
	data-bottom-banner-storage-key={homePortfolioIntroSettings.bottomBannerStorageKey}
	data-default-character={homePortfolioIntroSettings.defaultCharacterId}
	data-default-top-banner={homePortfolioIntroSettings.defaultTopBannerId}
	data-default-bottom-banner={homePortfolioIntroSettings.defaultBottomBannerId}
	data-default-mobile-top-banner={homePortfolioIntroSettings.defaultMobileTopBannerId}
	data-default-mobile-bottom-banner={homePortfolioIntroSettings.defaultMobileBottomBannerId}
	data-character-options={JSON.stringify(homePortfolioIntroSettings.characters)}
	data-banner-options={JSON.stringify(homePortfolioIntroSettings.banners)}
	aria-hidden="true"
>
	<div class="home-portfolio-intro__backdrop"></div>
	<div class="home-portfolio-intro__scenes">
		<picture>
			<source media="(max-width: 779px)" srcset={defaultMobileTopBanner.src} />
			<img
				class="home-portfolio-intro__scene home-portfolio-intro__scene--top"
				src={defaultTopBanner.src}
				data-banner-id={defaultTopBanner.id}
				alt=""
				aria-hidden="true"
				decoding="async"
				fetchpriority="high"
			/>
		</picture>
		<picture>
			<source media="(max-width: 779px)" srcset={defaultMobileBottomBanner.src} />
			<img
				class="home-portfolio-intro__scene home-portfolio-intro__scene--bottom"
				src={defaultBottomBanner.src}
				data-banner-id={defaultBottomBanner.id}
				alt=""
				aria-hidden="true"
				decoding="async"
				fetchpriority="high"
			/>
		</picture>
	</div>
	<div class="home-portfolio-intro__band">
		<div class="home-portfolio-intro__title" aria-hidden="true">
			<span class="home-portfolio-intro__word home-portfolio-intro__word--left">鸣潮</span>
			<span class="home-portfolio-intro__word home-portfolio-intro__word--right">往复</span>
		</div>
	</div>
	<img
		class="home-portfolio-intro__character"
		src={defaultCharacter.src}
		data-character-id={defaultCharacter.id}
		alt=""
		aria-hidden="true"
		decoding="async"
		fetchpriority="high"
	/>
	<div class="home-portfolio-intro__vignette"></div>
</section>

<script is:inline data-swup-ignore-script>
	(() => {
		const introWindow = window;
		if (introWindow.__homePortfolioIntroBound) return;
		introWindow.__homePortfolioIntroBound = true;

		let wasHome = false;
		let finishTimer = 0;
		let activeTimer = 0;
		let playbackToken = 0;
		let navbarRevealAnimation = null;
		const introSessionKey = "rainzt.home-portfolio-intro-seen.v1";
		const intro = document.getElementById("home-portfolio-intro");
		const introEnabledStorageKey =
			intro?.getAttribute("data-enabled-storage-key") ||
			"rainzt.home-portfolio-intro-enabled.v1";
		const introCharacterStorageKey =
			intro?.getAttribute("data-character-storage-key") ||
			"rainzt.home-portfolio-intro-character.v1";
		const introTopBannerStorageKey =
			intro?.getAttribute("data-top-banner-storage-key") ||
			"rainzt.home-portfolio-intro-top-banner.v1";
		const introBottomBannerStorageKey =
			intro?.getAttribute("data-bottom-banner-storage-key") ||
			"rainzt.home-portfolio-intro-bottom-banner.v1";
		const defaultCharacterId =
			intro?.getAttribute("data-default-character") || "character-03";
		const defaultTopBannerId =
			intro?.getAttribute("data-default-top-banner") || "wuthering";
		const defaultBottomBannerId =
			intro?.getAttribute("data-default-bottom-banner") || "wuthering";
		const defaultMobileTopBannerId =
			intro?.getAttribute("data-default-mobile-top-banner") || "wuthering";
		const defaultMobileBottomBannerId =
			intro?.getAttribute("data-default-mobile-bottom-banner") || "wuthering";
		const characterOptions = (() => {
			try {
				return JSON.parse(intro?.getAttribute("data-character-options") || "[]");
			} catch {
				return [];
			}
		})();
		const bannerOptions = (() => {
			try {
				return JSON.parse(intro?.getAttribute("data-banner-options") || "{}") || {};
			} catch {
				return {};
			}
		})();

		const readLocalStorage = (key) => {
			try {
				return window.localStorage.getItem(key);
			} catch {
				return null;
			}
		};

		const isIntroEnabled = () => readLocalStorage(introEnabledStorageKey) !== "0";

		const getSelectedCharacter = () => {
			const selectedId = readLocalStorage(introCharacterStorageKey) || defaultCharacterId;
			return characterOptions.find((character) => character.id === selectedId)
				|| characterOptions.find((character) => character.id === defaultCharacterId)
				|| characterOptions[0];
		};

		const syncCharacter = (introElement) => {
			const character = getSelectedCharacter();
			const image = introElement?.querySelector(".home-portfolio-intro__character");
			if (!character || !(image instanceof HTMLImageElement)) return;
			if (image.getAttribute("src") !== character.src) image.setAttribute("src", character.src);
			image.setAttribute("data-character-id", character.id);
		};

		const getSelectedBanner = (position, storageKey, defaultId, mobileDefaultId) => {
			// 桌面和手机使用两套完全独立的资源。手机端只取 mobile 的默认项，
			// 不读取桌面端的 localStorage 选择，避免把宽幅横幅带到手机上。
			const isMobile = window.matchMedia?.("(max-width: 779px)").matches ?? false;
			const deviceOptions = bannerOptions?.[isMobile ? "mobile" : "desktop"];
			const options = Array.isArray(deviceOptions?.[position])
				? deviceOptions[position]
				: Array.isArray(bannerOptions?.[position])
					? bannerOptions[position]
					: [];
			const selectedDefaultId = isMobile ? mobileDefaultId : defaultId;
			const selectedId = isMobile
				? selectedDefaultId
				: (readLocalStorage(storageKey) || selectedDefaultId);
			return options.find((banner) => banner.id === selectedId)
				|| options.find((banner) => banner.id === selectedDefaultId)
				|| options[0];
		};

		const syncBanner = (introElement, position, storageKey, defaultId, mobileDefaultId) => {
			const banner = getSelectedBanner(position, storageKey, defaultId, mobileDefaultId);
			const image = introElement?.querySelector(`.home-portfolio-intro__scene--${position}`);
			if (!banner || !(image instanceof HTMLImageElement)) return;
			if (image.getAttribute("src") !== banner.src) image.setAttribute("src", banner.src);
			image.setAttribute("data-banner-id", banner.id);
		};

		const syncBanners = (introElement) => {
			syncBanner(
				introElement,
				"top",
				introTopBannerStorageKey,
				defaultTopBannerId,
				defaultMobileTopBannerId,
			);
			syncBanner(
				introElement,
				"bottom",
				introBottomBannerStorageKey,
				defaultBottomBannerId,
				defaultMobileBottomBannerId,
			);
		};

		const hasSeenIntro = () => {
			if (introWindow.__homePortfolioIntroSeen === true) return true;

			try {
				return window.sessionStorage.getItem(introSessionKey) === "1";
			} catch {
				return false;
			}
		};

		const markIntroSeen = () => {
			introWindow.__homePortfolioIntroSeen = true;
			try {
				window.sessionStorage.setItem(introSessionKey, "1");
			} catch {
				// If storage is unavailable, the in-memory flag still prevents a replay in this page session.
			}
		};

		const isHomePath = () => {
			const pathname = window.location.pathname.replace(/\/+$/, "") || "/";
			return pathname === "/";
		};

		const clearTimers = () => {
			if (activeTimer) window.clearTimeout(activeTimer);
			if (finishTimer) window.clearTimeout(finishTimer);
			activeTimer = 0;
			finishTimer = 0;
		};

		const cancelNavbarReveal = (navbar) => {
			if (navbarRevealAnimation) {
				const animation = navbarRevealAnimation;
				navbarRevealAnimation = null;
				animation.cancel();
			}
			navbar?.classList.remove("home-intro-navbar-revealing");
			navbar?.style.removeProperty("will-change");
		};

		const revealNavbar = (navbar) => {
			navbar.classList.add("home-intro-navbar-revealing");
			navbar.style.setProperty("will-change", "transform, opacity");

			// WAAPI gives this transition its own compositor timeline. It avoids the browser
			// collapsing the hidden and visible CSS states into one frame when the intro ends.
			const animation = navbar.animate(
				[
					{ opacity: 0, transform: "translate3d(0, -135%, 0)" },
					{ opacity: 0.76, transform: "translate3d(0, -23%, 0)", offset: 0.68 },
					{ opacity: 1, transform: "translate3d(0, 0, 0)" },
				],
				{
					duration: 1050,
					easing: "cubic-bezier(0.22, 1, 0.36, 1)",
					fill: "both",
				},
			);

			navbarRevealAnimation = animation;
			const cleanup = () => {
				if (navbarRevealAnimation !== animation) return;
				navbarRevealAnimation = null;
				navbar.classList.remove("home-intro-navbar-reset", "home-intro-navbar-revealing");
				navbar.style.removeProperty("will-change");
			};
			animation.onfinish = cleanup;
			animation.oncancel = cleanup;
		};

		const setDocumentLock = (locked) => {
			const navbar = document.getElementById("top-row");
			if (locked) {
				cancelNavbarReveal(navbar);
				navbar?.classList.remove("home-intro-navbar-reset");
				document.documentElement.classList.add("home-portfolio-intro-active");
				document.body.classList.add("home-portfolio-intro-active");
				return;
			}

			const wasLocked = document.documentElement.classList.contains("home-portfolio-intro-active");
			cancelNavbarReveal(navbar);
			navbar?.classList.add("home-intro-navbar-reset");
			document.documentElement.classList.remove("home-portfolio-intro-active");
			document.body.classList.remove("home-portfolio-intro-active");
			navbar?.classList.remove("home-intro-navbar-boot");
			if (!navbar) return;

			if (wasLocked) {
				revealNavbar(navbar);
				return;
			}

			void navbar.offsetWidth;
			window.requestAnimationFrame(() => navbar.classList.remove("home-intro-navbar-reset"));
		};

		const notifyIntroComplete = (intro) => {
			introWindow.dispatchEvent(
				new CustomEvent("home-portfolio-intro-complete", {
					detail: { intro },
				}),
			);
		};

		const waitForImage = (image) => {
			if (image.complete) {
				return typeof image.decode === "function"
					? image.decode().catch(() => undefined)
					: Promise.resolve();
			}

			return new Promise((resolve) => {
				const done = () => resolve();
				image.addEventListener("load", done, { once: true });
				image.addEventListener("error", done, { once: true });
			});
		};

		const waitForIntroAssets = (intro) => {
			const images = Array.from(intro.querySelectorAll("img"));
			const decoded = Promise.all(images.map(waitForImage));
			const fallback = new Promise((resolve) => window.setTimeout(resolve, 1800));
			return Promise.race([decoded, fallback]);
		};

		const resetIntro = (intro) => {
			playbackToken += 1;
			clearTimers();
			intro.classList.remove("home-portfolio-intro--boot", "is-preparing", "is-playing", "is-finishing");
			intro.classList.add("is-complete");
			intro.setAttribute("aria-hidden", "true");
			setDocumentLock(false);
		};

		const finishIntro = (intro, token) => {
			if (token !== playbackToken) return;
			intro.classList.add("is-finishing");
			finishTimer = window.setTimeout(() => {
				if (token !== playbackToken) return;
				intro.classList.remove("home-portfolio-intro--boot", "is-preparing", "is-playing", "is-finishing");
				intro.classList.add("is-complete");
				intro.setAttribute("aria-hidden", "true");
				setDocumentLock(false);
				notifyIntroComplete(intro);
			}, 1150);
		};

		const playIntro = async (intro, { force = false, markSeen = true } = {}) => {
			clearTimers();
			if (!isIntroEnabled() || (!force && hasSeenIntro())) {
				resetIntro(intro);
				notifyIntroComplete(intro);
				return;
			}

			// Count a normal visit as soon as playback starts, so returning from another page never replays it.
			// Settings previews intentionally leave the visit marker untouched.
			if (markSeen) markIntroSeen();
			const token = ++playbackToken;
			intro.setAttribute("aria-hidden", "false");
			intro.classList.remove("home-portfolio-intro--boot", "is-complete", "is-playing", "is-finishing");
			intro.classList.add("is-preparing");
			setDocumentLock(true);
			await waitForIntroAssets(intro);

			if (token !== playbackToken || !isHomePath()) return;
			intro.classList.remove("is-preparing");
			void intro.offsetWidth;
			window.requestAnimationFrame(() => {
				if (token === playbackToken) intro.classList.add("is-playing");
			});
			// The two strips and their words arrive together, settle for a beat,
			// then the full-screen lift takes the whole composition away.
			activeTimer = window.setTimeout(() => finishIntro(intro, token), 4275);
		};

		const previewIntro = (intro) => {
			if (!isIntroEnabled() || !isHomePath()) return;
			wasHome = true;
			resetIntro(intro);
			void playIntro(intro, { force: true, markSeen: false });
		};

		const syncIntro = () => {
			const intro = document.getElementById("home-portfolio-intro");
			if (!intro) return;
			syncCharacter(intro);
			syncBanners(intro);

			const onHome = isHomePath();
			if (!isIntroEnabled()) {
				resetIntro(intro);
				notifyIntroComplete(intro);
				wasHome = onHome;
				return;
			}
			if (onHome && !wasHome) {
				if (hasSeenIntro()) {
					resetIntro(intro);
					notifyIntroComplete(intro);
				} else {
					playIntro(intro);
				}
			} else if (!onHome && wasHome) {
				resetIntro(intro);
			}
			wasHome = onHome;
		};

		const scheduleSync = () => window.requestAnimationFrame(syncIntro);
		window.addEventListener("resize", scheduleSync, { passive: true });

		document.addEventListener("astro:page-load", scheduleSync);
		document.addEventListener("swup:contentReplaced", scheduleSync);
		document.addEventListener("swup:content:replace", scheduleSync);
		document.addEventListener("swup:page:view", scheduleSync);
		window.addEventListener("pageshow", scheduleSync);
		window.addEventListener("home-portfolio-intro-settings-change", (event) => {
			const intro = document.getElementById("home-portfolio-intro");
			if (!intro) return;
			syncCharacter(intro);
			syncBanners(intro);
			const detail = event instanceof CustomEvent ? event.detail : undefined;
			if (!isIntroEnabled()) {
				resetIntro(intro);
				notifyIntroComplete(intro);
				return;
			}
			if (detail?.preview && isHomePath()) {
				previewIntro(intro);
				return;
			}
			if (detail?.enabled === true && isHomePath()) {
				try {
					window.sessionStorage.removeItem(introSessionKey);
				} catch {
					// Storage can be unavailable in a privacy-restricted browser session.
				}
				introWindow.__homePortfolioIntroSeen = false;
				wasHome = false;
				syncIntro();
			}
		});

		const bindSwupHooks = () => {
			if (!window.swup?.hooks) return;
			window.swup.hooks.on("content:replace", scheduleSync);
			window.swup.hooks.on("page:view", scheduleSync);
		};

		bindSwupHooks();
		window.setTimeout(bindSwupHooks, 500);
		scheduleSync();
	})();
</script>

<style is:global>
	.home-portfolio-intro {
		/* Match the compact framing in the reference: two equal scenes, with slim blue-white breathing room. */
		--intro-band-height: clamp(2.75rem, 5.2vh, 3.7rem);
		--intro-edge-gap: clamp(1.25rem, 3.5vh, 2.4rem);
		/* Soft cream-yellow: bright enough to keep the illustrations and typography readable. */
		--intro-surface: #fffdf7;
		--intro-surface-deep: #fff4d5;
		--intro-surface-ink: #f8e4ad;
		--intro-strip-delay: 1.35s;
		--intro-strip-duration: 2.7s;
		position: fixed;
		z-index: 49;
		inset: 0;
		overflow: hidden;
		isolation: isolate;
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
		background: var(--intro-surface-ink);
		clip-path: inset(0 0 0 0);
		contain: layout paint style;
		transform: translate3d(0, 0, 0);
		will-change: transform;
		transition:
			opacity 0.14s ease-out,
			visibility 0s linear 0.14s;
	}

	.home-portfolio-intro.is-playing {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
		transition-delay: 0s;
	}

	.home-portfolio-intro.is-preparing {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
		transition: none;
	}

	.home-portfolio-intro--boot {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
		transition: none;
	}

	.home-portfolio-intro.is-finishing {
		opacity: 1;
		visibility: visible;
		pointer-events: none;
		animation: home-portfolio-intro-lift 1.1s cubic-bezier(0.7, 0, 0.17, 1) both;
		transition: none;
	}

	.home-portfolio-intro.is-complete {
		visibility: hidden !important;
		opacity: 0 !important;
		pointer-events: none !important;
		transform: translate3d(0, 0, 0) !important;
		transition: none !important;
	}

	.home-portfolio-intro__backdrop,
	.home-portfolio-intro__scenes,
	.home-portfolio-intro__band,
	.home-portfolio-intro__vignette {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.home-portfolio-intro__backdrop {
		z-index: 0;
		background:
			radial-gradient(circle at 50% 49%, rgb(255 205 101 / 0.3), transparent 33%),
			linear-gradient(145deg, var(--intro-surface), var(--intro-surface-deep) 60%, var(--intro-surface-ink));
	}

	.home-portfolio-intro__scenes {
		z-index: 1;
	}

	.home-portfolio-intro__scene {
		position: absolute;
		display: block;
		width: 100%;
		max-width: none;
		object-fit: cover;
		will-change: transform;
	}

	.home-portfolio-intro__scene--top {
		top: var(--intro-edge-gap);
		height: calc(50% - var(--intro-edge-gap) - (var(--intro-band-height) / 2));
		object-position: center 43%;
		transform: translate3d(-112%, 0, 0) scale(1.07);
	}

	.home-portfolio-intro__scene--bottom {
		bottom: var(--intro-edge-gap);
		height: calc(50% - var(--intro-edge-gap) - (var(--intro-band-height) / 2));
		object-position: center 52%;
		transform: translate3d(112%, 0, 0) scale(1.07);
	}

	.home-portfolio-intro__band {
		z-index: 4;
		top: 50%;
		bottom: auto;
		height: var(--intro-band-height);
		/* This is only a positioning layer for the two words, not a visible banner. */
		background: transparent;
		border: 0;
		box-shadow: none;
		transform: translateY(-50%);
		opacity: 1;
	}

	.home-portfolio-intro__title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 100%;
		padding: 0 clamp(1.5rem, 6vw, 5.5rem);
		white-space: nowrap;
	}

	.home-portfolio-intro__word {
		display: inline-block;
		color: #fff;
		font-family: "ZCOOL KuaiLe", "Noto Sans SC", "Microsoft YaHei", sans-serif;
		font-size: clamp(4rem, 13vw, 11.5rem);
		font-weight: 900;
		line-height: 0.82;
		letter-spacing: 0.045em;
		text-shadow:
			0.055em 0.055em 0 #15131a,
			-0.055em 0.055em 0 #15131a,
			0.055em -0.055em 0 #15131a,
			-0.055em -0.055em 0 #15131a,
			0 0.08em 0.18em rgba(0, 0, 0, 0.68);
		will-change: transform, opacity;
		opacity: 0;
	}

	.home-portfolio-intro__word--left {
		transform: translate3d(-24vw, 0, 0) rotate(-2deg);
	}

	.home-portfolio-intro__word--right {
		transform: translate3d(24vw, 0, 0) rotate(2deg);
	}

	.home-portfolio-intro__character {
		position: absolute;
		z-index: 5;
		bottom: 0;
		left: 49%;
		display: block;
		width: auto;
		max-width: min(88vw, 48rem);
		height: min(100svh, 64rem);
		object-fit: contain;
		object-position: center bottom;
		opacity: 0;
		transform: translate3d(-50%, 14%, 0) scale(0.88);
		will-change: transform, opacity;
		pointer-events: none;
	}

	.home-portfolio-intro__vignette {
		z-index: 7;
		background: transparent;
		opacity: 0;
	}

	.home-portfolio-intro.is-playing .home-portfolio-intro__scene--top {
		animation: home-portfolio-intro-scene-top var(--intro-strip-duration) var(--intro-strip-delay) cubic-bezier(0.16, 0.82, 0.22, 1) both;
	}

	.home-portfolio-intro.is-playing .home-portfolio-intro__scene--bottom {
		animation: home-portfolio-intro-scene-bottom var(--intro-strip-duration) var(--intro-strip-delay) cubic-bezier(0.16, 0.82, 0.22, 1) both;
	}

	.home-portfolio-intro.is-playing .home-portfolio-intro__character {
		animation: home-portfolio-intro-character 2s cubic-bezier(0.18, 0.76, 0.2, 1) both;
	}

	.home-portfolio-intro.is-playing .home-portfolio-intro__word--left {

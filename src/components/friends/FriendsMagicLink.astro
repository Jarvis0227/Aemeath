---
import { Icon } from "astro-icon/components";
---

<a
	href="/links/"
	data-no-swup
	class="friends-magic-button"
	aria-label="打开神奇按钮：进入友链漫游舱"
>
	<span class="friends-magic-button-icon" aria-hidden="true">
		<Icon is:inline name="material-symbols:flare-rounded" class="text-[1.25rem]" />
	</span>
	<span class="friends-magic-button-copy">
		<span class="friends-magic-button-title">神奇按钮</span>
		<span class="friends-magic-button-note">（我知道你不会点的）</span>
	</span>
	<span class="friends-magic-button-arrow" aria-hidden="true">
		<Icon is:inline name="material-symbols:arrow-forward-rounded" />
	</span>
</a>
